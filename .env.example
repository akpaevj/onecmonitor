# Скопируйте в .env (docker compose подхватывает его автоматически) или задавайте инлайн:
#   IMAGE_REGISTRY=registry.example.com/myuser/ docker compose build

# Префикс реестра для образов server/web из docker-compose.yml, со слэшем на конце.
# Пусто (по умолчанию) - образы называются просто oneswiss-server:latest/oneswiss-web:latest,
# без адреса реестра (годится для локального запуска, но не для `docker compose push`).
IMAGE_REGISTRY=

# Тег образов. По умолчанию latest.
IMAGE_TAG=

# Адрес бэкенда, по которому он реально доступен из БРАУЗЕРА пользователя (не из Docker-сети).
# Браузер обращается к бэкенду напрямую, минуя прокси Next.js - нужно для загрузки больших файлов
# (см. пояснение в docker-compose.yml). По умолчанию http://localhost:7002 - для реального
# развёртывания смените на публичный домен/IP сервера, включая схему (http/https) и порт.
# Читается контейнером web при каждом старте (docker-entrypoint.sh) - пересборка образа не
# требуется, достаточно поменять переменную и перезапустить контейнер (`docker compose up -d`).
PUBLIC_BACKEND_URL=http://localhost:7002

@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@model List<Cluster>

@{
    ViewData["Title"] = "Кластеры";
}

<h2 class="mb-3">Кластеры</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="UpdateClusters" role="button">Обновить</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th class="col">Имя</th>
            <th class="col">Хост</th>
            <th class="col">Порт</th>
            <th class="col">Агент</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Host</td>
                <td>@item.Port</td>
                <td>@item.Agent.InstanceName</td>
                <td class="text-center">
                    <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Name')">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "Clusters",
    Action = "Delete"
})
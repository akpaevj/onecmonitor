@model OnecMonitor.Server.ViewModels.MaintenanceTasks.MaintenanceTaskLogViewModel

@{
    ViewData["Title"] = "Лог задачи обслуживания";
}

<div class="row h-100">
    <div class="col-3 h-100">
        <div class="card h-100">
            <div class="card-header">Информационные базы</div>
            <div class="card-body">
                <ul class="nav nav-pills flex-column align-items-center" id="infoBasesTab" role="tablist">
                    @foreach (var item in Model.InfoBases)
                    {
                        var id = item.Id.ToString().Replace("-", "");
                        <li class="nav-item w-100 row row-cols-auto g-3 align-items-center" role="presentation">
                            <div class="hstack gap-2 p-0 w-100">
                                <button class="nav-link w-100" id="@id" data-infobase-id="@item.Id" data-bs-toggle="tab" data-bs-target="#tab_@id" type="button" role="tab" aria-controls="tab_@id" aria-selected="false">
                                    @item.InfoBaseName
                                </button>
                                <i class="fs-5 bi-three-dots-vertical text-danger" data-infobase-id="@item.Id"></i>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-9 h-100">
        <div class="card h-100">
            <div class="card-header">Журнал</div>
            <div class="card-body">
                <div class="tab-content" id="myTabContent">
                    @foreach (var item in Model.InfoBases)
                    {
                        var id = item.Id.ToString().Replace("-", "");
                        <div class="tab-pane fade" id="tab_@id" data-infobase-id="@item.Id" role="tabpanel" aria-labelledby="@id" tabindex="0">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                    <tr>
                                        <th class="col">Время</th>
                                        <th class="col">Ошибка</th>
                                        <th class="col">Сообщение</th>
                                    </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        OM.initLog('@Model.TaskId');
    </script>
}

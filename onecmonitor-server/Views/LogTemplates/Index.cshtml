@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@model OnecMonitor.Server.ViewModels.LogTemplates.Index.LogTemplatesIndexViewModel

@{
    ViewData["Title"] = "Шаблоны сбора тех. журнала";
}

<h2 class="mb-3">Шаблоны сбора тех. журнала</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-controller="LogTemplates" asp-action="Edit" role="button">Добавить</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>Имя</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td class="text-center">
                    <a class="btn btn-outline-warning btn-sm" asp-controller="LogTemplates" asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                    <a class="btn btn-outline-info btn-sm" asp-controller="LogTemplates" asp-action="Edit" asp-route-id="@item.Id" asp-route-copy="true">Копировать</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Name')">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "LogTemplates",
    Action = "Delete"
})
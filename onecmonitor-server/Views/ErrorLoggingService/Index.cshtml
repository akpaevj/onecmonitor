@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@model OnecMonitor.Server.ViewModels.ErrorLoggingService.Index.ErrorLoggingServiceIndexViewModel

@{
    ViewData["Title"] = "Журнал сервиса регистрации ошибок";
}

<h2 class="mb-3">Журнал сервиса регистрации ошибок</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>Дата</th>
            <th>Конфигурация</th>
            <th>Платформа</th>
            <th>Пользователь</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Date</td>
                <td>@($"{item.Configuration} ({item.ConfigurationVersion})")</td>
                <td>@item.PlatformVersion</td>
                <td>@item.UserName</td>
                <td class="text-center">
                    <a class="btn btn-outline-warning btn-sm" asp-action="Details" asp-route-id="@item.Id">Детали</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', 'отчет об ошибке')">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "ErrorLoggingService",
    Action = "Delete"
})
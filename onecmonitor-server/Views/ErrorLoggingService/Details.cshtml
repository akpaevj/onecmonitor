@using System.Text
@model OnecMonitor.Server.ViewModels.ErrorLoggingService.ErrorReportViewModel

@{
    ViewData["Title"] = "Отчет об ошибке";
}

<h2 class="mb-3">Отчет об ошибке</h2>

<div class="mb-3">
    <button class="btn btn-secondary" onclick="history.back()" type="button">Назад</button>
</div>

<div class="row">

    <div class="col">
        <div class="card mb-3">
            <div class="card-header bg-primary">Клиент</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody class="align-middle">
                    <tr>
                        <td>Приложение</td>
                        <td>@Model.Report.ClientInfo.AppName</td>
                    </tr>
                    <tr>
                        <td>Версия</td>
                        <td>@Model.Report.ClientInfo.AppVersion</td>
                    </tr>
                    <tr>
                        <td>ОС</td>
                        <td>@Model.Report.ClientInfo.SystemInfo.OsVersion</td>
                    </tr>
                    <tr>
                        <td>Память (свободная/всего)</td>
                        <td>@Model.Report.ClientInfo.SystemInfo.FreeRam / @Model.Report.ClientInfo.SystemInfo.FullRam</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header bg-secondary">Конфигурация</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody class="align-middle">
                    <tr>
                        <td>Имя</td>
                        <td>@Model.Report.ConfigInfo.Name</td>
                    </tr>
                    <tr>
                        <td>Версия</td>
                        <td>@Model.Report.ConfigInfo.Version</td>
                    </tr>
                    <tr>
                        <td>Режим совместимости</td>
                        <td>@Model.Report.ConfigInfo.CompatibilityMode</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header text-dark bg-warning">Сеанс</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody class="align-middle">
                    <tr>
                        <td>Имя пользователя</td>
                        <td>@Model.Report.SessionInfo.UserName</td>
                    </tr>
                    <tr>
                        <td>Разделители</td>
                        <td>@Model.Report.SessionInfo.DataSeparation</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Report.AdditionalInfo))
        {
            <div class="card">
                <div class="card-header text-dark bg-info">Дополнительная информация</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <span>@Model.Report.AdditionalInfo</span>
                    </table>
                </div>
            </div>
        }
    </div>
    
    <div class="col">
        <div class="card mb-3">
            <div class="card-header bg-danger">Ошибка</div>
            <div class="card-body">
                @{
                    var error = Model.Report.ErrorInfo.ApplicationErrorInfo.Errors[0];

                    <div class="mb-2">
                        <span>@error.Text</span>
                    </div>

                    <div class="mb-2">
                        @foreach (var category in error.Categories)
                        {
                            <span class="badge rounded-pill bg-danger">@category</span>
                        }
                    </div>

                    var stackBuilder = new StringBuilder();
                    var prefix = "";

                    foreach (var item in Model.Report.ErrorInfo.ApplicationErrorInfo.Stack)
                    {
                        stackBuilder.AppendLine($"{prefix}{item.Module} : {item.Line} : {item.Code.Trim()}");
                        prefix += "\t";
                    }

                    <pre><code>@stackBuilder.ToString()</code></pre>
                }
            </div>
        </div>
        @if (Model.Screenshot is not null)
        {
            <div class="card mb-3">
                <div class="card-header bg-success">Скриншот</div>
                <div class="card-body">
                    <img class="img-fluid" src="@Model.Screenshot" alt="Скриншот экрана пользователя"/>
                </div>
            </div>
        }
    </div>

</div>

@section Scripts
{
    <script type="text/javascript">
        const img = document.querySelector('img');
        img.style.cursor = "zoom-in";

        img.onclick = async function() {
            if (document.fullscreenElement === img) {
                img.style.cursor = "zoom-in";
                await document.exitFullscreen()
            } else {
                img.style.cursor = "zoom-out";
                await img.requestFullscreen();
            }
        };
    </script>
}

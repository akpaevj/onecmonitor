@model OnecMonitor.Server.ViewModels.ErrorLoggingService.ErrorLoggingServiceSettingsViewModel

@{
    ViewData["Title"] = "Настройки сервиса регистрации ошибок";
}

<h2 class="mb-3">Настройки сервиса регистрации ошибок</h2>

<form method="post" asp-action="SaveSettings" style="height: 100%">
    <div class="mb-3">
        <button class="btn btn-primary" type="submit">Сохранить</button>
    </div>

    <input type="text" hidden class="form-control" asp-for="Id" value="@Model.Id">

    <div class="mb-3">
        <label class="form-check-label" asp-for="Enabled">Включен</label>
        <input class="form-check-input" type="checkbox" asp-for="Enabled" checked="@Model.Enabled">
        <span asp-validation-for="Enabled" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="ReportsTtl">Удалять ошибки старше (в днях)</label>
        <input type="number" class="form-control" asp-for="ReportsTtl" value="@Model.ReportsTtl">
        <span asp-validation-for="ReportsTtl" class="text-danger"></span>
    </div>

</form>
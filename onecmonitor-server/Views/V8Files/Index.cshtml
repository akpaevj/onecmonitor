@using OnecMonitor.Server.ViewModels
@model OnecMonitor.Server.ViewModels.V8Files.V8FilesIndexViewModel

@{
    ViewData["Title"] = "Конфигурации и обработки";
}

<h2 class="mb-3">Конфигурации и обработки</h2>

<div class="mb-3 hstack gap-2">
    <a class="btn btn-primary me-auto" asp-action="Edit" role="button">Добавить</a>
    <div class="form-check align-self-center">
        <input type="checkbox" class="form-check-input" checked="@Model.ShowArchived" id="showArchived">
        <label class="form-check-label" for="showArchived">
            Показывать архив
        </label>
    </div>
</div>

@foreach (var group in Model.Items.GroupBy(c => $"{c.Name} ({c.GetPostfix()})"))
{
    <div class="mb-3">
        <div class="card">
            <h6 class="card-header">@group.Key</h6>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table m-0 table-sm table-striped table-bordered">
                        <thead>
                        <tr>
                            <th>Версия</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var file in group.ToList().OrderByDescending(c => c.Version))
                        {
                            <tr>
                                <td>@file.Version</td>
                                <td class="text-center">
                                    @if(!file.IsArchived)
                                    {
                                        <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@file.Id">Изменить</a>
                                    }
                                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@file.Id', '@file.Name')">Удалить</a>
                                    @if(!file.IsArchived)
                                    {
                                        <a class="btn btn-outline-secondary btn-sm" asp-action="Archive" asp-route-id="@file.Id">В архив</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "V8Files",
    Action = "Delete"
})

@section Scripts
{
    <script type="text/javascript">
        OM.initShowArchived();
    </script>
}

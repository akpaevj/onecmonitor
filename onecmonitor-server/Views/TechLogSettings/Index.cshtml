@model OnecMonitor.Server.ViewModels.TechLogSettings.TechLogSettingsEditViewModel

@{
    ViewData["Title"] = "Настройки экспорта технологического журнала";
}

<h2 class="mb-3">Настройки экспорта технологического журнала</h2>

<form method="post" asp-action="Save" style="height: 100%">
    <div class="mb-3">
        <button class="btn btn-primary" type="submit">Сохранить</button>
    </div>

    <input type="text" hidden class="form-control" asp-for="Id" value="@Model.Id">

    <div class="mb-3">
        <label class="form-check-label" asp-for="Enabled">Включен</label>
        <input class="form-check-input" type="checkbox" asp-for="Enabled" checked="@Model.Enabled">
    </div>

    <h4 class="mb-3">ClickHouse</h4>

    <div class="mb-3">
        <label class="form-label" asp-for="ClickHouseHost">Хост</label>
        <input type="text" class="form-control" asp-for="ClickHouseHost" value="@Model.ClickHouseHost">
        <span asp-validation-for="ClickHouseHost" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="ClickHousePort">Порт</label>
        <input type="number" class="form-control" asp-for="ClickHousePort" value="@Model.ClickHousePort">
        <span asp-validation-for="ClickHousePort" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="ClickHouseUser">Пользователь</label>
        <input type="text" class="form-control" asp-for="ClickHouseUser" value="@Model.ClickHouseUser">
        <span asp-validation-for="ClickHouseUser" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="ClickHousePassword">Пароль</label>
        <input type="password" class="form-control" asp-for="ClickHousePassword" value="@Model.ClickHousePassword">
        <span asp-validation-for="ClickHousePassword" class="text-danger"></span>
    </div>

</form>
@model OnecMonitor.Server.ViewModels.TechLogSettings.TechLogSettingsEditViewModel

@{
    ViewData["Title"] = "Настройки экспорта технологического журнала";
}

<h2 class="mb-3">Настройки экспорта технологического журнала</h2>

<form method="post" asp-action="Save" style="height: 100%">
    <div class="mb-3">
        <button class="btn btn-primary" type="submit">Сохранить</button>
    </div>

    <input type="text" hidden class="form-control" asp-for="Id" value="@Model.Id">

    <div class="mb-3">
        <label class="form-check-label" asp-for="Enabled">Включен</label>
        <input class="form-check-input" type="checkbox" asp-for="Enabled" checked="@Model.Enabled">
        <span asp-validation-for="Enabled" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DbmsId">СУБД</label>
        <select asp-for="DbmsId" class="form-control" asp-items="Model.AvailableDbms"></select>
        <span asp-validation-for="DbmsId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DatabaseName">Имя базы данных</label>
        <input type="text" class="form-control" asp-for="DatabaseName" value="@Model.DatabaseName">
        <span asp-validation-for="DatabaseName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Table">Имя таблицы хранения</label>
        <input type="text" class="form-control" asp-for="Table" value="@Model.Table">
        <span asp-validation-for="Table" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="CredentialsId">Учетные данные</label>
        <select asp-for="CredentialsId" class="form-control" asp-items="Model.AvailableCredentials"></select>
        <span asp-validation-for="CredentialsId" class="text-danger"></span>
    </div>

</form>
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.Controllers;
@using OnecMonitor.Server.ViewModels.TechLogSeances;
@using OnecMonitor.Server.Models;
@using OnecMonitor.Server.ViewModels

@model TechLogSeancesIndexViewModel

@{
    ViewData["Title"] = "Tech log seances";
}

<h1 class="mb-3">Tech log seances</h1>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Edit" role="button">Add</a>
</div>

<form method="get">
    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Description</th>
                    <th>Mode</th>
                    <th>StartTime</th>
                    <th>Duration</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Seances)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td>@item.StartMode</td>
                        @if (item.StartMode == TechLogSeanceStartMode.Monitor)
                        {
                            <td colspan="2"/>
                        }
                        else
                        {
                            <td>@item.StartDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.Duration</td>
                        }
                        <td class="text-center">
                            <a class="btn btn-outline-info btn-sm" asp-action="TechLog" asp-route-id="@item.Id">Log</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Description')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav om-current-page="@Model.CurrentPage" class="align-self-center" om-pages-count="@Model.PagesCount"></nav>

</form>


@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "TechLogSeances",
    Action = "Delete"
})
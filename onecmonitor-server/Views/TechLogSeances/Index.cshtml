@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.Controllers;
@using OnecMonitor.Server.ViewModels.TechLogSeances;
@using OnecMonitor.Server.Models;
@using OnecMonitor.Server.ViewModels

@model TechLogSeancesIndexViewModel

@{
    ViewData["Title"] = "Сеансы сбора тех. журнала";
}

<h2 class="mb-3">Сеансы сбора тех. журнала</h2>

@if (Model.Enabled)
{
    <div class="mb-3">
        <a class="btn btn-primary" asp-action="Edit" role="button">Добавить</a>
    </div>
}

<form method="get">
    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Описание</th>
                    <th>Режим</th>
                    <th>Начало</th>
                    <th>Длительность</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Seances)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td>@item.StartMode</td>
                        @if (item.StartMode == TechLogSeanceStartMode.Monitor)
                        {
                            <td colspan="2"/>
                        }
                        else
                        {
                            <td>@item.StartDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.Duration</td>
                        }
                        <td class="text-center">
                            <a class="btn btn-outline-info btn-sm" asp-action="TechLog" asp-route-id="@item.Id">Лог</a>
                            @if (Model.Enabled)
                            {
                                <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                            }
                            <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Description')">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav om-current-page="@Model.CurrentPage" class="align-self-center" om-pages-count="@Model.PagesCount"></nav>

</form>


@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "TechLogSeances",
    Action = "Delete"
})
@model OnecMonitor.Server.ViewModels.TechLogSeances.TechLogViewModel

@{
    ViewData["Title"] = "Записи сеанса сбора тех. журнала";
}

<h5>@Model.Description</h5>

<div class="input-group mb-3">
    <input id="filter" class="form-control" asp-for="Filter" type="text" placeholder="WHERE clause" list="filtersList" aria-describedby="searchBtn">
    <input class="btn btn-primary" type="submit" id="searchBtn" value="Search" />
</div>

<nav om-current-page="@Model.CurrentPage" om-pages-count="@Model.PagesCount" om-filter="@Model.Filter"></nav>

<div class="accordion mb-3">
    @foreach (var item in Model.TjEvents)
    {
        var detailsId = $"eventDetails-{item.TjEvent.Id}";
        
        <div class="accordion-item">
            <div class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@detailsId" aria-expanded="false" aria-controls="@detailsId">
                    <div class="col">@item.TjEvent.DateTime.ToString("yyyy-MM-dd HH:mm:ss.ffffff")</div>
                    <div class="col">@item.TjEvent.Duration</div>
                    <div class="col">@item.TjEvent.EventName</div>
                    <div class="col">@item.TjEvent.Level</div>
                </button>
            </div>
            <div id="@detailsId" class="collapse accordion-collapse" data-bs-parent=".accordion">
                <div class="accordion-body">
                    <table class="table mb-0 @item.AdditionalCss">
                        <thead>
                        <tr>
                            <th>Свойство</th>
                            <th>Значение</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var property in item.TjEvent.Properties)
                        {
                            <tr>
                                <td style="word-break: break-all">@property.Key</td>
                                <td style="word-break: break-all">@property.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<nav om-current-page="@Model.CurrentPage" om-pages-count="@Model.PagesCount" om-filter="@Model.Filter"></nav>

@section Scripts
{
    <script type="text/javascript">
        const filterInput = document.getElementById('filter');
        
        document.getElementById('searchBtn').addEventListener('click', () => {
            OM.applyTechLogFilter(filterInput.value);
        });
    
    </script>
}


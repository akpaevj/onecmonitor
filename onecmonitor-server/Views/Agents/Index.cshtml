@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@using OnecMonitor.Server.ViewModels.Agents;
@model AgentsIndexViewModel

@{
    ViewData["Title"] = "Agents";
}

<h2 class="mb-3">Agents</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th class="col-4">Id</th>
            <th class="col">Instance name</th>
            <th class="col">Connected</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Agents)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.InstanceName</td>
                <td class="text-center" style="vertical-align: middle">
                    <i class="bi bi-brightness-alt-high-fill @(item.IsConnected ? "text-success" : "text-danger")"></i>
                </td>
                <td class="text-center">
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.InstanceName')">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "Agents",
    Action = "Delete"
})
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@using OnecMonitor.Server.ViewModels.Agents;
@model List<AgentsListItemViewModel>

@{
    ViewData["Title"] = "Агенты монитора";
}

<h2 class="mb-3">Агенты монитора</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th class="col-4">@Html.DisplayNameFor(c => c[0].Id)</th>
            <th class="col">@Html.DisplayNameFor(c => c[0].InstanceName)</th>
            <th class="col">@Html.DisplayNameFor(c => c[0].IsConnected)</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.InstanceName</td>
                <td class="text-center" style="vertical-align: middle">
                    <i class="bi bi-brightness-alt-high-fill @(item.IsConnected ? "text-success" : "text-danger")"></i>
                </td>
                <td class="text-center">
                    <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.InstanceName')">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "Agents",
    Action = "Delete"
})
@using OnecMonitor.Server.ViewModels
@model List<OnecMonitor.Server.ViewModels.Agents.AgentDetailsViewModel>

@{
    ViewData["Title"] = "Агенты монитора";
}

<div class="row h-100">
    <div class="col-3 h-100">
        <div id="agents" class="card h-100">
            <div class="card-header">Агенты монитора</div>
            <div class="card-body">
                <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    @foreach (var item in Model)
                    {
                        <div class="hstack gap-2 p-0 w-100">
                            <button class="nav-link w-100" id="v-pills-@item.Id-tab" data-bs-toggle="pill" data-bs-target="#pane-@item.Id" type="button" role="tab" aria-controls="pane-@item.Id" aria-selected="false">
                                @item.InstanceName
                            </button>
                            <i class="fs-5 bi-three-dots-vertical @(item.IsConnected ? "text-success" : "text-danger")"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col h-100">
        <div class="card h-100">
            <div class="card-header">Детали</div>
            <div class="card-body">
                <div class="tab-content" id="v-pills-tabContent">
                    @foreach (var item in Model)
                    {
                        <div class="tab-pane fade" id="pane-@item.Id" role="tabpanel" aria-labelledby="v-pills-@item.Id-tab" tabindex="0">
                            @await Html.PartialAsync("Details", item)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "Agents",
    Action = "Delete"
})

@section Scripts
{
    <script type="text/javascript">
        const tabs = document.querySelectorAll('#agents button');
        if (tabs.length > 0)
            OM.selectTab(tabs[0]);
    </script>
}

@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@model OnecMonitor.Server.ViewModels.Agents.AgentEditViewModel

@{
    ViewData["Title"] = Html.DisplayNameForModel();
}

<h2 class="mb-3">@Html.DisplayNameForModel()</h2>

<form method="post" asp-action="Save" style="height: 100%">
    <div class="mb-3">
        <button class="btn btn-primary" type="submit">Сохранить</button>
        <button class="btn btn-secondary" onclick="history.back()" type="button">Назад</button>
    </div>

    <input type="text" hidden class="form-control" asp-for="Id" value="@Model.Id">

    <div class="mb-3">
        <label asp-for="InstanceName" class="form-label">@Html.DisplayNameFor(c => c.InstanceName)</label>
        <label type="text" class="form-control" asp-for="InstanceName">@Model.InstanceName</label>
    </div>

    <div class="mb-3">
        <label asp-for="IsConnected" class="form-label">@Html.DisplayNameFor(c => c.IsConnected)</label>
        <label type="text" class="form-control" asp-for="IsConnected">@Model.IsConnected</label>
    </div>
    
    <div class="mb-3">
        <div class="row">
            <div class="col">
                <div class="card">
                    <div class="card-header">@Html.DisplayNameFor(c => c.InstalledPlatforms)</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(c => c.InstalledPlatforms[0].Version)</th>
                                    <th>@Html.DisplayNameFor(c => c.InstalledPlatforms[0].Arch)</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model.InstalledPlatforms)
                                {
                                    <tr>
                                        <td>@item.Version</td>
                                        <td>@item.Arch</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <div class="card-header">@Html.DisplayNameFor(c => c.RagentServices)</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(c => c.RagentServices[0].Name)</th>
                                    <th>@Html.DisplayNameFor(c => c.RagentServices[0].IsActive)</th>
                                    <th>@Html.DisplayNameFor(c => c.RagentServices[0].Port)</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model.RagentServices)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.IsActive</td>
                                        <td>@item.Port</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="card">
            <div class="card-header">@Html.DisplayNameFor(c => c.RasServices)</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(c => c.RasServices[0].Name)</th>
                            <th>@Html.DisplayNameFor(c => c.RasServices[0].IsActive)</th>
                            <th>@Html.DisplayNameFor(c => c.RasServices[0].RagentHost)</th>
                            <th>@Html.DisplayNameFor(c => c.RasServices[0].RagentPort)</th>
                            <th>@Html.DisplayNameFor(c => c.RasServices[0].Port)</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.RasServices)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.IsActive</td>
                                <td>@item.RagentHost</td>
                                <td>@item.RagentPort</td>
                                <td>@item.Port</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        @await Html.PartialAsync("SelectItemDialog", new SelectItemDialogViewModel(
            Html.DisplayNameFor(c => c.Clusters),
            nameof(Model.Clusters),
            Model.Clusters,
            Model.AvailableClusters))
    </div>
    
</form>
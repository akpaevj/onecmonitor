@model OnecMonitor.Server.ViewModels.SelectItemDialogViewModel

@{
    var nameInputName = Model.ItemsModelProperty + "[].Name";
    var idInputName = Model.ItemsModelProperty + "[].Id";
}
<div class="card">
    <div class="card-header">
        <div class="col">
            <span class="align-middle">@Model.Title</span>
            <button type="button" class="btn btn-sm ms-2 btn-outline-secondary align-middle" data-bs-toggle="modal" data-bs-target="#@Model.ItemsModelProperty-dialog">Добавить</button>
        </div>
    </div>
    <div class="card-body">
        <div id="@Model.ItemsModelProperty-list" class="list-group">
            @foreach (var item in Model.Items)
            {
                <button type="button" class="list-group-item list-group-item-action">
                    @item.Name
                    <input type="text" name="@nameInputName" value="@item.Name" hidden>
                    <input type="text" name="@idInputName" value="@item.Id" hidden>
                </button>
            }
        </div>
    </div>
</div>

<div class="modal" id="@Model.ItemsModelProperty-dialog" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Выберите элемент</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col">
                    <div class="input-group rounded mb-2">
                        <input type="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                        <span class="input-group-text border-0" id="search-addon">
                            <i class="bi bi-search"></i>
                        </span>
                    </div>
                    <div class="list-group">
                        @foreach (var item in Model.AvailableItems)
                        {
                            <button type="button" class="list-group-item list-group-item-action">
                                @{
                                    @item.Name
                                    <input type="text" name="@nameInputName" value="@item.Name" hidden>
                                    <input type="text" name="@idInputName" value="@item.Id" hidden>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.addEventListener('load', () =>{
        OM.initSelectItemDialog('@Model.ItemsModelProperty');
    })
</script>

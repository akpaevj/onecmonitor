@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.Helpers
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnecMonitor</title>
    <link rel="stylesheet" href="~/bundle.css" asp-append-version="true" />
</head>
<body>

<div class="container-fluid">
    <div class="row flex-nowrap">
        <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark-subtle">
            <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <a class="navbar-brand" asp-controller="Agents" asp-action="Index">
                        <p class="fs-3 m-3">
                            <span class="text-primary">OneС</span>Mon<span class="text-primary">i</span>tor
                        </p>
                    </a>
                </a>
                <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="mainMenu">
                    <li>
                        <a href="#infoBasesServiceSubMenu" data-bs-toggle="collapse" aria-controls="infoBasesServiceSubMenu" aria-expanded="false" class="text-primary nav-link text-white px-0 align-middle">
                            <i class="fs-4 bi-database"></i>
                            <span class="ms-1 d-none d-sm-inline">Обслуживание</span>
                        </a>
                        <ul class="collapse show nav flex-column ms-1" id="infoBasesServiceSubMenu" data-bs-parent="#mainMenu">
                            <li class="w-100">
                                <a asp-controller="Credentials" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Учетные данные</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="Clusters" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Кластеры</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="InfoBases" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Информационные базы</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="V8Files" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Файлы 1С</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="MaintenanceTasks" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Задачи обслуживания</small>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li hidden>
                        <a href="#techLogSubMenu" data-bs-toggle="collapse" aria-controls="techLogSubMenu" aria-expanded="false" class="text-primary nav-link text-white px-0 align-middle">
                            <i class="fs-4 bi-list-columns"></i>
                            <span class="ms-1 d-none d-sm-inline">Тех. журнал</span>
                        </a>
                        <ul class="collapse show nav flex-column ms-1" id="techLogSubMenu" data-bs-parent="#mainMenu">
                            <li class="w-100">
                                <a asp-controller="TechLogSettings" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Настройки</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="TechLogSeances" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Сеансы сбора</small>
                                </a>
                            </li>
                            <li class="w-100">
                                <a asp-controller="LogTemplates" asp-action="Index" class="nav-link text-white px-0">
                                    <small class="d-none d-sm-inline">Шаблоны</small>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col py-3">
            <div class="container-fluid h-100">
                <main role="main" class="pb-3 h-100">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
</div>

<script src="~/bundle.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>


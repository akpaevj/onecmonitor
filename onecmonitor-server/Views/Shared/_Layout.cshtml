@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject AppDbContext DbContext;

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>@ViewData["Title"] - OnecMonitor</title>
        <link rel="stylesheet" href="~/bundle.css" asp-append-version="true"/>
    </head>
    <body class="h-100">
        <div class="container-fluid h-100">
            <div class="row flex-nowrap">
                <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark-subtle">
                    <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                        <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                            <a class="navbar-brand align-self-center" asp-controller="Agents" asp-action="Index">
                                <p class="fs-3 m-3">
                                    <span class="text-primary">OneС</span>Mon<span class="text-primary">i</span>tor
                                </p>
                            </a>
                        </a>
                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start">
                            <li>
                                <div class="d-flex nav-link px-0 align-middle">
                                    <i class="fs-4 bi-database" style="color: #ADFF2F"></i>
                                    <span class="ms-2 align-self-center d-inline text-white">Обслуживание</span>
                                </div>
                                <ul class="nav flex-column ms-3">
                                    <li class="w-100">
                                        <a asp-controller="Clusters" asp-action="Dashboard" class="nav-link px-0 text-white">
                                            <small class="d-inline">Кластеры и ИБ</small>
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="V8Files" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">Конфигурации и обработки</small>
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="MaintenanceTasks" asp-action="Index" asp-route-isTemplate="false"
                                           class="nav-link px-0 text-white">
                                            <small class="d-inline">Задачи обслуживания</small>
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="MaintenanceTasks" asp-action="Index" asp-route-isTemplate="true"
                                           class="nav-link px-0 text-white">
                                            <small class="d-inline">Шаблоны задач обслуживания</small>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <div class="d-flex nav-link px-0 align-middle">
                                    <i class="fs-4 bi-list-task" style="color: #ffc42f"></i>
                                    <span class="ms-2 align-self-center d-inline text-white">Тех. журнал</span>
                                </div>
                                <ul class="nav flex-column ms-3">
                                    <li class="w-100">
                                        <a asp-controller="TechLogSettings" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">Настройки</small>
                                        </a>
                                    </li>
                                    @if (DbContext.TechLogSettings.FirstOrDefault()?.Enabled == true)
                                    {
                                        <li class="w-100">
                                            <a asp-controller="TechLogSeances" asp-action="Index" class="nav-link px-0 text-white">
                                                <small class="d-inline">Сеансы сбора</small>
                                            </a>
                                        </li>
                                        <li class="w-100">
                                            <a asp-controller="LogTemplates" asp-action="Index" class="nav-link px-0 text-white">
                                                <small class="d-inline">Шаблоны</small>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li>
                                <div class="d-flex nav-link px-0 align-middle">
                                    <i class="fs-4 bi-list-columns" style="color: #2fd9ff"></i>
                                    <span class="ms-2 align-self-center d-inline text-white">Журнал регистрации</span>
                                </div>
                                <ul class="nav flex-column ms-3">
                                    <li class="w-100">
                                        <a asp-controller="EventLogSettings" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">Настройки</small>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <div class="d-flex nav-link px-0 align-middle">
                                    <i class="fs-4 bi-gear" style="color: #7b2fff"></i>
                                    <span class="ms-2 align-self-center d-inline text-white">Общее</span>
                                </div>
                                <ul class="nav flex-column ms-3">
                                    <li class="w-100">
                                        <a asp-controller="Agents" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">Агенты монитора</small>
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Credentials" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">Учетные данные</small>
                                        </a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="Dbms" asp-action="Index" class="nav-link px-0 text-white">
                                            <small class="d-inline">СУБД</small>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-auto col-md-9 col-xl-10 px-sm-10 py-3">
                    <div class="container-fluid h-100">
                        <main role="main" class="h-100">
                            @RenderBody()
                        </main>
                    </div>
                </div>
            </div>
        </div>
    <script src="~/bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>


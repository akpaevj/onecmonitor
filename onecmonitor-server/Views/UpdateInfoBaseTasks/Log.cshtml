@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@using OnecMonitor.Server.ViewModels.Agents;
@model List<OnecMonitor.Server.Models.UpdateInfoBaseTaskResult>

@{
    ViewData["Title"] = "Лог обновления инф. баз";
}

<h2 class="mb-3">Лог обновления инф. баз</h2>

<div class="row">
    <div class="col-3">
        <div class="card">
            <div class="card-header">Инф. базы</div>
            <div class="card-body">
                <ul class="nav nav-pills flex-column align-items-center" id="myTab" role="tablist">
                    @foreach (var result in Model)
                    {
                        var id = result.InfoBase.Id.ToString().Replace("-", "");

                        <li class="nav-item w-100" role="presentation">
                            <button class="nav-link w-100" id="pane_@id" data-bs-toggle="tab" data-bs-target="#tab_@id" type="button" role="tab" aria-controls="tab_@id" aria-selected="false">@result.InfoBase.InfoBaseName</button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-header">Журнал</div>
            <div class="card-body">
                <div class="tab-content" id="myTabContent">
                    @foreach (var result in Model)
                    {
                        var id = result.InfoBase.Id.ToString().Replace("-", "");

                        <div class="tab-pane fade" id="tab_@id" role="tabpanel" aria-labelledby="pane_@id" tabindex="0">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                    <tr>
                                        <th class="col">Время</th>
                                        <th class="col">Ошибка</th>
                                        <th class="col">Сообщение</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in result.Log.OrderBy(c => c.TimeStamp))
                                    {
                                        <tr>
                                            <td>@item.TimeStamp</td>
                                            @if (item.IsError)
                                            {
                                                <td class="text-danger">@item.IsError</td>
                                            }
                                            else
                                            {
                                                <td class="text-success">@item.IsError</td>
                                            }
                                            <td>@item.Message</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
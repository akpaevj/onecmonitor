@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@using OnecMonitor.Server.ViewModels.Agents.Index;
@model List<OnecMonitor.Server.ViewModels.UpdateInfoBaseTasks.UpdateInfoBaseTaskListItemViewModel>

@{
    ViewData["Title"] = "Update infobase tasks";
}

<h2 class="mb-3">Update infobase tasks</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Edit" role="button">Add</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th class="col">Description</th>
            <th class="col">IsStarted</th>
            <th class="col">IsFaulted</th>
            <th class="col">IsFinished</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.IsStarted</td>
                <td>@item.IsFaulted</td>
                <td>@item.IsFinished</td>
                <td class="text-center">
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Description')">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "UpdateInfoBaseTasks",
    Action = "Delete"
})
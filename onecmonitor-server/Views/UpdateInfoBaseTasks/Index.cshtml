@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OnecMonitor.Server.ViewModels
@using OnecMonitor.Server.ViewModels.Agents;
@model List<OnecMonitor.Server.ViewModels.UpdateInfoBaseTasks.UpdateInfoBaseTaskListItemViewModel>

@{
    ViewData["Title"] = "Задачи обновления инф. баз";
}

<h2 class="mb-3">Задачи обновления инф. баз</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Edit" role="button">Добавить</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th class="col">Описание</th>
            <th class="col">Запущена</th>
            <th class="col">Есть ошибки</th>
            <th class="col">Завершена</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.IsStarted</td>
                <td>@item.IsFaulted</td>
                <td>@item.IsFinished</td>
                <td class="text-center">
                    @if (item.IsStarted)
                    {
                        <a class="btn btn-outline-info btn-sm" asp-action="Log" asp-route-id="@item.Id">Лог</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Start" asp-route-id="@item.Id">Запустить</a>
                    }
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                    <a class="btn btn-outline-danger btn-sm" onclick="OM.openDeleteDialog('@item.Id', '@item.Description')">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("DeleteDialog", new DeleteDialogViewModel
{
    Controller = "UpdateInfoBaseTasks",
    Action = "Delete"
})
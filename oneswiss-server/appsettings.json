{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },

  "Http": {
    "Host": "0.0.0.0",
    "Port": 7002
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=oneswiss;Username=postgres;Password=postgres"
  },

  "Auth": {
    "Mode": "Internal",

    "RequireClientsAuthentication": true,

    "Jwt": {
      "Issuer": "OneSwiss",
      "Audience": "OneSwiss.Web",
      "SigningKey": "change-me-to-very-long-random-secret-key-32chars-min",
      "AccessTokenLifetimeMinutes": 480,
      "RefreshTokenLifetimeDays": 14
    },

    "OIDC": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [
        "profile",
        "openid"
      ],
      "NameClaim": "preferred_username",
      "DisplayNameClaim": "name"
    }
  },

  "Ui": {
    "ReactUrl": "http://localhost:3000"
  },

  "ProxyAddress": ""
}

@page "/settings"
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Pages.AccessGroups
@using OneSwiss.Server.Components.Pages.ErrorLoggingService
@using OneSwiss.Server.Components.Pages.GitRepositories.GitSyncTasks
@using OneSwiss.Server.Components.Pages.Notifications
@using OneSwiss.Server.Components.Pages.TechLog
@using OneSwiss.Server.Components.Pages.UsersAndGroups
@using OneSwiss.Server.Components.Pages.CrServerProxy
@using OneSwiss.Server.Components.Pages.EventLog

@inject NavigationManager NavManager

@attribute [ExtAuthorize]

<PageTitle>Настройки</PageTitle>

<MudTabs @ref="_tabs" Position="Position.Top" @bind-ActivePanelIndex="_activeIndex" Elevation="2" Rounded="true"
         ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Группы доступа" ID="@("accessGroups")">
        <AccessGroups/>
    </MudTabPanel>
    <MudTabPanel Text="Пользователи" ID="@("users")">
        <Users/>
    </MudTabPanel>
    <MudTabPanel Text="Технологический журнал" ID="@("techlog")">
        <TechLogSettings/>
    </MudTabPanel>
    <MudTabPanel Text="Журнал регистрации" ID="@("eventLog")">
        <MudStack>
            <EventLogSettings/>
            <EventLogExportItems/>
        </MudStack>
    </MudTabPanel>
    <MudTabPanel Text="Сервис регистрации ошибок" ID="@("errorReporting")">
        <ErrorLoggingServiceSettings/>
    </MudTabPanel>
    <MudTabPanel Text="Сервис синхронизации хранилищ и git" ID="@("gitSync")">
        <GitSyncSettings/>
    </MudTabPanel>
    <MudTabPanel Text="Прокси серверов хранилищ" ID="@("crServersProxy")">
        <MudStack>
            <CrServerProxySettings/>
            <CrServerProxyLocations/>
            <CrServerProxyMiddlewares/>
        </MudStack>
    </MudTabPanel>
    <MudTabPanel Text="Уведомления" ID="@("notifications")">
        <MudStack>
            <TelegramBotSettings/>
            <CustomNotificationsSettings/>
            <RecipientsSettings/>
        </MudStack>
    </MudTabPanel>
</MudTabs>

@code {
    private MudTabs? _tabs;
    private int _activeIndex;

    [SupplyParameterFromQuery] public string? Tab { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Tab != null)
            _tabs?.ActivatePanel(Tab);
    }

}
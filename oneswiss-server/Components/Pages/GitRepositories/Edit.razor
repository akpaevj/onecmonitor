@page "/gitrepositories/{id:guid}"
@page "/gitrepositories/create"
@using FluentValidation
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models

@attribute [ExtAuthorize(Roles.WriteGitRepositories)]

<EditDatabaseForm @ref="_editor" T="GitRepository"
                  Id="Id"
                  NameSelector="@(arg => arg.Name)"
                  Route="gitrepositories"
                  Title="Новый репозиторий GIT"
                  Validation="_validator.ValidateValue">
    <MudStack>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" Label="Наименование"
                      @bind-Value="@_editor.Model!.Name"/>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Address)" Label="Адрес"
                      @bind-Value="@_editor.Model!.Address"/>
        <ItemSelector
            @bind-Value="@_editor.Model!.TokenId"
            Items="@_editor.Context!.Credentials.Where(c => c.IsToken).ToList()"
            Class="mb-3"
            ItemValueSelector="arg => arg.Id"
            Label="Токен"
            ItemNameSelector="arg => arg.Name"
            For="@(() => _editor.Model!.TokenId)"/>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<GitRepository> _editor = null!;

    [Parameter] public Guid Id { get; set; }

    class Validator : ModelValidator<GitRepository>
    {
        public Validator()
        {
            RuleFor(c => c.Name)
                .NotEmpty()
                .WithMessage("Не заполнено наименование");

            RuleFor(c => c.Address)
                .NotEmpty()
                .WithMessage("Не заполнен адрес");

            RuleFor(c => c.TokenId)
                .NotEmpty()
                .WithMessage("Не задан токен аутентификации");
        }
    }
}

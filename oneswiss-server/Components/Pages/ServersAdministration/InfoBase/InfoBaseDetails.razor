
@if (AgentIsConnected)
{
    <MudTabs PanelClass="mt-3">
        <MudTabPanel Text="Данные кластера">
            <V8InfoBaseEdit Id="@Id"></V8InfoBaseEdit>
        </MudTabPanel>
        <MudTabPanel Text="Данные OneSwiss">
            <InfoBaseEdit Id="@Id"/>
        </MudTabPanel>
    </MudTabs>
}
else
{
    <InfoBaseEdit Id="@Id"/>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [Parameter] public bool AgentIsConnected { get; set; }
}
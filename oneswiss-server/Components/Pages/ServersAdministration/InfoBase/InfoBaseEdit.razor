@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models
@using Microsoft.AspNetCore.Components.Authorization
@using OneSwiss.Server.Extensions

<AuthorizeView>
    @{
        var readOnly = context.IsReadOnly(BuiltInRoles.WriteClusterItemsInfo);
        
        <InlineEditDatabaseForm @ref="_editor" T="InfoBase" Id="Id" Editable="!readOnly">
            <MudStack>
                <MudSelect Class="mb-3" Label="Учетные данные администратора" ReadOnly="readOnly" Variant="Variant.Outlined" @bind-Value="@_editor.Model!.CredentialsId" Clearable="@true">
                    @foreach (var item in _editor.Context!.Credentials.ToList())
                    {
                        <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
                    }
                </MudSelect>

            </MudStack>
        </InlineEditDatabaseForm>
    }
</AuthorizeView>

@code
{
    private InlineEditDatabaseForm<InfoBase> _editor = null!;
    
    [Parameter]
    public Guid Id { get; set; }
}
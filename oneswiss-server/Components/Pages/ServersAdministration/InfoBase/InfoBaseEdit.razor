@using Microsoft.AspNetCore.Components.Authorization
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
<AuthorizeView>
    @{
        var readOnly = context.IsReadOnly(Roles.WriteClusterItemsInfo);

        <InlineEditDatabaseForm @ref="_editor" T="InfoBase" Id="Id" Editable="!readOnly">
            <MudStack>
                <ItemSelector
                    @bind-Value="@_editor.Model!.CredentialsId"
                    Items="@_editor.Context!.Credentials.Where(c => !c.IsToken).ToList()"
                    Class="mb-3"
                    ItemValueSelector="arg => arg.Id"
                    ItemNameSelector="arg => arg.Name"
                    Variant="Variant.Outlined"
                    Label="Учетные данные администратора"
                    For="@(() => _editor.Model!.CredentialsId)"/>
            </MudStack>
        </InlineEditDatabaseForm>
    }
</AuthorizeView>

@code
{
    private InlineEditDatabaseForm<InfoBase> _editor = null!;

    [Parameter] public Guid Id { get; set; }
}
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@using OneSwiss.V8.Platform.RemoteAdministration

<ClusterObjectDetails 
    @ref="_details" 
    T="V8InfoBaseDetails"
    GetAgentConnectionCallback="GetAgentConnectionCallback"
    SaveAble="true" 
    OnSave="OnSave" 
    BeforeLoadModel="BeforeLoadModel"
    OnLoadModel="OnLoadModel">
    <MudStack Class="mb-3" Row Breakpoint="Breakpoint.SmAndDown" StretchItems="StretchItems.All">
        <MudCard>
            <MudCardHeader>
                <MudText>Основное</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudTextField Disabled="true" For="@(() => _details.Model.Name)" Variant="Variant.Outlined" Label="Наименование" @bind-Value="@_details.Model.Name"/>
                    <MudTextField For="@(() => _details.Model.Description)" Variant="Variant.Outlined" Label="Описание" @bind-Value="@_details.Model.Description"/>
                    <MudSelect Disabled="true" Label="Защищенное соединение" Variant="Variant.Outlined" For="@(() => _details.Model.SecurityLevel)" @bind-Value="@_details.Model.SecurityLevel">
                        @foreach (var item in Enum.GetValues<V8SecurityLevel>())
                        {
                            <MudSelectItem Value="item">@item.GetDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField For="@(() => _details.Model.DbServer)" Variant="Variant.Outlined" Label="Сервер баз данных" @bind-Value="@_details.Model.DbServer"/>
                    <MudSelect Label="тип СУБД" For="@(() => _details.Model.Dbms)" Variant="Variant.Outlined" @bind-Value="@_details.Model.Dbms">
                        @foreach (var item in Enum.GetValues<V8InfoBaseDbms>())
                        {
                            <MudSelectItem Value="item">@item.GetDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField For="@(() => _details.Model.DbName)" Variant="Variant.Outlined" Label="База данных" @bind-Value="@_details.Model.DbName"/>
                    <MudTextField For="@(() => _details.Model.DbUser)" Variant="Variant.Outlined" Label="Пользователь сервера БД" @bind-Value="@_details.Model.DbUser"/>
                    <MudTextField For="@(() => _details.Model.DbPwd)" Variant="Variant.Outlined" Label="Пароль пользователя БД" @bind-Value="@_details.Model.DbPwd"/>
                    <MudSwitch For="@(() => _details.Model.LicenseDistribution)" Color="Color.Primary" Label="Разрешить выдачу лицензий сервером 1С:Предприятие" @bind-Value="@_details.Model.LicenseDistribution"/>
                </MudStack>
            </MudCardContent>
        </MudCard>
        <MudCard>
            <MudCardHeader>
                <MudText>Блокировка</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudSwitch For="@(() => _details.Model.SessionsDeny)" Color="Color.Primary" Label="Блокировка начала сеансов включена" @bind-Value="@_details.Model.SessionsDeny"/>
                    <MudSwitch For="@(() => _details.Model.ScheduledJobsDeny)" Color="Color.Primary" Label="Блокировка регламентных заданий включена" @bind-Value="@_details.Model.ScheduledJobsDeny"/>
                    <MudInput InputType="InputType.DateTimeLocal" For="@(() => _details.Model.DeniedFrom)" Label="Начало" @bind-Value="@_details.Model.DeniedFrom"/>
                    <MudInput InputType="InputType.DateTimeLocal" For="@(() => _details.Model.DeniedTo)" Label="Окончание" @bind-Value="@_details.Model.DeniedTo"/>
                    <MudTextField For="@(() => _details.Model.DeniedMessage)" Variant="Variant.Outlined" Label="Сообщение" @bind-Value="@_details.Model.DeniedMessage"/>
                    <MudTextField For="@(() => _details.Model.PermissionCode)" Variant="Variant.Outlined" Label="Код разрешения" @bind-Value="@_details.Model.PermissionCode"/>
                    <MudTextField For="@(() => _details.Model.DeniedParameter)" Variant="Variant.Outlined" Label="Параметр блокировки" @bind-Value="@_details.Model.DeniedParameter"/>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudStack>
    <MudStack Class="mb-3" Row Breakpoint="Breakpoint.SmAndDown" StretchItems="StretchItems.All">
        <MudCard>
            <MudCardHeader>
                <MudText>Дополнительно</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudTextField For="@(() => _details.Model.ExternalSessionManagerConnectionString)" Variant="Variant.Outlined" Label="Внешнее управление сеансами" @bind-Value="@_details.Model.ExternalSessionManagerConnectionString"/>
                    <MudSwitch For="@(() => _details.Model.ExternalSessionManagerRequired)" Color="Color.Primary" Label="Обязательное использование внешнее управление" @bind-Value="@_details.Model.ExternalSessionManagerRequired"/>
                    <MudSelect Label="Профиль безопасности" For="@(() => _details.Model.SecurityProfileName)" Variant="Variant.Outlined" @bind-Value="@_details.Model.SecurityProfileName">
                        @foreach (var item in _securityProfiles)
                        {
                            <MudSelectItem Value="item">@item</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect Label="Профиль безопасности безопасного режима" For="@(() => _details.Model.SafeModeSecurityProfileName)" Variant="Variant.Outlined" @bind-Value="@_details.Model.SafeModeSecurityProfileName">
                        @foreach (var item in _securityProfiles)
                        {
                            <MudSelectItem Value="item">@item</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch For="@(() => _details.Model.ReserveWorkingProcesses)" Color="Color.Primary" Label="Резервирование рабочих процессов" @bind-Value="@_details.Model.ReserveWorkingProcesses"/>
                    <MudSwitch For="@(() => _details.Model.DisableLocalSpeechToText)" Color="Color.Primary" Label="Запретить локальное распознавание речи" @bind-Value="@_details.Model.DisableLocalSpeechToText"/>
                </MudStack>
            </MudCardContent>
        </MudCard>
        <MudCard>
            <MudCardHeader>
                <MudText>При отсутствии активных пользователей</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudNumericField For="@(() => _details.Model.ConfigurationUnloadDelayByWorkingProcessWithoutActiveUsers)" Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined" Label="Задержка выгрузки конфигурации рабочим процессом" @bind-Value="@_details.Model.ConfigurationUnloadDelayByWorkingProcessWithoutActiveUsers"/>
                    <MudNumericField For="@(() => _details.Model.MinimumScheduledJobsStartPeriodWithoutActiveUsers)" Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined" Label="Минимальный период запуска регламентных заданий" @bind-Value="@_details.Model.MinimumScheduledJobsStartPeriodWithoutActiveUsers"/>
                    <MudNumericField For="@(() => _details.Model.MaximumScheduledJobsStartShiftWithoutActiveUsers)" Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined" Label="Максимальный сдвиг запуска регламентных заданий" @bind-Value="@_details.Model.MaximumScheduledJobsStartShiftWithoutActiveUsers"/>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudStack>
</ClusterObjectDetails>

@code {
    private InfoBase _item = null!;
    private ClusterObjectDetails<V8InfoBaseDetails> _details = null!;
    private List<string> _securityProfiles = [];

    [Parameter]
    public Guid Id { get; set; }
    
    private async Task BeforeLoadModel(IDbContextFactory<AppDbContext> contextFactory)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        
        _item = (await context.InfoBases
            .AsNoTracking()
            .Include(c => c.Credentials)
            .Include(c => c.Cluster.Credentials)
            .FirstOrDefaultAsync(c => c.Id == Id))!;
    }
    
    private async Task<V8InfoBaseDetails> OnLoadModel(AgentConnection connection)
        => await connection.GetV8InfoBaseDetails(_item, CancellationToken.None);

    private async Task OnSave(AgentConnection connection, Dictionary<string, string> changedProperties)
        => await connection.ChangeInfoBaseParameters(_item, changedProperties, CancellationToken.None);

    private AgentConnection? GetAgentConnectionCallback(AgentsConnectionsManager agentsConnectionsManager)
        => agentsConnectionsManager.GetAgentConnection(_item.Cluster.AgentId);

}
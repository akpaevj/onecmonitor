@inject AgentsConnectionsManager AgentsConnectionsManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject IMapper Mapper
@inject ISnackbar Snackbar
@using System.Reflection
@using global::AutoMapper
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Services
@using OneSwiss.V8.Platform.RemoteAdministration
@typeparam T where T : class

@if (_isLoading || Model is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"></MudProgressLinear>
}
else
{
    <MudStack Class="@Class">
        @if (SaveAble)
        {
            <MudStack Row AlignItems="AlignItems.Start" Class="mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSaveInternal">Сохранить</MudButton>
            </MudStack>
        }
        @ChildContent
    </MudStack>
}

@code {
    private bool _isLoading;
    private T? _srcModel;
    
    public T? Model { get; set; }

    [Parameter] 
    public string Class { get; set; } = string.Empty;
    
    [Parameter]
    public bool SaveAble { get; set; }
    
    [Parameter] 
    public Func<AgentsConnectionsManager, AgentConnection?> GetAgentConnectionCallback { get; set; } = null!;

    [Parameter] 
    public Func<AgentConnection, Dictionary<string, string>, Task>? OnSave { get; set; }
    
    [Parameter] 
    public RenderFragment? ChildContent { get; set; }
    
    [Parameter] 
    public Func<IDbContextFactory<AppDbContext>, Task>? BeforeLoadModel { get; set; }

    [Parameter] 
    public Func<AgentConnection, Task<T>> OnLoadModel { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadModel();
    }

    private async Task LoadModel()
    {
        if (_isLoading)
            return;

        _isLoading = true;

        try
        {
            if (BeforeLoadModel != null)
                await BeforeLoadModel.Invoke(ContextFactory);

            var connection = GetAgentConnectionCallback(AgentsConnectionsManager);
            if (connection == null)
            {
                Snackbar.ShowWarning("Не удалось найти активное соединение с агентом");
            }
            else
            {
                _srcModel = await OnLoadModel(connection);
                Model = Mapper.Map<T>(_srcModel);
            }
        }
        catch (Exception e)
        {
            Snackbar.ShowError(e);
        }

        _isLoading = false;
    }

    private Dictionary<string, string> GetChangedParameters()
    {
        var result = new Dictionary<string, string>();
        
        var properties = typeof(T).GetProperties().Where(c => Attribute.IsDefined(c, typeof(RacFieldAttribute)));

        foreach (var propertyInfo in properties)
        {
            var attr = propertyInfo.GetCustomAttribute<RacFieldAttribute>();
            var racFieldName = attr!.Name;
            var trueFalseForm = attr.TrueFalseForm;
            
            var srcValue = propertyInfo.GetValue(_srcModel);
            var editedValue = propertyInfo.GetValue(Model);

            if (srcValue?.Equals(editedValue) != false) 
                continue;
            
            if (propertyInfo.PropertyType == typeof(bool))
                result.Add(racFieldName, trueFalseForm switch
                {
                    RacFieldTrueFalseForm.TrueFalse => (bool)editedValue! ? "true" : "false",
                    RacFieldTrueFalseForm.YesNo => (bool)editedValue! ? "yes" : "no",
                    RacFieldTrueFalseForm.AllowDeny => (bool)editedValue! ? "allow" : "deny",
                    RacFieldTrueFalseForm.OnOff => (bool)editedValue! ? "on" : "off",
                    _ => throw new ArgumentOutOfRangeException()
                });
            else
                result.Add(racFieldName, editedValue!.ToString()!);
        }

        return result;
    }

    public async Task OnSaveInternal()
    {
        var changedProperties = GetChangedParameters();
        if (changedProperties.Count == 0)
        {
            Snackbar.ShowMessage("Параметры объекта не изменены");
            return;
        }
        
        var connection = GetAgentConnectionCallback(AgentsConnectionsManager);
        if (connection == null)
        {
            Snackbar.ShowWarning("Не удалось найти активное соединение с агентом");
        }
        else
        {
            try
            {
                await OnSave!(connection, changedProperties);
                Snackbar.ShowSuccess("Объект записан");
            }
            catch (Exception e)
            {
                Snackbar.ShowError(e);
            }
        }
    }
}
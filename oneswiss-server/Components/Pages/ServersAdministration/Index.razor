@page "/"
@using Blazor.Diagrams.Core.Models.Base
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Components.Pages.ServersAdministration.Cluster
@using OneSwiss.Server.Components.Pages.ServersAdministration.InfoBase
@using OneSwiss.Server.Components.Pages.ServersAdministration.Process
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject AgentsConnectionsManager AgentsConnectionsManager
@rendermode InteractiveServer

<PageTitle>Администрирование серверов</PageTitle>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4">
            <TreeView @bind-SelectedItem="_selectedItem" @bind-Items="_items"/>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="9">
        @if (_selectedItem is { Item.DynamicComponentType: not null })
        {
            <DynamicComponent 
                @ref="_dynamicComponent" 
                @key="_selectedItem.Item.Id" 
                Type="_selectedItem.Item.DynamicComponentType" 
                Parameters="_selectedItem.Item.Parameters"/>
        }
    </MudItem>
</MudGrid>

@code
{
    HubConnection? _hubConnection;
    private IReadOnlyCollection<TreeItem> _items = [];
    private TreeViewItem? _selectedItem;
    private DynamicComponent _dynamicComponent;

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/agentsHub"))
            .Build();

        _hubConnection.On("AgentsStateUpdated", async () =>
        {
            await UpdateItems();
            await InvokeAsync(StateHasChanged);
        });
        
        await _hubConnection.StartAsync();

        await UpdateItems();
    }

    private async Task UpdateItems()
    {
        _items = await LoadAgents();
    }
    
    private async Task<List<TreeItem>> LoadAgents()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var agents = await context.Agents.AsNoTracking().ToListAsync();
        
        return agents.Select(c =>
        {
            var agentIsConnected = AgentsConnectionsManager.GetAgentConnection(c.Id) != null;
            
            return new TreeItem(c.Id.ToString())
            {
                Text = c.InstanceName,
                AdornmentIcon = Icons.Material.Filled.SupportAgent,
                AdornmentIconColor = agentIsConnected ? Color.Success : Color.Error,
                LoadChildrenFunc = () => LoadClusters(c, agentIsConnected),
                DynamicComponentType = typeof(AgentInfo),
                Parameters = new Dictionary<string, object> { { "Id", c.Id } }
            };
        }).ToList();
    }
    
    private async Task<List<TreeItem>> LoadClusters(Agent agent, bool agentIsConnected)
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var items = await context.Clusters
            .AsNoTracking()
            .Include(c => c.Credentials)
            .Where(c => c.AgentId == agent.Id).ToListAsync();
        
        return items.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = c.Name,
            AdornmentIcon = Icons.Material.Filled.AccountTree,
            AdornmentIconColor = Color.Warning,
            LoadChildrenFunc = () => LoadClusterChildren(c, agentIsConnected),
            DynamicComponentType = typeof(ClusterDetails), 
            Parameters = new Dictionary<string, object> { { "Id", c.Id }, { "AgentIsConnected", agentIsConnected } }
        }).ToList();
    }
    

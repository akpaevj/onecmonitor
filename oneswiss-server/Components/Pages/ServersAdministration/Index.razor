    private async Task<List<TreeItem>> LoadInfoBases(Models.Cluster cluster, bool agentIsConnected)
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var items = await context.InfoBases
            .AsNoTracking()
            .Include(c => c.Cluster.Credentials)
            .Include(c => c.Credentials)
            .Where(c => c.ClusterId == cluster.Id)
            .ToListAsync();
        
        return items.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = c.Name,
            AdornmentIcon = Icons.Material.Filled.Dataset,
            AdornmentIconColor = Color.Info,
            LoadChildrenFunc = () => LoadInfoBaseChildren(c),
            DynamicComponentType = typeof(InfoBaseDetails),
            Parameters = new Dictionary<string, object> { { "Id", c.Id }, { "AgentIsConnected", agentIsConnected } },
        }).ToList();
    }
    
    private static Task<List<TreeItem>> LoadInfoBaseChildren(Models.InfoBase infoBase)
        =>
            Task.FromResult<List<TreeItem>>([
                new TreeItem($"{infoBase.Id}730fd344-b3f0-4f4c-bf2e-42cdcf0ff2f4")
                {
                    Text = "Сеансы",
                    AdornmentIcon = Icons.Material.Filled.PersonPin,
                    AdornmentIconColor = Color.Secondary,
                    DynamicComponentType = typeof(Sessions),
                    Parameters = new Dictionary<string, object> { { "Cluster", infoBase.Cluster }, { "InfoBase", infoBase } } 
                }
            ]);
    
    private async Task<List<TreeItem>> LoadV8Processes(Models.Cluster cluster)
    {
        var connection = AgentsConnectionsManager.GetAgentConnection(cluster.AgentId);
        var processes = await connection!.GetV8Processes(cluster, CancellationToken.None);
        
        return processes.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = $"{c.Host} ({c.Pid})",
            AdornmentIcon = Icons.Material.Filled.WorkHistory,
            AdornmentIconColor = Color.Tertiary,
            DynamicComponentType = typeof(V8ProcessDetails),
            Parameters = new Dictionary<string, object>{ { "ClusterId", cluster.Id }, { "Id", Guid.Parse(c.Id) } }
        }).ToList();
    }
}

@page "/"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using MudExtensions
@using OneSwiss.Server.Components.Pages.ServersAdministration.Cluster
@using OneSwiss.Server.Components.Pages.ServersAdministration.InfoBase
@using OneSwiss.Server.Components.Pages.ServersAdministration.Process
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject AgentsConnectionsManager AgentsConnectionsManager
@inject IJSRuntime Js
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Администрирование серверов</PageTitle>

<MudSplitter EnableMargin="true" EnableSlide="true" @bind-Dimension="_dimension"
             @bind-Dimension:after="AfterDimensionChanged" Height="calc(100vh - 140px)">
    <StartContent>
        <TreeView @bind-SelectedItem="_selectedItem" Class="w-100" @bind-Items="_items"/>
    </StartContent>
    <EndContent>
        <MudPaper Class="pa-2 w-100 overflow-auto">
            @if (_selectedItem is { DynamicComponentType: not null })
            {
                <DynamicComponent
                    @ref="_dynamicComponent"
                    @key="_selectedItem.Id"
                    Type="_selectedItem.DynamicComponentType"
                    Parameters="_selectedItem.Parameters"/>
            }
        </MudPaper>
    </EndContent>
</MudSplitter>

@code
{
    HubConnection? _hubConnection;
    private IReadOnlyCollection<TreeItem> _items = [];
    private TreeItem? _selectedItem;
    private DynamicComponent? _dynamicComponent;
    private double _dimension = 20;
    private AuthenticationState _authState;

    [CascadingParameter] public Task<AuthenticationState> AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _authState = await AuthStateTask;

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/agentsHub"))
            .Build();

        _hubConnection.On("AgentsStateUpdated", async () =>
        {
            await UpdateItems();
            await InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();

        await UpdateItems();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dimension = await Js.GetLocalStorageItem<string?>("panel_dimension");

            if (!string.IsNullOrEmpty(dimension))
            {
                _dimension = double.Parse(dimension, CultureInfo.InvariantCulture);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task UpdateItems()
    {
        _items = await LoadAgents();
        _selectedItem = _items.FirstOrDefault();

        if (_dynamicComponent?.Instance is AgentInfo agentInfoView)
            await agentInfoView.UpdateState();
    }

    private async Task<List<TreeItem>> LoadAgents()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var agents = await context.Agents.AsNoTracking().ToListAsync();

        return agents.Select(c =>
        {
            var agentIsConnected = AgentsConnectionsManager.GetAgentConnection(c.Id) != null;

            return new TreeItem(c.Id.ToString())
            {
                Text = c.InstanceName,
                AdornmentIcon = Icons.Material.Filled.SupportAgent,
                AdornmentIconColor = agentIsConnected ? Color.Success : Color.Error,
                LoadChildrenFunc = _authState.IsInRoles(
                    Roles.ReadClusterItems,
                    Roles.WriteClusterItemsInfo)
                    ? () => LoadClusters(c,
                        agentIsConnected)
                    : null,
                DynamicComponentType = typeof(AgentInfo),
                Parameters = new Dictionary<string, object> { { "Id", c.Id } },
                ShowDeleteItemIcon = !agentIsConnected && _authState.IsInRoles(Roles.Administrator),
                DeleteItemCallBack = _ => DeleteItem(c, c.InstanceName)
            };
        }).ToList();
    }

    private async Task<List<TreeItem>> LoadClusters(Agent agent, bool agentIsConnected)
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var items = await context.Clusters
            .AsNoTracking()
            .Include(c => c.Credentials)
            .Where(c => c.AgentId == agent.Id).ToListAsync();

        return items.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = c.Name,
            AdornmentIcon = Icons.Material.Filled.AccountTree,
            AdornmentIconColor = Color.Warning,
            LoadChildrenFunc = () => LoadClusterChildren(c, agentIsConnected),
            DynamicComponentType = typeof(ClusterDetails),
            Parameters = new Dictionary<string, object> { { "Id", c.Id }, { "AgentIsConnected", agentIsConnected } }
        }).ToList();
    }

    private Task<List<TreeItem>> LoadClusterChildren(Models.Cluster cluster, bool agentIsConnected)
    {
        var result = new List<TreeItem>
        {
            new($"{cluster.Id}a09b5620-ebd2-4935-bc35-1572c99f7ac0")
            {
                Text = "Информационные базы",
                AdornmentIcon = Icons.Material.Filled.Dataset,
                AdornmentIconColor = Color.Info,
                LoadChildrenFunc = () => LoadInfoBases(cluster, agentIsConnected)
            }
        };

        if (!agentIsConnected)
            return Task.FromResult(result);

        result.Add(new TreeItem($"{cluster.Id}b25e2c62-5296-4672-888b-8904dcba5882")
        {
            Text = "Рабочие процессы",
            AdornmentIcon = Icons.Material.Filled.WorkHistory,
            AdornmentIconColor = Color.Tertiary,
            LoadChildrenFunc = () => LoadV8Processes(cluster)
        });

        if (_authState.IsInRoles(
                Roles.ReadSessions,
                Roles.CloseSessions))
        {
            result.Add(new TreeItem($"{cluster.Id}730fd344-b3f0-4f4c-bf2e-42cdcf0ff2f4")
            {
                Text = "Сеансы",
                AdornmentIcon = Icons.Material.Filled.PersonPin,
                AdornmentIconColor = Color.Tertiary,
                DynamicComponentType = typeof(Sessions),
                Parameters = new Dictionary<string, object> { { "Cluster", cluster } }
            });
        }

        return Task.FromResult(result);
    }

    private async Task<List<TreeItem>> LoadInfoBases(Models.Cluster cluster, bool agentIsConnected)
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var items = await context.InfoBases
            .AsNoTracking()
            .Include(c => c.Cluster.Credentials)
            .Include(c => c.Credentials)
            .Where(c => c.ClusterId == cluster.Id)
            .ToListAsync();

        return items.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = c.Name,
            AdornmentIcon = Icons.Material.Filled.Dataset,
            AdornmentIconColor = Color.Info,
            LoadChildrenFunc = () => LoadInfoBaseChildren(c),
            DynamicComponentType = typeof(InfoBaseDetails),
            Parameters = new Dictionary<string, object> { { "Id", c.Id }, { "AgentIsConnected", agentIsConnected } }
        }).ToList();
    }

    private Task<List<TreeItem>> LoadInfoBaseChildren(Models.InfoBase infoBase)
    {
        var result = new List<TreeItem>();

        if (_authState.IsInRoles(
                Roles.ReadSessions,
                Roles.CloseSessions))
            result.Add(new TreeItem($"{infoBase.Id}730fd344-b3f0-4f4c-bf2e-42cdcf0ff2f4")
            {
                Text = "Сеансы",
                AdornmentIcon = Icons.Material.Filled.PersonPin,
                AdornmentIconColor = Color.Tertiary,
                DynamicComponentType = typeof(Sessions),
                Parameters = new Dictionary<string, object> { { "Cluster", infoBase.Cluster }, { "InfoBase", infoBase } }
            });

        return Task.FromResult(result);
    }

    private async Task<List<TreeItem>> LoadV8Processes(Models.Cluster cluster)
    {
        var connection = AgentsConnectionsManager.GetAgentConnection(cluster.AgentId);
        var processes = await connection!.GetV8Processes(cluster, CancellationToken.None);

        return processes.Select(c => new TreeItem(c.Id.ToString())
        {
            Text = $"{c.Host} ({c.Pid})",
            AdornmentIcon = Icons.Material.Filled.WorkHistory,
            AdornmentIconColor = Color.Tertiary,
            DynamicComponentType = typeof(V8ProcessDetails),
            Parameters = new Dictionary<string, object> { { "ClusterId", cluster.Id }, { "Id", Guid.Parse(c.Id) } }
        }).ToList();
    }

    private async Task AfterDimensionChanged()
    {
        await Js.SetLocalStorageItem("panel_dimension", _dimension.ToString(CultureInfo.InvariantCulture));
    }

    private async Task DeleteItem<T>(T item, string name) where T : class, IHasId
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        await DialogService.ShowItemDeletingDialog<T>(item.Id, name);

        await UpdateItems();
        await InvokeAsync(StateHasChanged);
    }
}

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@using OneSwiss.V8.Platform.RemoteAdministration
<ClusterObjectDetails
    @ref="_details"
    T="V8Process"
    GetAgentConnectionCallback="GetAgentConnectionCallback"
    SaveAble="false"
    BeforeLoadModel="BeforeLoadModel"
    OnLoadModel="OnLoadModel">
    <MudStack StretchItems="StretchItems.All">
        <MudCard>
            <MudCardHeader>
                <MudText>Основное</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudTextField ReadOnly="true" For="@(() => _details.Model.Host)" Variant="Variant.Outlined"
                                  Label="Компьютер" @bind-Value="@_details.Model.Host"/>
                    <MudStack Row Breakpoint="Breakpoint.SmAndDown">
                        <MudSwitch ReadOnly="true" For="@(() => _details.Model.TurnedOn)" Color="Color.Primary"
                                   Label="Включен" @bind-Value="@_details.Model.TurnedOn"/>
                        <MudSwitch ReadOnly="true" For="@(() => _details.Model.Running)" Color="Color.Primary"
                                   Label="Активен" @bind-Value="@_details.Model.Running"/>
                        <MudSwitch ReadOnly="true" For="@(() => _details.Model.Reserve)" Color="Color.Primary"
                                   Label="Резервный" @bind-Value="@_details.Model.Reserve"/>
                    </MudStack>
                </MudStack>
            </MudCardContent>
        </MudCard>
        <MudStack Row Breakpoint="Breakpoint.SmAndDown" StretchItems="StretchItems.All">
            <MudCard>
                <MudCardHeader>
                    <MudText>О процессе</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.StartedAt)" Variant="Variant.Outlined"
                                      Label="Время запуска" @bind-Value="@_details.Model.StartedAt"/>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.Port)" Variant="Variant.Outlined"
                                      Label="Порт" @bind-Value="@_details.Model.Port"/>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.Connections)"
                                      Variant="Variant.Outlined" Label="Соединений"
                                      @bind-Value="@_details.Model.Connections"/>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.Pid)" Variant="Variant.Outlined"
                                      Label="PID" @bind-Value="@_details.Model.Pid"/>
                        <MudNumericField ReadOnly="true" For="@(() => _details.Model.MemorySize)"
                                         Adornment="Adornment.End" AdornmentText="KB"
                                         Culture="CultureInfo.InvariantCulture" Variant="Variant.Outlined"
                                         Label="Занято памяти" @bind-Value="@_details.Model.MemorySize"/>
                    </MudStack>
                </MudCardContent>
            </MudCard>
            <MudCard>
                <MudCardHeader>
                    <MudText>Средние показатели</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.AvailablePerfomance)"
                                      Variant="Variant.Outlined" Label="Доступная производительность"
                                      @bind-Value="@_details.Model.AvailablePerfomance"/>
                        <MudNumericField ReadOnly="true" For="@(() => _details.Model.AvgServerCallTime)"
                                         Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                         Culture="CultureInfo.InvariantCulture" Label="Среднее время вызова сервера"
                                         @bind-Value="@_details.Model.AvgServerCallTime"/>
                        <MudNumericField ReadOnly="true" For="@(() => _details.Model.AvgCallTime)"
                                         Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                         Culture="CultureInfo.InvariantCulture" Label="Среднее время вызова"
                                         @bind-Value="@_details.Model.AvgCallTime"/>
                        <MudNumericField ReadOnly="true" For="@(() => _details.Model.AvgDbCallTime)"
                                         Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                         Culture="CultureInfo.InvariantCulture" Label="Среднее время вызова СУБД"
                                         @bind-Value="@_details.Model.AvgDbCallTime"/>
                        <MudNumericField ReadOnly="true" For="@(() => _details.Model.AvgLockCallTime)"
                                         Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                         Culture="CultureInfo.InvariantCulture"
                                         Label="Среднее время вызова менеджера блокировок"
                                         @bind-Value="@_details.Model.AvgLockCallTime"/>
                        <MudTextField ReadOnly="true" For="@(() => _details.Model.AvgThreads)"
                                      Variant="Variant.Outlined" Label="Среднее количество клиентских потоков"
                                      @bind-Value="@_details.Model.AvgThreads"/>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudStack>
    </MudStack>
</ClusterObjectDetails>

@code {
    private Cluster? _cluster;
    private ClusterObjectDetails<V8Process>? _details;

    [Parameter] public Guid Id { get; set; }

    [Parameter] public Guid ClusterId { get; set; }

    private async Task BeforeLoadModel(IDbContextFactory<AppDbContext> contextFactory)
    {
        await using var context = await contextFactory.CreateDbContextAsync();

        _cluster = (await context.Clusters
            .AsNoTracking()
            .Include(c => c.Credentials)
            .FirstOrDefaultAsync(c => c.Id == ClusterId))!;
    }

    private async Task<V8Process> OnLoadModel(AgentConnection connection)
    {
        var processes = await connection.GetV8Processes(_cluster!, CancellationToken.None);
        return processes.First(c => c.Id == Id.ToString());
    }

    private AgentConnection? GetAgentConnectionCallback(AgentsConnectionsManager agentsConnectionsManager)
    {
        return agentsConnectionsManager.GetAgentConnection(_cluster!.AgentId);
    }

}
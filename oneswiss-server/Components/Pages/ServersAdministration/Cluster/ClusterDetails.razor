@if (AgentIsConnected)
{
    <MudTabs PanelClass="mt-3">
        <MudTabPanel Text="Данные OneSwiss">
            <ClusterEdit Id="@Id"/>
        </MudTabPanel>
        <MudTabPanel Text="Данные кластера">
            <V8ClusterEdit Id="@Id"></V8ClusterEdit>
        </MudTabPanel>
    </MudTabs>
}
else
{
    <ClusterEdit Id="@Id"/>
}

@code {
    [Parameter]
    public Guid Id { get; set; }
    
    [Parameter]
    public bool AgentIsConnected { get; set; }
}
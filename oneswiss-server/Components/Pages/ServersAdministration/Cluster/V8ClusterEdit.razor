@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@using OneSwiss.V8.Platform.RemoteAdministration
<AuthorizeView>
    @{
        var readOnly = context.IsReadOnly(Roles.WriteClusterItemsInfo);

        <ClusterObjectDetails
            @ref="_details"
            T="V8ClusterDetails"
            GetAgentConnectionCallback="GetAgentConnectionCallback"
            SaveAble="!readOnly"
            OnSave="OnSave"
            BeforeLoadModel="BeforeLoadModel"
            OnLoadModel="OnLoadModel">
            <MudStack Row Class="mb-3" Breakpoint="Breakpoint.SmAndDown" StretchItems="StretchItems.All">
                <MudCard>
                    <MudCardHeader>
                        <MudText>Основное</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack>
                            <MudTextField For="@(() => _details.Model!.Name)" ReadOnly="readOnly"
                                          Variant="Variant.Outlined" Label="Наименование"
                                          @bind-Value="@_details.Model.Name"/>
                            <ItemSelector
                                @bind-Value="@_details.Model!.SecurityLevel"
                                Items="Enum.GetValues<V8SecurityLevel>().ToList()"
                                Class="mb-3"
                                ItemValueSelector="arg => arg"
                                ItemNameSelector="arg => arg.GetDisplay()"
                                Label="Защищенное соединение"
                                ReadOnly="readOnly"
                                Variant="Variant.Outlined"
                                For="@(() => _details.Model.SecurityLevel)"/>
                            <MudSwitch For="@(() => _details.Model.AllowAccessRightAuditEventsRecording)"
                                       ReadOnly="readOnly" Color="Color.Primary"
                                       Label="Разрешать запись событий аудита прав доступа"
                                       @bind-Value="@_details.Model.AllowAccessRightAuditEventsRecording"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
                <MudCard>
                    <MudCardHeader>
                        <MudText>Перезапускать рабочие процессы</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack>
                            <MudTextField For="@(() => _details.Model.RestartSchedule)" ReadOnly="readOnly"
                                          Variant="Variant.Outlined" Label="Расписание перезапуска"
                                          @bind-Value="@_details.Model.RestartSchedule"/>
                            <MudSwitch For="@(() => _details.Model.KillProblemProcesses)" ReadOnly="readOnly"
                                       Color="Color.Primary" Label="Принудительно завершать проблемные процессы"
                                       @bind-Value="@_details.Model.KillProblemProcesses"/>
                            <MudSwitch For="@(() => _details.Model.KillByMemoryWithDump)" ReadOnly="readOnly"
                                       Color="Color.Primary"
                                       Label="Записывать дамп процесса при превышении критического объема памяти"
                                       @bind-Value="@_details.Model.KillByMemoryWithDump"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudStack>
            <MudStack Class="mb-3" Row Breakpoint="Breakpoint.SmAndDown" StretchItems="StretchItems.All">
                <MudCard>
                    <MudCardHeader>
                        <MudText>Параметры процессов</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack>
                            <MudNumericField For="@(() => _details.Model.ExpirationTimeout)" ReadOnly="readOnly"
                                             Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                             Label="Проблемные процессы завершать через"
                                             @bind-Value="@_details.Model.ExpirationTimeout"/>
                            <MudNumericField For="@(() => _details.Model.SessionFaultToleranceLevel)"
                                             ReadOnly="readOnly" Variant="Variant.Outlined"
                                             Label="Уровень отказоустойчивости"
                                             @bind-Value="@_details.Model.SessionFaultToleranceLevel"/>
                            <ItemSelector
                                @bind-Value="@_details.Model!.LoadBalancingMode"
                                Items="Enum.GetValues<V8ClusterLoadBalancingMode>().ToList()"
                                Class="mb-3"
                                ItemValueSelector="arg => arg"
                                ItemNameSelector="arg => arg.GetDisplay()"
                                Label="Режим распределения нагрузки"
                                ReadOnly="readOnly"
                                Variant="Variant.Outlined"
                                For="@(() => _details.Model.LoadBalancingMode)"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
                <MudCard>
                    <MudCardHeader>
                        <MudText>Отслеживание разрыва соединений</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack>
                            <MudNumericField For="@(() => _details.Model.PingPeriod)" ReadOnly="readOnly"
                                             Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                             Label="Период проверки" @bind-Value="@_details.Model.PingPeriod"/>
                            <MudNumericField For="@(() => _details.Model.PingTimeout)" ReadOnly="readOnly"
                                             Adornment="Adornment.End" AdornmentText="сек." Variant="Variant.Outlined"
                                             Label="Таймаут проверки" @bind-Value="@_details.Model.PingTimeout"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </ClusterObjectDetails>
    }
</AuthorizeView>

@code {
    private Cluster _item = null!;
    private ClusterObjectDetails<V8ClusterDetails> _details = null!;

    [Parameter] public Guid Id { get; set; }

    private async Task BeforeLoadModel(IDbContextFactory<AppDbContext> contextFactory)
    {
        await using var context = await contextFactory.CreateDbContextAsync();

        _item = (await context.Clusters
            .AsNoTracking()
            .Include(c => c.Credentials)
            .FirstOrDefaultAsync(c => c.Id == Id))!;
    }

    private async Task<V8ClusterDetails> OnLoadModel(AgentConnection connection)
    {
        return await connection.GetV8ClusterDetails(_item, CancellationToken.None);
    }

    private async Task OnSave(AgentConnection connection, Dictionary<string, string> changedProperties)
    {
        await connection.ChangeClusterParameters(_item, changedProperties, CancellationToken.None);
    }

    private AgentConnection? GetAgentConnectionCallback(AgentsConnectionsManager agentsConnectionsManager)
    {
        return agentsConnectionsManager.GetAgentConnection(_item!.AgentId);
    }

}
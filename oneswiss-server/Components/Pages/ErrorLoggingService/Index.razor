@page "/errorloggingservice"
@using global::AutoMapper
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject IMapper Mapper
@inject NavigationManager NavManager
@rendermode InteractiveServer

@attribute [ExtAuthorize(Roles.ReadErrorLoggingReports)]

<PageTitle>Журнал сервиса регистрации ошибок</PageTitle>

<h1 Class="mb-3">Журнал сервиса регистрации ошибок</h1>


<MudDataGrid T="ErrorReportViewModel" Items="_items" Dense="true" Hover="true" Filterable="true"
             FilterMode="DataGridFilterMode.Simple" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Title="Дата" Property="arg => arg.Date"/>
        <PropertyColumn Title="Конфигурация" Property="arg => arg.Configuration"/>
        <PropertyColumn Title="Платформа" Property="arg => arg.PlatformVersion"/>
        <PropertyColumn Title="Пользователь" Property="arg => arg.UserName"/>
        <PropertyColumn Title="Доп. инфо" Property="arg => arg.AdditionalInfo"/>
        <TemplateColumn>
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" OnClick="@(() => NavigateToItem(context.Item!))"
                               Color="Color.Info"/>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code
{
    private IEnumerable<ErrorReportViewModel> _items;

    protected override async Task OnInitializedAsync()
    {
        await UpdateItems();
    }

    private async Task UpdateItems()
    {
        var context = await ContextFactory.CreateDbContextAsync();

        var items = await context.ErrorReports.AsNoTracking().OrderByDescending(c => c.CreatedAt).ToListAsync();
        _items = Mapper.Map<List<ErrorReportViewModel>>(items);
    }

    private void NavigateToItem(ErrorReportViewModel vm)
    {
        NavManager.NavigateTo($"/errorloggingservice/{vm.Id}");
    }
}
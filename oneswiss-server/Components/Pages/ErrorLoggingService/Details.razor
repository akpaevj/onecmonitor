@page "/errorloggingservice/{id:guid}"
@using System.Text
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Dto.ErrorLoggingService
@using OneSwiss.Server.Helpers
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> ContextFactory

<PageTitle>Отчет об ошибке</PageTitle>

<h1 Class="mb-3">Отчет об ошибке</h1>

<MudStack Row AlignItems="AlignItems.Start" Class="mb-3">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => NavManager.NavigateTo($"errorloggingservice"))" Class="mb-3">Назад</MudButton>
</MudStack>

<MudStack AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
    <MudCard>
        <MudCardHeader>
            <MudText>Ошибка</MudText>
        </MudCardHeader>
        <MudCardContent>
            @{
                var error = _model!.ErrorInfo.ApplicationErrorInfo.Errors[0];
                    
                var stackBuilder = new StringBuilder();
                var prefix = "";

                foreach (var item in _model.ErrorInfo.ApplicationErrorInfo.Stack)
                {
                    stackBuilder.AppendLine($"{prefix}{item.Module} : {item.Line} : {item.Code.Trim()}");
                    prefix += "\t";
                }
                    
                <MudStack>
                    <MudText>@error.Text</MudText>
                    <MudStack Row>
                        @foreach (var category in error.Categories)
                        {
                            <MudChip Value="@category"></MudChip>
                        }
                    </MudStack>
                    <pre><code style="white-space: pre-wrap">@stackBuilder.ToString()</code></pre>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>
    <MudStack Row AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All" Breakpoint="Breakpoint.MdAndDown">
        <MudCard>
            <MudCardHeader>
                <MudText>Клиент</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable>
                    <tbody>
                    <tr>
                        <td>Приложение</td>
                        <td>@_model!.ClientInfo.AppName</td>
                    </tr>
                    <tr>
                        <td>Версия</td>
                        <td>@_model!.ClientInfo.AppVersion</td>
                    </tr>
                    <tr>
                        <td>ОС</td>
                        <td>@_model!.ClientInfo.SystemInfo.OsVersion</td>
                    </tr>
                    <tr>
                        <td>Память (свободная/всего)</td>
                        <td>@_model!.ClientInfo.SystemInfo.FreeRam / @_model!.ClientInfo.SystemInfo.FullRam</td>
                    </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
        <MudCard>
            <MudCardHeader>
                <MudText>Конфигурация</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable>
                    <tbody>
                    <tr>
                        <td>Имя</td>
                        <td>@_model!.ConfigInfo.Name</td>
                    </tr>
                    <tr>
                        <td>Версия</td>
                        <td>@_model!.ConfigInfo.Version</td>
                    </tr>
                    <tr>
                        <td>Режим совместимости</td>
                        <td>@_model!.ConfigInfo.CompatibilityMode</td>
                    </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    </MudStack>
    <MudStack Row AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All" Breakpoint="Breakpoint.MdAndDown">
        <MudCard>
            <MudCardHeader>
                <MudText>Сеанс</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable>
                    <tbody>
                    <tr>
                        <td>Имя пользователя</td>
                        <td>@_model!.SessionInfo.UserName</td>
                    </tr>
                    <tr>
                        <td>Разделители</td>
                        <td>@_model!.SessionInfo.DataSeparation</td>
                    </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
        @if (!string.IsNullOrEmpty(_model!.AdditionalInfo))
        {
            <MudCard>
                <MudCardHeader>
                    <MudText>Дополнительная информация</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>@_model.AdditionalInfo</MudText>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
    @if (!string.IsNullOrEmpty(_screenShot))
    {
        <MudCard>
            <MudCardHeader>
                <MudText>Скриншот</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudImage Src="@_screenShot" Alt="Скриншот экрана пользователя" Fluid="true" ObjectFit="ObjectFit.Fill"/>
            </MudCardContent>
        </MudCard>
    }
</MudStack>

@code
{
    [Parameter]
    public Guid Id { get; set; }

    private ReportRoot? _model;
    private string _screenShot = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        
        var report = await context.ErrorReports.FindAsync(Id);
        _model = JsonSerializer.Deserialize<ReportRoot>(report!.Report, ErrorReportsHelper.ReportSerializerOptions);

        if (_model!.Screenshot != null)
            _screenShot = $"data:image/png;base64,{Convert.ToBase64String(report.Screenshot)}";
    }
}

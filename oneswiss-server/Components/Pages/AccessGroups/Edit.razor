@page "/accessGroups/{id:guid}"
@page "/accessGroups/create"
@using FluentValidation
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services

@inject UserGroupsManager GroupsManager

@attribute [ExtAuthorize]

<EditDatabaseForm @ref="_editor" T="AccessGroup"
                    Id="Id"
                    Route="settings?tab=accessGroups"
                    Title="Новая группа доступа"
                    NameSelector="@(c => c.Name)"
                    ModelSelector="ModelSelector"
                    OnUpdate="OnUpdate"
                    AfterSave="AfterSave"
                    Validation="_validator.ValidateValue">
    <MudStack>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" Label="Наименование" @bind-Value="@_editor.Model!.Name"/>
        <ItemsSelector T="ApplicationRole"
                       @bind-SelectedValues="@_editor.Model!.Roles"
                       Items="@_editor.Context!.Roles.ToList()"
                       Title="Роли"
                       NameSelector="@(item => item.Description)"/>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<AccessGroup> _editor = null!;

    /// <summary>
    /// Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private static IQueryable<AccessGroup> ModelSelector(IQueryable<AccessGroup> arg)
        => arg.Include(c => c.Roles);
    
    private void OnUpdate(AccessGroup model)
    {
        ModelHelper.UpdateModelItems(_editor.Model!.Roles, model.Roles);
    }

    private async Task AfterSave()
    {
        await GroupsManager.UpdateUsersRoles();
    }
    
    class Validator : ModelValidator<AccessGroup>
    {
        public Validator()
        {
            RuleFor(c => c.Name)
                .NotEmpty()
                .WithMessage("Не заполнено наименование");
        }
    }
}

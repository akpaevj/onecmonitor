@page "/accessGroups"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components.Shared

@attribute [ExtAuthorize]

<DatabaseObjectsTable TModel="AccessGroup" TViewModel="AccessGroup"
                      NameSelector="@(task => task.Name)"
                      Route="accessGroups"
                      Title="Группы доступа"
                      ShowTitle="false"
                      ShowRowActionsPredicate="group => !group.IsBuiltIn">
    <ColumnsContent>
        <MudTh>Имя</MudTh>
    </ColumnsContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
    </RowTemplate>
</DatabaseObjectsTable>
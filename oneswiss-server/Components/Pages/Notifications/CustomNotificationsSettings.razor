@using FluentValidation
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Components.Layout
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Helpers
@inject ISnackbar SnackBar
@inject IDbContextFactory<AppDbContext> ContextFactory
@implements IDisposable

<MudText Typo="Typo.h6" Class="mb-3">Пользовательские уведомления</MudText>

<MudStack>
    <MudTable T="CustomNotification" 
              Items="@_items" 
              @bind-SelectedItems="_selectedItems" 
              MultiSelection="true"
              SelectOnRowClick="false"
              Dense="true">
        <ToolBarContent>
            <MudStack Row Spacing="3">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddItem">Добавить</MudButton>
                @if (_selectedItems.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="DeleteItem">Удалить</MudButton>
                }
            </MudStack>
        </ToolBarContent>
        <HeaderContent>
            <MudTd>Ключ</MudTd>
            <MudTd>Описание</MudTd>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ключ">
                <MudTextField For="@(() => context.Key)" @bind-Value="@context.Key"></MudTextField>
            </MudTd>
            <MudTd DataLabel="Описание">
                <MudTextField For="@(() => context.Description)" @bind-Value="@context.Description"></MudTextField>
            </MudTd>
        </RowTemplate>
    </MudTable>
    
    <MudStack Breakpoint="Breakpoint.SmAndDown" AlignItems="AlignItems.End">
        <MudSpacer/>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="Save">Сохранить</MudButton>
    </MudStack>
    
</MudStack>

@code
{
    private AppDbContext? _context;
    private List<CustomNotification> _items = [];
    private HashSet<CustomNotification> _selectedItems = [];

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.CreateDbContextAsync();
        await UpdateItems();
    }

    private async Task Save()
    {
        if (Validate())
        {
            ModelHelper.UpdateDbSet(_items, _context!);
            
            await _context!.SaveChangesAsync();
            SnackBar.ShowSuccess("Объект записан");
        }
        else
            SnackBar.ShowError("Объект не записан");
    }

    private void AddItem()
    {
        _items.Add(new CustomNotification
        {
            Id = Guid.NewGuid()
        });
    }

    private async Task UpdateItems()
    {
        _items = await _context!.CustomNotifications.ToListAsync();
    }

    private void DeleteItem()
    {
        foreach (var selectedItem in _selectedItems)
            _items.Remove(selectedItem);
    }

    private bool Validate()
    {
        var valid = true;
        
        for (var index = 0; index < _items.Count; index++)
        {
            var item = _items[index];

            if (string.IsNullOrEmpty(item.Key))
            {
                valid = false;
                SnackBar.ShowError($"В строке {index + 1} не указан ключ уведомления");
            }
            else if (item.Key.Length > 30)
            {
                valid = false;
                SnackBar.ShowError($"Ключ не может содержать больше 30 символов (строка {index + 1})");
            }
        }

        return valid;
    }

    public void Dispose()
    {
        _context?.Dispose();
    }
}

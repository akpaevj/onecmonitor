@using System.Text.RegularExpressions
@using FluentValidation
@using global::AutoMapper
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.DTO
@using OneSwiss.Common.Storage
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@inject AgentsConnectionsManager AgentsConnectionsManager 
@inject IMapper Mapper
@inject ISnackbar SnackBar

@attribute [ExtAuthorize]

<MudText Typo="Typo.h6" Class="mb-3">Сервис экспорта журнала регистрации</MudText>

<SettingsForm @ref="_editor" T="Models.EventLogSettings"
                    Validation="@_validator.ValidateValue"
                    AfterSave="AfterSave"
                    OnInitialize="OnInitialize">
    <MudStack>
        <MudSwitch Class="mb-3" Label="Включен" @bind-Value="@_editor.Model!.Enabled" Color="Color.Primary"></MudSwitch>
        <MudSelect Class="mb-3" For="@(() => _editor.Model!.DbmsId)" Label="СУБД" @bind-Value="@_editor.Model!.DbmsId" Clearable="true">
            @foreach (var item in _editor.Context!.Dbms.AsNoTracking().ToList())
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.DatabaseName)" Label="Имя базы данных" @bind-Value="@_editor.Model!.DatabaseName"></MudTextField>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Table)" Label="Имя таблицы" @bind-Value="@_editor.Model!.Table"></MudTextField>
        <MudSelect Class="mb-3" For="@(() => _editor.Model!.CredentialsId)" Label="Учетные данные" @bind-Value="@_editor.Model!.CredentialsId" Clearable="true">
            @foreach (var item in _credentials)
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.InfoBaseNameRegex)" Label="Шаблон регулярного выражения для имени ИБ" @bind-Value="@_editor.Model!.InfoBaseNameRegex"></MudTextField>
    </MudStack>
</SettingsForm>

@code
{
    private CancellationTokenSource? _cts;
    private SettingsForm<Models.EventLogSettings> _editor = null!;
    private readonly Validator _validator = new();

    private List<Credentials> _credentials;
    
    private async Task OnInitialize((Models.EventLogSettings Model, AppDbContext Context) obj)
    {
        _cts = new CancellationTokenSource();
        _credentials = await obj.Context.Credentials.ToListAsync();
    }
    
    private async Task AfterSave(Models.EventLogSettings obj)
    {
        if (!obj.Enabled)
            return;

        try
        {
            await InitDataBase();
            
            SnackBar.ShowSuccess("База данных инициализирована");
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
            return;
        }

        try
        {
            await AgentsConnectionsManager.RaiseUpdateSettings(_cts!.Token);
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
        }
    }
    
    private async Task InitDataBase()
    {
        var settings = await _editor.Context!.EventLogSettings
            .AsNoTracking()
            .Include(c => c.Dbms)
            .Include(c => c.Credentials)
            .FirstOrDefaultAsync(_cts!.Token);

        var settingsDto = Mapper.Map<EventLogSettingsDto>(settings);
        
        using var context = new ClickHouseContext(
            settingsDto.Dbms, 
            settingsDto.Credentials, 
            settingsDto.DatabaseName, 
            settingsDto.Table);
        
        await context.InitEventLogTable(_cts!.Token);
    }

    public void Dispose()
    {
        _cts?.Dispose();
    }
    
    private class Validator : ModelValidator<Models.EventLogSettings>
    {
        public Validator()
        {
            When(c => c.Enabled, () =>
            {
                RuleFor(x => x.DatabaseName)
                    .NotEmpty()
                    .WithMessage("Не указано имя базы данных");
                
                RuleFor(x => x.Table)
                    .NotEmpty()
                    .WithMessage("Не указана таблица базы данных");
                
                RuleFor(x => x.DbmsId)
                    .NotEmpty()
                    .WithMessage("Не указана СУБД");
                
                RuleFor(x => x.CredentialsId)
                    .NotEmpty()
                    .WithMessage("Не указаны учетные данные");
                
                RuleFor(x => x.InfoBaseNameRegex)
                    .NotEmpty()
                    .WithMessage("Не указано регулярное выражение для имени информационной базы")
                    .Must(IsValidRegex)
                    .WithMessage("Указано невалидное регулярное выражение");
            });
        }
        
        private static bool IsValidRegex(string pattern)
        {
            if (string.IsNullOrWhiteSpace(pattern)) return false;

            try
            {
                // ReSharper disable once ReturnValueOfPureMethodIsNotUsed
                Regex.Match("", pattern);
            }
            catch (ArgumentException)
            {
                return false;
            }

            return true;
        }
    }
}

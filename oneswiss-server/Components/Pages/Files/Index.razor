@page "/files"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@using OneSwiss.Server.Components.Shared
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FilesProvider FilesProvider
@rendermode InteractiveServer

@attribute [ExtAuthorize(BuiltInRoles.ReadMaintenanceTasks, BuiltInRoles.WriteMaintenanceTasks)]

<DatabaseObjectsTable TModel="File" TViewModel="File"
                      Title="Файлы"
                      Dense="true"
                      Route="files"
                      GroupBy="@_groupDefinition"
                      NameSelector="@(item => item.ToString())"
                      GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                      GroupFooterClass="mb-4"
                      AfterDelete="AfterDelete">
    <GroupHeader>
        <MudTh Class="mud-table-cell-custom-group" colspan="3">@($"{context.Key}")</MudTh>
    </GroupHeader>
    <ColGroup>
        @if (_groupDefinition.Expandable)
        {
            <col style="width: 60px;" />
        }
        <col />
        <col />
    </ColGroup>
    <ColumnsContent>
        <MudTh>Имя</MudTh>
        <MudTh>Версия</MudTh>
    </ColumnsContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
        <MudTd DataLabel="Версия">@context.Version</MudTd>
    </RowTemplate>
</DatabaseObjectsTable>

@code
{
    private readonly TableGroupDefinition<File> _groupDefinition = new()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = false,
        Selector = e => e.FileType.GetDisplay()
    };

    private void AfterDelete(File obj)
    {
        try
        {
            FilesProvider.DeleteDataFile(obj.DataPath);
        }
        catch (Exception e)
        {
            Snackbar.ShowError(e);
        }
    }
}

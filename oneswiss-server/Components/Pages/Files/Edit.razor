@page "/files/{id:guid}"
@page "/files/create"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@inject NavigationManager NavigationManager
@inject ILogger<Edit> Logger
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject FilesProvider FilesProvider
@implements IDisposable

<PageTitle>@_title</PageTitle>

<h1 Class="mb-3">@_title</h1>

<EditForm Model="Model!" OnSubmit="OnSubmit">
    <DataAnnotationsValidator/>

    <MudButton Disabled="isLoading" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary" Class="mb-3">Сохранить</MudButton>

    <MudStack>
        <MudTextField Class="mb-3" For="@(() => Model!.Name)" @bind-Value="@Model!.Name"></MudTextField>
        <MudTextField Class="mb-3" For="@(() => Model!.Version)" @bind-Value="@Model!.Version"></MudTextField>
        @if (Id == Guid.Empty)
        {
            <MudFileUpload T="IBrowserFile" @bind-Files="_file" OnFilesChanged="OnFileChanged" Disabled="isLoading">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        @{
                            if (_file == null)
                            {
                                <MudText>Загрузить файл</MudText>
                            }
                            else if (isLoading)
                            {
                                <MudProgressCircular Value="@_loaded">
                                    <ChildContent>
                                        @_loaded
                                    </ChildContent>
                                </MudProgressCircular>
                            }
                            else
                            {
                                <MudText>@($"{_file.Name} ({_file.Size / (1024 * 1024)} mb)")</MudText>
                            }
                        }
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }
    </MudStack>

</EditForm>

@code
{
    private AppDbContext? _context;
    private ValidationMessageStore? _messageStore;
    
    private string _title = "Новый файл";
    IBrowserFile? _file;
    
    private int _loaded = 0;
    private bool isLoading = false;
    
    [Parameter]
    public Guid Id { get; set; }
    
    [SupplyParameterFromForm]
    private File? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.CreateDbContextAsync();
        
        if (Id != Guid.Empty)
        {
            Model = await _context!.Files.FindAsync(Id);

            if (Model == null)
                NavigateBack();
        }
        else
            Model = new File();

        if (Id != Guid.Empty)
            _title = Model!.Name;
    }
    
    private async Task OnSubmit(EditContext editContext)
    {
        _messageStore ??= new ValidationMessageStore(editContext);
        _messageStore.Clear();
        
        var isValid = true;
        
        if (string.IsNullOrEmpty(Model.Name))
        {
            _messageStore.Add(
                () => Model!.Name,
                "Укажите наименование"
            );
            isValid = false;
        }
        if (string.IsNullOrEmpty(Model.Version))
        {
            _messageStore.Add(
                () => Model!.Version,
                "Укажите версию"
            );
            isValid = false;
        }
        if (_file == null)
        {
            _messageStore.Add(
                () => Model!.DataPath,
                "Прикрепите файл"
            );
            isValid = false;
        }
        
        editContext.NotifyValidationStateChanged();

        var isNew = Id == Guid.Empty;
        
        if (Id == Guid.Empty)
        {
            Model.Id = Guid.NewGuid();
            
            // save file
            var extension = Path.GetExtension(_file!.Name);
            
            if (extension.Equals(".CF", StringComparison.InvariantCultureIgnoreCase))
                Model.FileType = FileType.Cf;
            else if (extension.Equals(".CFE", StringComparison.InvariantCultureIgnoreCase))
                Model.FileType = FileType.Cfe;
            else if (extension.Equals(".CFU", StringComparison.InvariantCultureIgnoreCase))
                Model.FileType = FileType.Cfu;
            else if (extension.Equals(".EPF", StringComparison.InvariantCultureIgnoreCase))
                Model.FileType = FileType.Epf;
            else if (extension.Equals(".OSPX", StringComparison.InvariantCultureIgnoreCase))
                Model.FileType = FileType.Ospx;
            else
            {
                _messageStore.Add(
                    () => Model!.DataPath,
                    "Прикрепите файл"
                );
                isValid = false;
            }
            
            if (!isValid)
                return;
            
            var fileName = $"{Model.Id}{extension}";
            await using var stream = FilesProvider.OpenDataStream(fileName);
            
            await using var uploadStream = _file.OpenReadStream(long.MaxValue);

            var copied = 0L;
            var all = uploadStream.Length;

            var buffer = new byte[86400];

            isLoading = true;
            
            while (copied < all)
            {
                var read = await uploadStream.ReadAsync(buffer, 0, buffer.Length);
                copied += read;

                await stream.WriteAsync(buffer, 0, read);

                _loaded = (int)(copied / (double)all * 100.0);
                StateHasChanged();
            }

            isLoading = false;
                
            Model.DataPath = fileName;
        }
        
        try
        {
            if (isNew)
                _context!.Files.Add(Model!);
            else
                _context!.Entry(Model!).CurrentValues.SetValues(Model!);

            await _context!.SaveChangesAsync();
            NavigateBack();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при сохранении");
        }
    }
    
    private void NavigateBack()
        => NavigationManager.NavigateTo("/files");

    private void OnFileChanged(InputFileChangeEventArgs obj)
    {
        Model!.Name = Path.GetFileNameWithoutExtension(obj.File.Name);
    }

    public void Dispose()
    {
        _context?.Dispose();
    }
}

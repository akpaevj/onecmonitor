@page "/dbms/{id:guid}"
@page "/dbms/create"
@using FluentValidation
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Common.Models
@using OneSwiss.Server.Models

<EditDatabaseForm @ref="_editor" T="Dbms"
                    Id="Id"
                    NameSelector="@(arg => arg.Name)"
                    Route="dbms"
                    Title="Новая СУБД"
                    Validation="_validator.ValidateValue">
    <MudStack>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" Label="Наименование" @bind-Value="@_editor.Model!.Name"/>
        <MudSelect Class="mb-3" For="@(() => _editor.Model!.Type)" Label="Тип" T="DbmsType" 
                   @bind-Value="@_editor.Model!.Type"
                   @bind-Value:after="TypeChanged"/>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Host)" Label="Хост" @bind-Value="@_editor.Model!.Host"/>
        <MudNumericField Label="Порт" For="@(() => _editor.Model!.Port)" @bind-Value="@_editor.Model!.Port"/>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<Dbms> _editor = null!;
    
    [Parameter]
    public Guid Id { get; set; }
    
    class Validator : ModelValidator<Dbms>
    {
        public Validator()
        {
            RuleFor(c => c.Name)
                .NotEmpty()
                .WithMessage("Не заполнено наименование");
            
            RuleFor(c => c.Host)
                .NotEmpty()
                .WithMessage("Не заполнен адрес сервера");
            
            RuleFor(c => c.Port)
                .NotEmpty()
                .WithMessage("Не заполнен порт сервера");
        }
    }

    private void TypeChanged()
    {
        if (_editor.Model.Type == DbmsType.ClickHouse)
            _editor.Model.Port = 8123;
    }
}

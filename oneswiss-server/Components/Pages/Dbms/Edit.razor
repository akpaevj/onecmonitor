@page "/dbms/{id:guid}"
@page "/dbms/create"
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Common.Models
@using OneSwiss.Server.Models

<EditDatabaseObject @ref="_editor" T="Dbms"
                    Id="Id"
                    NameSelector="@(arg => arg.Name)"
                    Route="dbms">
    <FormContent>
        <MudStack>
            <MudTextField Class="mb-3" Label="Наименование" @bind-Value="@_editor.Model!.Name"></MudTextField>
            <MudSelect Class="mb-3" Label="Тип" T="DbmsType" @bind-Value="@_editor.Model!.Type"></MudSelect>
            <MudTextField Class="mb-3" Label="Хост" @bind-Value="@_editor.Model!.Host"></MudTextField>
            <MudNumericField Label="Порт" @bind-Value="@_editor.Model!.Port"></MudNumericField>
        </MudStack>
    </FormContent>
</EditDatabaseObject>

@code
{
    private EditDatabaseObject<Dbms> _editor = null!;
    
    [Parameter]
    public Guid Id { get; set; }
}

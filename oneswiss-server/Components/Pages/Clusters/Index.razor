@page "/clusters"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Models
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@rendermode InteractiveServer

<PageTitle>Кластеры и информационные базы</PageTitle>

<style>
    .selected {
        background-color: rgba(66, 30, 229, 0.22) !important;
    }
    .selected > td {
        color: white !important;
    }
    .selected > td .mud-input {
        color: white !important;
    }
</style>

<MudGrid>
    <MudItem xs="6">
        <MudTable T="Cluster" Items="_clusters" Hover="true" Breakpoint="Breakpoint.Sm"
                  RowClass="cursor-pointer" @bind-SelectedItem="@SelectedCluster" RowClassFunc="@SelectedRowClassFunc">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Кластеры</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Имя</MudTh>
                <MudTh>Агент</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Имя">@context.Name</MudTd>
                <MudTd DataLabel="Агент">@context.Agent.InstanceName</MudTd>
                <MudTd>
                    <MudStack Row>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => NavManager.NavigateTo($"clusters/{context.Id}"))" Color="Color.Info"/>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
    <MudItem xs="6">
        <MudTable T="InfoBase" Items="_infoBases" Hover="true" Breakpoint="Breakpoint.Sm">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Информационные базы</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Имя</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Имя">@context.Name</MudTd>
                <MudTd>
                    <MudStack Row>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => NavManager.NavigateTo($"infobases/{context.Id}"))" Color="Color.Info"/>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code
{
    private Cluster? _selectedCluster;
    private Cluster? SelectedCluster
    {
        get => _selectedCluster;
        set
        {
            _selectedCluster = value;
            OnSelectCluster(_selectedCluster);
        }
    }
    List<Cluster> _clusters = [];
    List<InfoBase> _infoBases = [];

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        _clusters = await context.Clusters.Include(c => c.Agent).ToListAsync();
    }

    private string SelectedRowClassFunc(Cluster item, int rowNumber)
        => SelectedCluster?.Id == item.Id ? "selected" : string.Empty;

    void OnSelectCluster(Cluster item)
    {
        using var context = ContextFactory.CreateDbContext();
        _infoBases = context.InfoBases.Where(c => c.ClusterId == item.Id).ToList();
        
        StateHasChanged();
    }
}

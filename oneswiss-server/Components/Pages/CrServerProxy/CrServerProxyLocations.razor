@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Common.Models
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Layout
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Services.CrServerProxy

@inject ISnackbar SnackBar
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject CrServerRequestsHandler RequestsHandler

@implements IDisposable

@attribute [ExtAuthorize]

<MudText Typo="Typo.h6" Class="mb-3">Публикации</MudText>

<MudStack>
    <MudTable T="CrServerProxyLocation"
              Items="@_items"
              @bind-SelectedItems="_selectedItems"
              MultiSelection="true"
              SelectOnRowClick="false"
              Dense="true">
        <ToolBarContent>
            <MudStack Row Spacing="3">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddNewItem">
                    Добавить
                </MudButton>
                @if (_selectedItems.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                               OnClick="DeleteItems">Удалить
                    </MudButton>
                }
            </MudStack>
        </ToolBarContent>
        <HeaderContent>
            <MudTd>Хранилище</MudTd>
            <MudTd>Адрес</MudTd>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Хранилище">
                <ItemSelector
                    @bind-Value="@context.ConfigurationRepositoryId"
                    Items="@_context!.ConfigRepositories.ToList()"
                    Class="mb-3"
                    ItemValueSelector="arg => arg.Id"
                    ItemNameSelector="@(arg => arg.Name)"
                    For="@(() => context.ConfigurationRepositoryId)"/>
            </MudTd>
            <MudTd DataLabel="Адрес">
                <MudTextField Class="mb-3" For="@(() => context.Location)"
                              @bind-Value="@context.Location"/>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudStack Breakpoint="Breakpoint.SmAndDown" AlignItems="AlignItems.End">
        <MudSpacer/>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="Save">Сохранить
        </MudButton>
    </MudStack>

</MudStack>

@code
{
    private AppDbContext? _context;
    private List<CrServerProxyLocation> _items = [];
    private HashSet<CrServerProxyLocation> _selectedItems = [];
    
    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.CreateDbContextAsync();
        await UpdateItems();
    }

    private async Task Save()
    {
        if (Validate())
        {
            ModelHelper.UpdateDbSet(_items, _context!);

            await _context!.SaveChangesAsync();
            SnackBar.ShowSuccess("Объект записан");
            
            RequestsHandler.UpdateLocations();
        }
        else
            SnackBar.ShowError("Объект не записан");
    }

    private void AddNewItem()
    {
        _items.Add(new CrServerProxyLocation
        {
            Id = Guid.NewGuid()
        });
    }

    private async Task UpdateItems()
    {
        _items = await _context!.CrServerProxyLocations.ToListAsync();
    }

    private void DeleteItems()
    {
        foreach (var selectedItem in _selectedItems)
            _items.Remove(selectedItem);
    }

    private bool Validate()
    {
        var valid = true;

        for (var index = 0; index < _items.Count; index++)
        {
            var item = _items[index];

            if (item.ConfigurationRepositoryId == Guid.Empty)
            {
                valid = false;
                SnackBar.ShowError($"В строке {index + 1} не указано хранилище");
            }
            
            if (string.IsNullOrEmpty(item.Location))
            {
                valid = false;
                SnackBar.ShowError($"В строке {index + 1} не указан адрес");
            }
            else if (!Uri.TryCreate(new Uri("http://localhost"), item.Location, out _))
            {
                valid = false;
                SnackBar.ShowError($"В строке {index + 1} адрес не является валидным относительным путем");
            }
        }

        return valid;
    }

    public void Dispose()
    {
        _context?.Dispose();
    }
}

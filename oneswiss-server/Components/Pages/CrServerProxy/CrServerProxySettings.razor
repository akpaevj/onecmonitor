@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Services.CrServerProxy

@inject CrServerRequestsHandler RequestsHandler

@attribute [ExtAuthorize]

<SettingsForm @ref="_editor" T="Models.CrServerProxySettings" AfterSave="AfterSave">
    <MudStack>
        <MudSwitch Label="Включен" For="@(() => _editor.Model!.Enabled)" @bind-Value="@_editor.Model!.Enabled" Color="Color.Primary"/>
    </MudStack>
</SettingsForm>

@code
{
    private SettingsForm<Models.CrServerProxySettings> _editor = null!;

    private void AfterSave()
    {
        RequestsHandler.UpdateSettings();
    }
}

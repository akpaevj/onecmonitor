@page "/configurationrepositories/{id:guid}"
@using FluentValidation
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models

@attribute [ExtAuthorize(Roles.ReadMaintenanceTasks, Roles.WriteMaintenanceTasks)]

<EditDatabaseForm @ref="_editor" T="ConfigurationRepository"
                  Id="Id"
                  Route="configurationrepositories"
                  Title="Новое хранилище конфигураций"
                  NameSelector="@(c => c.Name)"
                  Validation="_validator.ValidateValue"
                  ModelSelector="ModelSelector">
    <MudStack>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" ReadOnly="true" Label="Наименование"
                      @bind-Value="@_editor.Model!.Name"/>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Host)" ReadOnly="true" Label="Хост"
                      @bind-Value="@_editor.Model!.Host"/>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Port)" ReadOnly="true" Label="Порт"
                      @bind-Value="@_editor.Model!.Port"/>
        <ItemSelector
            @bind-Value="@_editor.Model!.CredentialsId"
            Items="@_editor.Context!.Credentials.Where(c => !c.IsToken).ToList()"
            Class="mb-3"
            ItemValueSelector="arg => arg.Id"
            ItemNameSelector="arg => arg.Name"
            Label="Учетные данные"
            For="@(() => _editor.Model!.CredentialsId)"/>
        <MudTable T="ConfigurationRepositoryUser" Items="@_editor.Model!.Users" Dense="true">
            <ToolBarContent>
                <MudText>Пользователи</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Имя</MudTh>
                <MudTh>Пользователь Git</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Имя">@context.Name</MudTd>
                <MudTd DataLabel="Пользователь Git">@context.GitUser</MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd DataLabel="Имя">
                    <MudText>@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Пользователь Git">
                    <MudTextField For="@(() => context.GitUser)" @bind-Value="context.GitUser"/>
                </MudTd>
            </RowEditingTemplate>
        </MudTable>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<ConfigurationRepository> _editor = null!;

    [Parameter] public Guid Id { get; set; }

    private static IQueryable<ConfigurationRepository> ModelSelector(IQueryable<ConfigurationRepository> arg)
    {
        return arg.Include(c => c.Users);
    }

    class Validator : ModelValidator<ConfigurationRepository>
    {
        public Validator()
        {
            RuleFor(c => c.CredentialsId)
                .NotEmpty()
                .WithMessage("Не указаны учетные данные");
        }
    }
}

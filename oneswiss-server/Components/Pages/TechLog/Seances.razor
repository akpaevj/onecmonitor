@page "/techlog/seances"
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@using Microsoft.AspNetCore.Components.Authorization
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Extensions
@inject NavigationManager NavManager
@inject AgentsConnectionsManager AgentsConnectionsManager
@rendermode InteractiveServer

@attribute [ExtAuthorize(BuiltInRoles.ReadTechLogSeances, BuiltInRoles.WriteTechLogSeances)]

<AuthorizeView Context="authState">
    <DatabaseObjectsTable @ref="_table" TModel="TechLogSeance" TViewModel="TechLogSeance"
                          NameSelector="arg => arg.Description"
                          Route="techlog/seances"
                          Title="Сеансы сбора технологического журнала"
                          AfterDelete="AfterDelete">
        <ColumnsContent>
            <MudTh>Описание</MudTh>
            <MudTh>Режим запуска</MudTh>
            <MudTh>Начало</MudTh>
            <MudTh>Длительность</MudTh>
            <MudTh></MudTh>
        </ColumnsContent>
        <RowTemplate>
            <MudTd DataLabel="Описание">@context.Description</MudTd>
            <MudTd DataLabel="Режим запуска">@context.StartMode.GetDisplay()</MudTd>
            @if (context.StartMode == TechLogSeanceStartMode.Monitor)
            {
                <MudTd DataLabel="Время начала">@context.StartDateTime</MudTd>
                <MudTd DataLabel="Длительность"></MudTd>
            }
            else
            {
                <MudTd DataLabel="Время начала">@context.StartDateTime</MudTd>
                <MudTd DataLabel="Длительность">@context.Duration</MudTd>
            }
        </RowTemplate>
        <RowActionsContent>
            <MudTd>
                <MudStack Row>
                    <MudIconButton Icon="@Icons.Material.Filled.ListAlt" OnClick="@(() => NavManager.NavigateTo($"techlog/seances/{context.Id}/log"))" Color="Color.Warning"/>
                    @if (authState.IsInRoles(BuiltInRoles.WriteTechLogSeances))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => NavManager.NavigateTo($"techlog/seances/{context.Id}"))" Color="Color.Info"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => _table.DeleteItem(context))" Color="Color.Error"/>
                    }
                </MudStack>
            </MudTd>
        </RowActionsContent>
    </DatabaseObjectsTable>
</AuthorizeView>

@code {
    private DatabaseObjectsTable<TechLogSeance, TechLogSeance> _table = null!;

    private async Task AfterDelete(TechLogSeance obj)
    {
        await AgentsConnectionsManager.RaiseUpdateSettings(CancellationToken.None);
    }

}
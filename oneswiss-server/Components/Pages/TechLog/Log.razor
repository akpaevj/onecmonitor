@page "/techlog/seances/{id:guid}/log"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Models
@using OneSwiss.Common.Services
@using OneSwiss.Common.TechLog
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@inject TechLogRepositoryManager RepositoryManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject ISnackbar SnackBar
@implements IDisposable
@rendermode InteractiveServer

<style>
    .selected-tjevent {
        background-color: rgba(0, 0, 0, 0.15);
    }
</style>

<PageTitle>@_title</PageTitle>

<h1 Class="mb-3">@_title</h1>

<MudStack>
    <MudTextField @bind-Value="_filter" @bind-Value:after="AfterFilterChanged" Placeholder="Выражение WHERE" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0 mb-1"/>
    <MudStack Row StretchItems="StretchItems.All" AlignItems="AlignItems.Stretch">
        <MudTable @ref="_table" Style="width: 100%" T="TjEvent" RowClassFunc="RowClassFunc" @bind-SelectedItem="_selectedItem" ServerData="ServerData" TotalItems="_totalItems">
            <HeaderContent>
                <MudTh>Время</MudTh>
                <MudTh>Длительность</MudTh>
                <MudTh>Имя</MudTh>
                <MudTh>Уровень</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Время">@context.DateTime</MudTd>
                <MudTd DataLabel="Длительность">@context.Duration</MudTd>
                <MudTd DataLabel="Имя">@context.EventName</MudTd>
                <MudTd DataLabel="Уровень">@context.Level</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager/>
            </PagerContent>
        </MudTable>
        @if (_selectedItem != null)
        {
            <MudTable T="@(KeyValuePair<string, string>)" Style="width: 100%" Items="@_selectedItem?.Properties">
                <HeaderContent>
                    <MudTh>Свойство</MudTh>
                    <MudTh>Значение</MudTh>
                </HeaderContent>
                <RowTemplate Context="properties">
                    <MudTd DataLabel="Свойство">@properties.Key</MudTd>
                    <MudTd Style="overflow-wrap: anywhere" DataLabel="Значение">@properties.Value</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudStack>

@code {

    private CancellationTokenSource? _cts;
    private string _title = string.Empty;

    private int _totalItems = 0;
    private string _filter = string.Empty;
    private TjEvent? _selectedItem;

    private ITechLogRepository? _techLogRepository;
    private AppDbContext? _context;
    private TechLogSeance? _seance;
    private MudTable<TjEvent> _table;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        _techLogRepository = RepositoryManager.GetInstance();
        _context = await ContextFactory.CreateDbContextAsync();

        var seance = await _context!.TechLogSeances
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.Id == Id, _cts.Token);

        _title = seance!.Description;
    }

    private async Task<TableData<TjEvent>> ServerData(TableState state, CancellationToken cancellationToken)
    {
        _selectedItem = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var filter = _filter.Trim();
            filter = string.IsNullOrEmpty(filter) ? $"SeanceId = toUUID('{Id}')" : $"SeanceId = toUUID('{Id}') and {filter}";

            var items = await _techLogRepository!.GetTjEvents(state.PageSize, state.Page * state.PageSize, filter, cancellationToken);
        
            return new TableData<TjEvent>
            {
                Items = items,
                TotalItems = await _techLogRepository.GetTjEventsCount(filter, cancellationToken)
            };
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
            return new TableData<TjEvent>();
        }
    }

    public void Dispose()
    {
        _cts?.Dispose();
        _techLogRepository?.Dispose();
    }

    private string RowClassFunc(TjEvent arg1, int arg2)
    {
        return _selectedItem?.Id == arg1.Id ? "selected-tjevent" : string.Empty;
    }

    private async Task AfterFilterChanged()
    {
        await _table.ReloadServerData();
    }

}
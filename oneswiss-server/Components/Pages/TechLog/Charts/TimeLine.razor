@page "/techlog/seances/{id:guid}/log/timeline"
@using OneSwiss.Common.Services
@using OneSwiss.Common.TechLog
@inject TechLogRepositoryManager RepositoryManager
@rendermode InteractiveServer

<PageTitle>Временной ряд</PageTitle>

<h1 Class="mb-3">Временной ряд</h1>

<MudPaper Class="doc-section-component-container">
    <MudTimeSeriesChart ChartSeries="@_series"
                        Width="650px"
                        Height="350px"
                        ChartOptions="@_options"
                        CanHideSeries="true"
                        TimeLabelSpacing="TimeSpan.FromMinutes(5)"
                        TimeLabelSpacingRounding="true"
                        TimeLabelSpacingRoundingPadSeries="true"
                        DataMarkerTooltipTimeLabelFormat="yyyy MMM dd HH:mm:ss"/>
</MudPaper>

@code {
    private readonly List<TimeSeriesChartSeries> _series = [];
    private ITechLogRepository? _techLogRepository;
    private readonly ChartOptions _options = new();

    [SupplyParameterFromQuery] public string Property { get; set; }

    [SupplyParameterFromQuery] public string Filter { get; set; }

    protected override void OnInitialized()
    {
        _techLogRepository = RepositoryManager.GetInstance();
    }

}
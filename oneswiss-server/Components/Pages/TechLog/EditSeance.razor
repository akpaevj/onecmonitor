@page "/techlog/seances/{id:guid}"
@page "/techlog/seances/create"
@using System.Globalization
@using Blazor.Diagrams.Core.Models.Base
@using MudBlazor.Utilities
@using OneSwiss.Common.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Services
@inject AgentsConnectionsManager AgentsConnectionsManager 

<EditDatabaseObject @ref="_editor" T="TechLogSeance" Id="Id"
                    NameSelector="item => item.Description"
                    Route="techlog/seances"
                    Title="Новый сеанс сбора технологического журнала"
                    OnInitialize="OnInitialize"
                    OnSave="OnSave"
                    AfterSave="AfterSave">
    <FormContent>
        <MudStack>
            <MudTextField Class="mb-3" Label="Описание" @bind-Value="@_editor.Model!.Description"
                          Required="true" RequiredError="Не заполнено описание"/>
        </MudStack>
        <MudStack Row Class="mb-3" AlignItems="AlignItems.Center">
            <MudText>Режим:</MudText>
            <MudRadioGroup T="TechLogSeanceStartMode" 
                           @bind-Value="_editor.Model!.StartMode"
                           @bind-Value:after="SetAvailability">
                @foreach (var item in Enum.GetValues<TechLogSeanceStartMode>())
                {
                    <MudRadio Value="@item">@item.GetDisplay()</MudRadio>
                }
            </MudRadioGroup>
        </MudStack>
        <MudStack Row Class="mb-3">
            <MudDatePicker Label="Дата начала" @bind-Date="@_startDate" Disabled="_startDateTimeDisabled"
                           Validation="ValidateDate"></MudDatePicker>
            <MudTimePicker Label="Время начала" @bind-Time="@_startTime" Disabled="_startDateTimeDisabled"
                           Validation="ValidateTime"/>
            <MudNumericField Label="Длительность (мин.)" @bind-Value="_editor.Model!.Duration" Disabled="_durationDisabled"
                           Validation="ValidateDuration"/>
        </MudStack>
        <MudStack Row StretchItems="StretchItems.All">
            <ItemsSelector T="Agent"
                           @bind-SelectedValues="_agents"
                           NameSelector="item => item.InstanceName"
                           Items="@_editor.Context.Agents.ToList()"
                           Title="Агенты"/>
            <ItemsSelector T="LogTemplate"
                           @bind-SelectedValues="_templates"
                           NameSelector="item => item.Name"
                           Items="@_editor.Context.LogTemplates.ToList()"
                           Title="Шаблоны сбора"/>
        </MudStack>
    </FormContent>
</EditDatabaseObject>

@code
{
    private EditDatabaseObject<TechLogSeance> _editor = null!;
    private bool _startDateTimeDisabled;
    private bool _durationDisabled;

    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private IReadOnlyCollection<Agent> _agents = [];
    private IReadOnlyCollection<LogTemplate> _templates = [];
    
    [Parameter]
    public Guid Id { get; set; }

    private void OnInitialize(TechLogSeance obj)
    {
        _agents = obj.Agents;
        _templates = obj.Templates;
        
        if (obj.Id == Guid.Empty)
            obj.StartDateTime = DateTime.Now;

        _startDate = obj.StartDateTime;
        _startTime = obj.StartDateTime.TimeOfDay;
        
        SetAvailabilityInternal(obj);
    }

    private void OnSave(TechLogSeance arg)
    {
        var startDateTime = (_startDate ?? DateTime.MinValue).Date.Add(_startTime ?? TimeSpan.Zero);
        
        arg.StartDateTime = arg.StartMode switch
        {
            TechLogSeanceStartMode.Monitor => DateTime.MinValue,
            TechLogSeanceStartMode.Immediately => DateTime.UtcNow,
            _ => startDateTime
        };
        arg.StartDateTime = DateTime.SpecifyKind(startDateTime, DateTimeKind.Utc);
        
        ModelHelper.UpdateModelItems(_agents, arg.Agents);
        ModelHelper.UpdateModelItems(_agents, arg.Agents);
    }

    private string? ValidateDate(DateTime? dateTime)
        => ValidateStartPeriod();
    
    private string? ValidateTime(TimeSpan? timeSpan)
        => ValidateStartPeriod();

    private string? ValidateStartPeriod()
    {
        if (_editor.Model!.StartMode != TechLogSeanceStartMode.Scheduled)
            return null;
        
        var dt = (_startDate ?? DateTime.MinValue).Date.Add(_startTime ?? TimeSpan.Zero);
        
        return dt < DateTime.Now ? "Дата начала не может быть меньше текущей даты" : null;
    }

    private void SetAvailabilityInternal(TechLogSeance obj)
    {
        _startDateTimeDisabled = obj.StartMode != TechLogSeanceStartMode.Scheduled;
        _durationDisabled = obj.StartMode == TechLogSeanceStartMode.Monitor;
    }

    private void SetAvailability()
        => SetAvailabilityInternal(_editor.Model!);
    
    private string? ValidateDuration(int duration)
    {
        if (_editor.Model!.StartMode == TechLogSeanceStartMode.Monitor)
            return null;
        
        return duration < 1 ? "Длительность не может быть меньше 1 минуты" : null;
    }
    
    private async Task RaiseUpdateSettings(CancellationToken cancellationToken)
    {
        var connections = await AgentsConnectionsManager.GetActiveAgentsConnections(cancellationToken);
        
        foreach (var connection in connections)
            await connection.SendSettingsRequest(cancellationToken);
    }

    private async Task AfterSave(TechLogSeance obj)
        => await RaiseUpdateSettings(CancellationToken.None);
}

@*@page "/techlog/settings"*@
@using global::AutoMapper
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Services
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services
@inject NavigationManager NavigationManager
@inject ILogger<Settings> Logger
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject TechLogRepositoryManager TechLogRepositoryManager
@inject AgentsConnectionsManager AgentsConnectionsManager 
@inject IMapper Mapper
@implements IDisposable

<PageTitle>Настройки экспорта технологического журнала</PageTitle>

<h1 Class="mb-3">Настройки экспорта технологического журнала</h1>

<EditForm Model="Model!" OnSubmit="OnSubmit">
    <DataAnnotationsValidator/>
    
    <MudStack Class="mb-3" Row="true">
        <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary">Сохранить</MudButton>
    </MudStack>

    <MudStack>
        <MudSwitch Class="mb-3" For="@(() => Model!.Enabled)" @bind-Value="@Model!.Enabled" Color="Color.Primary"></MudSwitch>
        <MudSelect Class="mb-3" For="@(() => Model.DbmsId)" @bind-Value="@Model!.DbmsId" Clearable="true">
            @foreach (var item in _context!.Dbms.ToList())
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Class="mb-3" For="@(() => Model!.DatabaseName)" @bind-Value="@Model!.DatabaseName"></MudTextField>
        <MudTextField Class="mb-3" For="@(() => Model!.Table)" @bind-Value="@Model!.Table"></MudTextField>
        <MudSelect Class="mb-3" For="@(() => Model.CredentialsId)" @bind-Value="@Model!.CredentialsId" Clearable="true">
            @foreach (var item in _context!.Credentials.ToList())
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

</EditForm>

@code
{
    private AppDbContext? _context;
    private ValidationMessageStore? _messageStore;
    
    [SupplyParameterFromForm]
    private TechLogSettings? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.CreateDbContextAsync();
        Model = await _context!.TechLogSettings.FirstOrDefaultAsync() ?? new TechLogSettings();
    }
    
    private async Task OnSubmit(EditContext editContext)
    {
        _messageStore ??= new ValidationMessageStore(editContext);
        _messageStore.Clear();
        
        var isValid = true;

        // Проверка: если экспортер включён — обязательны поля DbmsId, CredentialsId и DatabaseName
        if (Model!.Enabled)
        {
            if (Model.DbmsId == null)
            {
                _messageStore.Add(
                    () => Model!.DbmsId,
                    "Выберите СУБД."
                );
                isValid = false;
            }
            if (Model.CredentialsId == null)
            {
                _messageStore.Add(
                    () => Model!.CredentialsId,
                    "Выберите учётные данные."
                );
                isValid = false;
            }
            if (string.IsNullOrWhiteSpace(Model.DatabaseName))
            {
                _messageStore.Add(
                    () => Model!.DatabaseName,
                    "Укажите имя базы данных."
                );
                isValid = false;
            }
            if (string.IsNullOrWhiteSpace(Model.Table))
            {
                _messageStore.Add(
                    () => Model!.Table,
                    "Укажите имя таблицы."
                );
                isValid = false;
            }
        }
        
        editContext.NotifyValidationStateChanged();

        // Если есть ошибки — показать их на форме
        if (!isValid)
            return;

        // ======= Сохранение в БД, если валидация прошла =======
        try
        {
            if (Model.Id != Guid.Empty)
                _context!.Entry(Model!).CurrentValues.SetValues(Model!);
            else
                _context!.TechLogSettings.Add(Model!);

            await _context!.SaveChangesAsync();
            NavigateBack();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при сохранении");
        }
    }

    private void NavigateBack()
        => NavigationManager.NavigateTo("/techlog/settings", true);

    public void Dispose()
    {
        _context?.Dispose();
    }
}

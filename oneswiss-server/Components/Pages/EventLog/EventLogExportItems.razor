@using global::OneScript.StandardLibrary.Collections
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Common.Models
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Layout
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Services
@using OneSwiss.Server.Services.CrServerProxy
@using ScriptEngine.Machine

@inject ISnackbar SnackBar
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject AgentsConnectionsManager AgentsConnectionsManager

@implements IDisposable

@attribute [ExtAuthorize]

<MudText Typo="Typo.h6" Class="mb-3">Экспортируемые журналы</MudText>

<MudStack>
    <MudTable T="EventLogExportItem"
              Items="@_items"
              Dense="true">
        <HeaderContent>
            <MudTd>Информационная база</MudTd>
            <MudTd>Активно</MudTd>
            <MudTd>TTL</MudTd>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Информационная база">
                <ItemSelector
                    @bind-Value="@context.InfoBaseId"
                    Items="@_context!.InfoBases.ToList()"
                    Class="mb-3"
                    ItemValueSelector="arg => arg.Id"
                    ItemNameSelector="@(arg => arg.Name)"
                    For="@(() => context.InfoBaseId)"/>
            </MudTd>
            <MudTd DataLabel="Активно">
                <MudSwitch For="@(() => context.IsActive)" @bind-Value="@context.IsActive" Color="Color.Primary"/>
            </MudTd>
            <MudTd DataLabel="TTL">
                <MudNumericField Class="mb-3" For="@(() => context.Ttl)"
                                 @bind-Value="@context.Ttl"/>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudStack Breakpoint="Breakpoint.SmAndDown" AlignItems="AlignItems.End">
        <MudSpacer/>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="Save">Сохранить
        </MudButton>
    </MudStack>

</MudStack>

@code
{
    private CancellationTokenSource? _cts;
    private AppDbContext? _context;
    private List<EventLogExportItem> _items = [];
    
    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _context = await ContextFactory.CreateDbContextAsync();
        await UpdateItems();
    }

    private async Task Save()
    {
        ModelHelper.UpdateDbSet(_items, _context!);

        await _context!.SaveChangesAsync();
        SnackBar.ShowSuccess("Объект записан");
        
        try
        {
            await AgentsConnectionsManager.RaiseUpdateSettings(_cts!.Token);
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
        }
    }

    private async Task UpdateItems()
    {
        _items = await _context!.EventLogExportItems.ToListAsync();
    }

    public void Dispose()
    {
        _context?.Dispose();
    }
}

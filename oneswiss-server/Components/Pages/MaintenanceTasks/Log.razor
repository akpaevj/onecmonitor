@page "/maintenancetasks/{id:guid}/log"
@using Dapper
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Models.MaintenanceTasks
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject NavigationManager NavManager
@inject ISnackbar SnackBar
@rendermode InteractiveServer

@attribute [ExtAuthorize(Roles.ReadMaintenanceTasks, Roles.WriteMaintenanceTasks)]

<PageTitle>Журнал задачи обслуживания</PageTitle>

<h1 Class="mb-3">Журнал задачи обслуживания</h1>

<MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true"
         ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Общий лог задачи" BadgeDot="true" BadgeColor="_taskLogBadgeColor">
        <MudTable T="MaintenanceTaskLogItem" Items="_taskLogItems" Style="width: 100%" Class="mb-3" Bordered="true">
            <HeaderContent>
                <MudTh>Время</MudTh>
                <MudTh>Уровень</MudTh>
                <MudTh>Сообщение</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Время">@context.TimeStamp</MudTd>
                <MudTd DataLabel="Уровень"
                       Class="@(context.IsError ? "mud-error-text" : "mud-info-text")">@(context.IsError ? "Ошибка" : "Инфо")</MudTd>
                <MudTd Style="white-space: pre-wrap" DataLabel="Сообщение">@context.Message</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>
    @if (_infobaseLogItems.Count > 0)
    {
        <MudTabPanel Text="Лог по информационным базам" BadgeDot="true" BadgeColor="_infoBasesLogBadgeColor">
            <MudTabs Outlined="true" Position="Position.Left" Rounded="true" Border="true"
                     ApplyEffectsToContainer="true" PanelClass="pa-6">

                @foreach (var infoBase in _taskInfoBases)
                {
                    var logs = _infobaseLogItems.TryGetValue(infoBase.Id, out var item) ? item : [];

                    <MudTabPanel Text="@infoBase.Name" BadgeDot="true" BadgeColor="@(GetBadgeColor(logs))">
                        <MudTable T="MaintenanceTaskLogItem" Items="logs" Style="width: 100%" Bordered="true">
                            <HeaderContent>
                                <MudTh>Время</MudTh>
                                <MudTh>Уровень</MudTh>
                                <MudTh>Сообщение</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Время">@context.TimeStamp</MudTd>
                                <MudTd DataLabel="Уровень"
                                       Class="@(context.IsError ? "mud-error-text" : "mud-info-text")">@(context.IsError ? "Ошибка" : "Инфо")</MudTd>
                                <MudTd Style="white-space: pre-wrap" DataLabel="Сообщение">@context.Message</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>
                }
            </MudTabs>
        </MudTabPanel>
    }
</MudTabs>

@code
{
    private bool _isLoading;
    private HubConnection? _hubConnection;
    private Color _taskLogBadgeColor = Color.Warning;
    private Color _infoBasesLogBadgeColor = Color.Warning;

    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<InfoBase> _taskInfoBases = [];
    private List<MaintenanceTaskLogItem> _taskLogItems = [];
    private Dictionary<Guid, List<MaintenanceTaskLogItem>> _infobaseLogItems = [];

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/taskLogHub"))
            .Build();

        _hubConnection.On("LogUpdated", async () =>
        {
            await UpdateItems();
            await InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
        await _hubConnection.InvokeAsync("Subscribe", Id);

        await UpdateItems();
    }

    private async Task UpdateItems()
    {
        if (_isLoading)
            return;

        try
        {
            _isLoading = true;

            await using var context = await ContextFactory.CreateDbContextAsync();

            var data = await context.MaintenanceTasks
                .AsNoTracking()
                .Include(c => c.InfoBases)
                .Include(c => c.Steps)
                .FirstOrDefaultAsync(c => c.Id == Id);

            var infoBasesCount = data!.InfoBases.Count;

            _taskInfoBases = data.InfoBases.OrderBy(c => c.Name).ToList();
            _infobaseLogItems = await context.MaintenanceTaskLogs
                .AsNoTracking()
                .Where(c => c.TaskId == data.Id && c.InfoBaseId != null)
                .GroupBy(c => c.InfoBaseId)
                .ToDictionaryAsync(c => (Guid)c.Key!, c => c.OrderBy(i => i.TimeStamp).AsList());

            _taskLogItems = await context.MaintenanceTaskLogs
                .AsNoTracking()
                .Where(c => c.TaskId == data.Id && c.InfoBaseId == null)
                .OrderBy(c => c.TimeStamp)
                .ToListAsync();

            var infoBasesLogs = _infobaseLogItems.SelectMany(c => c.Value).ToList();
            _taskLogBadgeColor = GetTaskTabBadgeColor(_taskLogItems, infoBasesLogs);
            _infoBasesLogBadgeColor = GetInfoBasesTabBadgeColor(infoBasesCount, infoBasesLogs);
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static Color GetTaskTabBadgeColor(List<MaintenanceTaskLogItem> taskLogs, List<MaintenanceTaskLogItem> stepLogs)
    {
        var hasError = taskLogs.Any(c => c.IsError) || stepLogs.Any(c => c.IsError);
        if (hasError)
            return Color.Error;

        var finished = taskLogs.Any(c => c.IsFinish);

        return finished ? Color.Success : Color.Warning;
    }

    private static Color GetInfoBasesTabBadgeColor(int infoBasesCount, List<MaintenanceTaskLogItem> stepLogs)
    {
        var hasError = stepLogs.Any(c => c.IsError);
        if (hasError)
            return Color.Error;

        var finished = stepLogs.Count(c => c.IsFinish);

        return finished == infoBasesCount ? Color.Success : Color.Warning;
    }

    private static Color GetBadgeColor(List<MaintenanceTaskLogItem> logs)
    {
        var hasError = logs.Any(c => c.IsError);
        var finished = logs.Any(c => c.IsFinish);

        if (hasError)
            return Color.Error;

        return finished ? Color.Success : Color.Warning;
    }
}

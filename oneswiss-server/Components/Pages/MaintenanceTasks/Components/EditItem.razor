@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Controls.Default
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using FluentValidation
@using global::AutoMapper
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Common.Extensions
@using OneSwiss.Common.Models.MaintenanceTasks
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Models.MaintenanceTasks
@using File = System.IO.File
@inject IJSRuntime JS
@inject IMapper Mapper
@inject IDialogService DialogService
@rendermode InteractiveServer

@attribute [ExtAuthorize(Roles.WriteMaintenanceTasks)]

<script>
    function disableWheelPropagation() {
        document.querySelector('.diagram-canvas').addEventListener('wheel', function (e) {
            e.preventDefault();
        }, {passive: false})
    }
</script>

<AuthorizeView>
    <EditDatabaseForm @ref="_editor" T="MaintenanceTask"
                      Id="Id"
                      NameSelector="@(arg => arg.Description)"
                      Title="@Title"
                      Route="@Route"
                      Validation="_validator.ValidateValue"
                      OnInitialize="OnInitialize"
                      ModelSelector="ModelSelector"
                      BeforeValidation="BeforeValidation"
                      OnUpdate="OnUpdate"
                      Editable="_editable">
        <MudStack>
            <MudStack Row Class="mb-3" Breakpoint="Breakpoint.MdAndDown" AlignItems="AlignItems.Center"
                      StretchItems="StretchItems.All">
                <MudTextField Class="w-100" For="@(() => _editor.Model!.Description)" Variant="Variant.Outlined"
                              Label="Наименование" @bind-Value="@_editor.Model!.Description"/>
                <MudSwitch Label="Задача общего назначения"
                           @bind-Value:get="@_editor.Model!.CommonDestination"
                           @bind-Value:set="SetTaskType"
                           Color="Color.Primary"/>
                @if (_editor.Model!.CommonDestination)
                {
                    <ItemsSelector T="Agent"
                                   Class="w-100"
                                   @bind-SelectedValues="_editor.Model!.Agents"
                                   Items="@_editor.Context!.Agents.ToList()"
                                   Title="Агенты"
                                   NameSelector="item => item.InstanceName"/>
                }
                else
                {
                    <ItemsSelector T="InfoBase"
                                   Class="w-100"
                                   @bind-SelectedValues="_editor.Model!.InfoBases"
                                   Items="@_editor.Context!.InfoBases.ToList()"
                                   Title="Информационные базы"
                                   NameSelector="item => item.Name"/>
                }
            </MudStack>
            <MudPaper Class="rounded-lg mud-background-gray pa-2">
                <MudStack Row Wrap="Wrap.Wrap" Class="mb-2" Spacing="0">
                    @foreach (var item in GetAvailableStepKinds())
                    {
                        <MudChip Disabled="@(!_editable)" T="MaintenanceStepKind"
                                 Style="@($"background-color: {item.GetKindColor()}")" Value="@item"
                                 OnClick="@(() => OnClickNodeType(item))">@item.GetDisplay()</MudChip>
                    }
                </MudStack>
                <MudPaper Class="rounded" Style="width: 100%; height: 500px">
                    <CascadingValue Value="Diagram" IsFixed="true">
                        <DiagramCanvas>
                            <Widgets>
                                <GridWidget Size="30" Mode="GridMode.Point" BackgroundColor="@($"#{Color.Default}")"/>
                            </Widgets>
                        </DiagramCanvas>
                    </CascadingValue>
                </MudPaper>
            </MudPaper>
        </MudStack>

    </EditDatabaseForm>
</AuthorizeView>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<MaintenanceTask> _editor = null!;
    private bool _editable;
    private AuthenticationState _authState;

    [Parameter] public Guid Id { get; set; }

    [Parameter] public bool IsTemplate { get; set; }

    [Parameter] public string Title { get; set; } = null!;

    [Parameter] public string Route { get; set; } = null!;

    [SupplyParameterFromQuery] public Guid TemplateId { get; set; }

    [CascadingParameter] public Task<AuthenticationState>? AuthStateTask { get; set; }

    public BlazorDiagram Diagram { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _editor.AddAdditionalValidableProperty(nameof(MaintenanceTask.InfoBases));
        _editor.AddAdditionalValidableProperty(nameof(MaintenanceTask.Steps));

        await JS.InvokeVoidAsync("disableWheelPropagation");
    }

    private async Task OnInitialize((MaintenanceTask Model, AppDbContext Context) valueTuple)
    {
        _authState = await AuthStateTask!;
        _editable = valueTuple.Model.StartDateTime == DateTime.MinValue && !_authState.IsReadOnly(Roles.WriteMaintenanceTasks);

        InitDiagram();

        if (TemplateId != Guid.Empty)
            await InitModelFromTemplate(valueTuple.Model, valueTuple.Context);

        ModelToDiagram(valueTuple.Model);
    }

    private static IQueryable<MaintenanceTask> ModelSelector(IQueryable<MaintenanceTask> arg)
    {
        return arg
            .Include(c => c.Agents)
            .Include(c => c.InfoBases)
            .Include(c => c.Steps).ThenInclude(c => c.CopyInfoBaseStep)
            .Include(c => c.Steps).ThenInclude(c => c.LoadExtensionStep)
            .Include(c => c.Steps).ThenInclude(c => c.LoadConfigurationStep)
            .Include(c => c.Steps).ThenInclude(c => c.UpdateConfigurationStep)
            .Include(c => c.Steps).ThenInclude(c => c.DeleteExtensionStep)
            .Include(c => c.Steps).ThenInclude(c => c.ExecuteOneScriptStep)
            .Include(c => c.Steps).ThenInclude(c => c.LockConnectionsStep)
            .Include(c => c.Steps).ThenInclude(c => c.StartExternalDataProcessorStep);
    }

    private void BeforeValidation(MaintenanceTask obj)
    {
        obj.IsTemplate = IsTemplate;

        DiagramToModel(obj);
    }

    private void OnUpdate(MaintenanceTask obj)
    {
        ModelHelper.UpdateModelItems(_editor.Model!.Agents, obj.Agents);
        ModelHelper.UpdateModelItems(_editor.Model!.InfoBases, obj.InfoBases);
        ModelHelper.UpdateModelItems(_editor.Model!.Steps, obj.Steps);
    }

    private async Task InitModelFromTemplate(MaintenanceTask task, AppDbContext context)
    {
        // Запомним уже сформированный для модели id
        var template = (await context.MaintenanceTasks
            .AsNoTracking()
            .Include(c => c.Agents)
            .Include(c => c.InfoBases)
            .Include(c => c.Steps).ThenInclude(c => c.CopyInfoBaseStep)
            .Include(c => c.Steps).ThenInclude(c => c.LoadExtensionStep)
            .Include(c => c.Steps).ThenInclude(c => c.LoadConfigurationStep)
            .Include(c => c.Steps).ThenInclude(c => c.UpdateConfigurationStep)
            .Include(c => c.Steps).ThenInclude(c => c.ExecuteOneScriptStep)
            .Include(c => c.Steps).ThenInclude(c => c.StartExternalDataProcessorStep)
            .Include(c => c.Steps).ThenInclude(c => c.DeleteExtensionStep)
            .Include(c => c.Steps).ThenInclude(c => c.LockConnectionsStep)
            .FirstOrDefaultAsync(c => c.Id == TemplateId))!;

        task.Description = template.Description;
        task.IsTemplate = IsTemplate;
        task.CommonDestination = template.CommonDestination;

        task.Agents = template.Agents;
        context.AttachRange(task.Agents);

        task.InfoBases = template.InfoBases;
        context.AttachRange(task.InfoBases);

        var newSteps = Mapper.Map<List<MaintenanceStep>>(template.Steps);
        newSteps.ForEach(c => c.Id = Guid.NewGuid());

        task.Steps.AddRange(newSteps);
    }

    private void InitDiagram()
    {
        Diagram = new BlazorDiagram(new BlazorDiagramOptions
        {
            Zoom =
            {
                Enabled = true
            },
            Links =
            {
                RequireTarget = true,
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator(0D),
                EnableSnapping = true,
                SnappingRadius = 25
            }
        });

        Diagram.RegisterComponent<StepNode, StepWidget>();

        Diagram.Links.Added += model =>
        {
            Diagram.Controls.AddFor(model).Add(new RemoveControl(0.5, 1));
            ShowHideLinkLabels(model);
        };
        Diagram.Links.Removed += ShowHideLinkLabels;

        Diagram.Nodes.Added += model =>
        {
            if (model is not StepNode stepNode)
                return;

            Diagram.Controls.AddFor(model).Add(new RemoveControl(0.5, 1));

            if (stepNode.Step.Id != Guid.Empty)
                return;

            model.Changed += OnNodeChanged;
        };
    }

    private void DiagramToModel(MaintenanceTask task)
    {
        task.Steps.Clear();

        // Очистим связи шагов перед повторным заполнением, чтобы избежать фантомов
        Diagram.Nodes.Cast<StepNode>().ToList().ForEach(c =>
        {
            c.Step.LeftStepId = null;
            c.Step.RightStepId = null;
            c.Step.PreviousStepId = null;
        });

        foreach (var node in Diagram.Nodes)
        {
            var step = (node as StepNode)!.Step;
            step.PositionX = node.Position.X;
            step.PositionY = node.Position.Y;

            foreach (var link in node.PortLinks)
            {
                if (link.Source.Model == null || link.Target.Model == null)
                    return;

                var step1 = link.Source.Model as StepPort;
                var step2 = link.Target.Model as StepPort;

                var step1Node = step1!.Parent;
                var step2Node = step2!.Parent;

                if (step1.IsIn)
                    step1Node.Step.PreviousStepId = step2Node.Step.StepId;
                else if (step1.IsSuccess)
                    step1Node.Step.LeftStepId = step2Node.Step.StepId;
                else if (step1.IsFailure)
                    step1Node.Step.RightStepId = step2Node.Step.StepId;

                if (step2.IsIn)
                    step2Node.Step.PreviousStepId = step1Node.Step.StepId;
                else if (step2.IsSuccess)
                    step2Node.Step.LeftStepId = step1Node.Step.StepId;
                else if (step2.IsFailure)
                    step2Node.Step.RightStepId = step1Node.Step.StepId;
            }

            step.NodeKind = step is { LeftStepId: not null, RightStepId: not null }
                ? MaintenanceStepNodeKind.TryCatch
                : MaintenanceStepNodeKind.Simple;

            task.Steps.Add(step);
        }
    }

    private void ModelToDiagram(MaintenanceTask task)
    {
        var nodeStepPairs = new Dictionary<MaintenanceStep, StepNode>();

        // Сначала добавляем все ноды
        foreach (var step in task.Steps)
        {
            var addedNode = Diagram.Nodes.Add(new StepNode(step, new Point(step.PositionX, step.PositionY)));
            InitNode(addedNode);
            nodeStepPairs.Add(step, addedNode);
        }

        // После того, как ноды добавлены, линкуем их в соответствии с шагами
        foreach (var step in task.Steps)
        {
            var node = nodeStepPairs[step];

            if (step.PreviousStepId == null)
                continue;

            var secondPort = GetSecondPort(step.StepId);
            Diagram.Links.Add(new LinkModel(secondPort, node.GetInPort()!));
        }

        return;

        PortModel GetSecondPort(Guid firstStepId)
        {
            var secondStep = task.Steps.FirstOrDefault(c => c.LeftStepId == firstStepId);
            if (secondStep != null)
            {
                var n = nodeStepPairs[secondStep];
                return n.GetSuccessPort()!;
            }

            secondStep = task.Steps.FirstOrDefault(c => c.RightStepId == firstStepId);

            var n1 = nodeStepPairs[secondStep!];
            return n1.GetFailurePort()!;
        }
    }

    private void OnNodeChanged(Model model)
    {
        model.Changed -= OnNodeChanged;

        if (model is not StepNode node)
            return;

        var lastNode = Diagram.Nodes
            .Cast<StepNode>()
            .Where(c => c.Id != node.Id && c.Step.LeftStepId == null && c.Step.RightStepId == null)
            .MaxBy(c => c.Position.X);

        if (lastNode == null)
            node.Position = new Point(30, Diagram.Container!.Height / 2 - node.Size!.Height / 2);
        else
        {
            var lastNodeY = lastNode.GetBounds()!.Center.Y;
            var newNodeX = lastNode.GetBounds()!.Right + 80;

            node.Position = new Point(newNodeX, lastNodeY - node.Size!.Height / 2);

            Diagram.Links.Add(new LinkModel(lastNode.GetSuccessPort()!, node.GetInPort()!));
        }
    }

    private void ShowHideLinkLabels(BaseLinkModel model)
    {
        if (model.Source.Model is not StepPort port)
            return;

        var parent = port.Parent;
        var successPort = parent.GetSuccessPort();
        var failurePort = parent.GetFailurePort();

        if (successPort?.Links.Count > 0 && failurePort?.Links.Count > 0)
        {
            var successLink = successPort.Links.FirstOrDefault();
            if (successLink is not null && successLink.Labels.Count == 0)
            {
                successLink.AddLabel("Успех");
                successLink.Refresh();
            }

            var failureLink = failurePort.Links.FirstOrDefault();
            if (failureLink is not null && failureLink.Labels.Count == 0)
            {
                failureLink.AddLabel("Ошибка");
                failureLink.Refresh();
            }
        }
        else if (successPort?.Links.Count == 0 && failurePort?.Links.Count > 0)
            Diagram.Links.Remove(failurePort.Links.First());
        else if (successPort?.Links.Count > 0 && failurePort?.Links.Count == 0)
        {
            var topLink = successPort.Links.First();
            topLink.Labels.Clear();
            topLink.Refresh();
        }
    }

    private void OnClickNodeType(MaintenanceStepKind kind)
    {
        var node = new StepNode(kind)
        {
            Step =
            {
                StepId = Guid.NewGuid()
            }
        };
        InitNode(node);
        Diagram.Nodes.Add(node);
    }

    private void InitNode(StepNode node)
    {
        node.AddPort(new StepPort(Diagram, StepPortType.Failure, node, PortAlignment.BottomRight));
        node.AddPort(new StepPort(Diagram, StepPortType.Success, node, PortAlignment.TopRight));
        node.AddPort(new StepPort(Diagram, StepPortType.In, node, PortAlignment.Left));
    }

    private async Task SetTaskType(bool value)
    {
        var oldValue = _editor.Model!.CommonDestination;
        _editor.Model!.CommonDestination = value;

        var availableStepKinds = GetAvailableStepKinds();

        var nodes = Diagram.Nodes.Cast<StepNode>().ToList();
        var hasNotAvailableNodes = nodes.FirstOrDefault(c => !availableStepKinds.Contains(c.Step.Kind)) != null;

        if (hasNotAvailableNodes)
        {
            var result = await DialogService.ShowMessageBox(
                "Смена типа задачи",
                "После смены типа задачи, недоступные к использованию типы шагов будут удалены. Продолжить?",
                "Да",
                "Нет");

            if (result == true)
                nodes
                    .Where(c => !availableStepKinds.Contains(c.Step.Kind))
                    .ToList()
                    .ForEach(Diagram.Nodes.Remove);
            else
                _editor.Model.CommonDestination = oldValue;
        }
    }

    private MaintenanceStepKind[] GetAvailableStepKinds()
    {
        return _editor.Model!.CommonDestination switch
        {
            false =>
            [
                MaintenanceStepKind.LockConnections,
                MaintenanceStepKind.CloseConnections,
                MaintenanceStepKind.UnlockConnections,
                MaintenanceStepKind.LoadExtension,
                MaintenanceStepKind.DeleteExtension,
                MaintenanceStepKind.UpdateConfiguration,
                MaintenanceStepKind.LoadConfiguration,
                MaintenanceStepKind.StartExternalDataProcessor
                //MaintenanceStepKind.ExecuteOneScript до следующего раза=(
            ],
            _ =>
            [
                MaintenanceStepKind.ExecuteOneScript
            ]
        };
    }

    class Validator : ModelValidator<MaintenanceTask>
    {
        public Validator()
        {
            RuleFor(c => c.Description)
                .NotEmpty()
                .WithMessage("Не указано описание");

            RuleFor(c => c.Steps)
                .NotEmpty()
                .WithMessage("Не указаны шаги обслуживания")
                .Must(steps => steps.Count(c => c.PreviousStepId == null) == 1)
                .WithMessage("Начальных шагов обслуживания не может быть больше одного");

            When(c => !c.IsTemplate, () =>
            {
                When(c => !c.CommonDestination, () =>
                {
                    RuleFor(c => c.InfoBases)
                        .NotEmpty()
                        .WithMessage("Не указано ни одной информационной базы");
                });

                RuleForEach(i => i.Steps)
                    .Custom((step, context) =>
                    {
                        if (step.Kind == MaintenanceStepKind.DeleteExtension && string.IsNullOrEmpty(step.DeleteExtensionStep!.ExtensionName))
                            context.AddFailure(
                                nameof(context.PropertyPath),
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указано регулярное выражение имени расширения");

                        if (step.Kind == MaintenanceStepKind.ExecuteOneScript)
                        {
                            if (!step.ExecuteOneScriptStep!.DebugMode && step.ExecuteOneScriptStep!.FileId.EmptyOrNull())
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл .ospx");

                            if (step.ExecuteOneScriptStep!.DebugMode && string.IsNullOrEmpty(step.ExecuteOneScriptStep!.ExecutablePath))
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл скрипта");

                            if (step.ExecuteOneScriptStep!.DebugMode &&
                                !string.IsNullOrEmpty(step.ExecuteOneScriptStep!.ExecutablePath) &&
                                !File.Exists(step.ExecuteOneScriptStep!.ExecutablePath))
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не найден файл скрипта");
                        }

                        if (step.Kind == MaintenanceStepKind.LoadExtension)
                        {
                            if (string.IsNullOrEmpty(step.LoadExtensionStep!.ExtensionName))
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указано имя расширения");

                            if (step.LoadExtensionStep.FromConfigRepository)
                            {
                                if (step.LoadExtensionStep.ConfigurationRepositoryId.EmptyOrNull())
                                    context.AddFailure(
                                        nameof(context.PropertyPath),
                                        $"В шаге \"{step.Kind.GetDisplay()}\" не указано хранилище");
                            }
                            else
                            {
                                if (step.LoadExtensionStep.FileId.EmptyOrNull())
                                    context.AddFailure(
                                        nameof(context.PropertyPath),
                                        $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл .cfe");
                            }
                        }

                        if (step.Kind == MaintenanceStepKind.LoadConfiguration)
                        {
                            if (step.LoadConfigurationStep!.FromConfigRepository)
                            {
                                if (step.LoadConfigurationStep!.ConfigurationRepositoryId.EmptyOrNull())
                                    context.AddFailure(
                                        nameof(context.PropertyPath),
                                        $"В шаге \"{step.Kind.GetDisplay()}\" не указано хранилище");
                            }
                            else
                            {
                                if (step.LoadConfigurationStep.FileId.EmptyOrNull())
                                    context.AddFailure(
                                        nameof(context.PropertyPath),
                                        $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл .cf");
                            }
                        }

                        if (step.Kind == MaintenanceStepKind.UpdateConfiguration && step.UpdateConfigurationStep!.FileId.EmptyOrNull())
                            context.AddFailure(
                                nameof(context.PropertyPath),
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл .cfu");

                        if (step.Kind == MaintenanceStepKind.StartExternalDataProcessor && step.StartExternalDataProcessorStep!.FileId.EmptyOrNull())
                            context.AddFailure(
                                nameof(context.PropertyPath),
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл .epf");

                        if (step.Kind == MaintenanceStepKind.LockConnections)
                        {
                            if (string.IsNullOrEmpty(step.LockConnectionsStep!.AccessCode))
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указан код доступа");

                            if (string.IsNullOrEmpty(step.LockConnectionsStep!.Message))
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указано сообщение пользователю");
                        }

                        if (step.Kind == MaintenanceStepKind.CopyInfoBase)
                        {
                            if (step.CopyInfoBaseStep!.SourceCredentialsId.EmptyOrNull())
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указаны учетные данные СУБД-источника");

                            if (step.CopyInfoBaseStep!.DestinationCredentialsId.EmptyOrNull())
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указаны учетные данные СУБД-приемника");

                            if (step.CopyInfoBaseStep!.SourceInfoBaseId.EmptyOrNull())
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указана ИБ-источник");

                            if (step.CopyInfoBaseStep!.DestinationInfoBaseId.EmptyOrNull())
                                context.AddFailure(
                                    nameof(context.PropertyPath),
                                    $"В шаге \"{step.Kind.GetDisplay()}\" не указана ИБ-приемник");
                        }
                    });
            });
        }
    }
}

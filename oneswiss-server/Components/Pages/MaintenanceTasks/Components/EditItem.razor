@using Blazor.Diagrams
@using Microsoft.EntityFrameworkCore
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Controls.Default
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using FluentValidation
@using global::AutoMapper
@using OneSwiss.Common.Extensions
@using OneSwiss.Common.Models.MaintenanceTasks
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Models.MaintenanceTasks
@using OneSwiss.Server.Components.Shared
@inject IJSRuntime JS
@rendermode InteractiveServer

<script>
    function disableWheelPropagation() {
        document.querySelector('.diagram-canvas').addEventListener('wheel', function(e) {
            e.preventDefault();
        }, { passive: false })
    }
</script>

<EditDatabaseObject @ref="_editor" T="MaintenanceTask"
                    Id="Id"
                    NameSelector="@(arg => arg.Description)"
                    Title="@Title"
                    Route="@Route"
                    Validation="_validator.ValidateValue"
                    OnInitialize="OnInitialize"
                    ModelSelector="ModelSelector"
                    BeforeValidation="BeforeValidation"
                    OnUpdate="OnUpdate"
                    Editable="_editable">
    <MudStack>
        <MudStack Row AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
            <MudTextField Class="mb-3 w-100" For="@(() => _editor.Model!.Description)" Variant="Variant.Outlined" Label="Наименование" @bind-Value="@_editor.Model!.Description"/>
            <ItemsSelector T="InfoBase"
                           @bind-SelectedValues="_selectedInfoBases"
                           Class="w-100"
                           Items="@_editor.Context!.InfoBases.ToList()"
                           Title="Информационные базы"
                           NameSelector="item => item.Name"/>
        </MudStack>
        <MudPaper Class="rounded-lg mud-background-gray pa-2">
            <MudStack Row Wrap="Wrap.Wrap" Class="mb-2" Spacing="0">
                @foreach (var item in Enum.GetValues<MaintenanceStepKind>())
                {
                    <MudChip Disabled="@(!_editable)" T="MaintenanceStepKind" Style="@($"background-color: {item.GetKindColor()}")" Value="@item" OnClick="@(() => OnClickNodeType(item))">@item.GetDisplay()</MudChip>
                }
            </MudStack>
            <MudPaper Class="rounded" Style="width: 100%; height: 500px">
                <CascadingValue Value="Diagram" IsFixed="true">
                    <DiagramCanvas>
                        <Widgets>
                            <GridWidget Size="30" Mode="GridMode.Point" BackgroundColor="@($"#{Color.Default}")"/>
                        </Widgets>
                    </DiagramCanvas>
                </CascadingValue>
            </MudPaper>
        </MudPaper>
    </MudStack>
    
</EditDatabaseObject>

@code
{
    private List<InfoBase> _selectedInfoBases;
    private readonly Validator _validator = new();
    private EditDatabaseObject<MaintenanceTask> _editor = null!;
    private bool _editable;
    
    [Parameter]
    public Guid Id { get; set; }
    
    [Parameter] 
    public bool IsTemplate { get; set; }

    [Parameter]
    public string Title { get; set; } = null!;
    
    [Parameter] 
    public string Route { get; set; } = null!;
    
    [SupplyParameterFromQuery] 
    public Guid TemplateId { get; set; }
    
    public BlazorDiagram Diagram { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        
        _editor.AddAdditionalValidableProperty(nameof(MaintenanceTask.InfoBases));
        _editor.AddAdditionalValidableProperty(nameof(MaintenanceTask.Steps));

        await JS.InvokeVoidAsync("disableWheelPropagation");
    }
    
    private async Task OnInitialize((MaintenanceTask Model, AppDbContext Context) valueTuple)
    {
        _editable = valueTuple.Model.StartDateTime == DateTime.MinValue;
        UpdateSelectedInfoBases(valueTuple.Model);
        
        InitDiagram();
        
        if (TemplateId != Guid.Empty)
            await InitModelFromTemplate(valueTuple.Model, valueTuple.Context);
        
        ModelToDiagram(valueTuple.Model, valueTuple.Context);
    }

    private void UpdateSelectedInfoBases(MaintenanceTask task)
    {
        _selectedInfoBases = task.InfoBases.Select(c => c.InfoBase).ToList();
    }
    
    private static IQueryable<MaintenanceTask> ModelSelector(IQueryable<MaintenanceTask> arg)
        => arg.Include(c => c.InfoBases).ThenInclude(c => c.InfoBase).Include(c => c.Steps);
    
    private void BeforeValidation(MaintenanceTask obj)
    {
        obj.InfoBases = _selectedInfoBases.Select(c => new InfoBaseMaintenanceTask
        {
            InfoBaseId = c.Id,
            MaintenanceTaskId = obj.Id
        }).ToList();
        obj.IsTemplate = IsTemplate;
        
        DiagramToModel(obj);
    }
    
    private void OnUpdate(MaintenanceTask obj)
    {
        ModelHelper.UpdateModelItems(_editor.Model!.InfoBases, obj.InfoBases);
        ModelHelper.UpdateModelItems(_editor.Model!.Steps, obj.Steps);
    }
    
    private async Task InitModelFromTemplate(MaintenanceTask task, AppDbContext context)
    {
        // Запомним уже сформированный для модели id
        var id = task.Id;
        
        var template = (await context.MaintenanceTasks
            .AsNoTracking()
            .Include(c => c.InfoBases).ThenInclude(c => c.InfoBase)
            .Include(c => c.Steps)
            .FirstOrDefaultAsync(c => c.Id == TemplateId))!;

        task.Id = id;
        task.Description = template.Description;
        task.IsTemplate = IsTemplate;
        UpdateSelectedInfoBases(template);
        task.Steps.AddRange(template.Steps);
        
        // Очистим все id, чтобы не перезатереть сам шаблон при записи
        task.Steps.ForEach(c =>
        {
            var currentId = c.Id;
            var newId = Guid.NewGuid();
                
            task.Steps.ForEach(i =>
            {
                if (i.PreviousStepId == currentId)
                    i.PreviousStepId = newId;
                    
                if (i.LeftStepId == currentId)
                    i.LeftStepId = newId;
                    
                if (i.RightStepId == currentId)
                    i.RightStepId = newId;
            });
                
            c.Id = newId;
        });
    }
    
    private void InitDiagram()
    {
        Diagram = new BlazorDiagram(new BlazorDiagramOptions
        {
            Zoom =
            {
                Enabled = true
            },
            Links =
            {
                RequireTarget = true,
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator(0D),
                EnableSnapping = true,
                SnappingRadius = 25
            }
        });
        
        Diagram.RegisterComponent<StepNode, StepWidget>();
        
        Diagram.Links.Added += model =>
        {
            Diagram.Controls.AddFor(model).Add(new RemoveControl(0.5, 1));
            ShowHideLinkLabels(model);
        };
        Diagram.Links.Removed += ShowHideLinkLabels;

        Diagram.Nodes.Added += model =>
        {
            if (model is not StepNode stepNode) 
                return;
            
            Diagram.Controls.AddFor(model).Add(new RemoveControl(0.5, 1));

            if (stepNode.Step.Id != Guid.Empty) 
                return;
            
            model.Changed += OnNodeChanged;
            stepNode.Step.Id = Guid.NewGuid();
        };
    }
    
    private void DiagramToModel(MaintenanceTask task)
    {
        task.Steps.Clear();
        
        // Очистим связи шагов перед повторным заполнением, чтобы избежать фантомов
        Diagram.Nodes.Cast<StepNode>().ToList().ForEach(c =>
        {
            c.Step.LeftStepId = null;
            c.Step.RightStepId = null;
            c.Step.PreviousStepId = null;
        });

        foreach (var node in Diagram.Nodes)
        {
            var step = (node as StepNode)!.Step;
            step.PositionX = node.Position.X;
            step.PositionY = node.Position.Y;

            foreach (var link in node.PortLinks)
            {
                if (link.Source.Model == null || link.Target.Model == null) 
                    return;
        
                var step1 = link.Source.Model as StepPort;
                var step2 = link.Target.Model as StepPort;

                var step1Node = step1!.Parent as StepNode;
                var step2Node = step2!.Parent as StepNode;

                if (step1.Alignment == PortAlignment.Left)
                    step1Node!.Step.PreviousStepId = step2Node!.Step.Id;
                else if (step1.Alignment == PortAlignment.TopRight)
                    step1Node!.Step.LeftStepId = step2Node!.Step.Id;
                else if (step1.Alignment == PortAlignment.BottomRight)
                    step1Node!.Step.RightStepId = step2Node!.Step.Id;
                
                if (step2.Alignment == PortAlignment.Left)
                    step2Node!.Step.PreviousStepId = step1Node!.Step.Id;
                else if (step2.Alignment == PortAlignment.TopRight)
                    step2Node!.Step.LeftStepId = step1Node!.Step.Id;
                else if (step2.Alignment == PortAlignment.BottomRight)
                    step2Node!.Step.RightStepId = step1Node!.Step.Id;
            }

            step.NodeKind = step is { LeftStepId: not null, RightStepId: not null } 
                ? MaintenanceStepNodeKind.TryCatch : MaintenanceStepNodeKind.Simple;
            
            task.Steps.Add(step);
        }
    }

    private void ModelToDiagram(MaintenanceTask task, AppDbContext context)
    {
        var nodeStepPairs = new Dictionary<MaintenanceStep, StepNode>();
        
        // Сначала добавляем все ноды
        foreach (var step in task.Steps)
        {
            var addedNode = Diagram.Nodes.Add(new StepNode(step, new Point(step.PositionX, step.PositionY)));
            InitNode(addedNode, context);
            nodeStepPairs.Add(step, addedNode);
        }

        // После того, как ноды добавлены, линкуем их в соответствии с шагами
        foreach (var step in task.Steps)
        {
            var node = nodeStepPairs[step];

            if (step.PreviousStepId == null) 
                continue;
            
            var secondPort = GetSecondPort(step.Id);
            Diagram.Links.Add(new LinkModel(secondPort, node.GetPort(PortAlignment.Left)!));
        }

        return;

        PortModel GetSecondPort(Guid firstStepId)
        {
            var secondStep = task.Steps.FirstOrDefault(c => c.LeftStepId == firstStepId);
            if (secondStep != null)
            {
                var n = nodeStepPairs[secondStep];
                return n.GetPort(PortAlignment.TopRight)!;
            }
            
            secondStep = task.Steps.FirstOrDefault(c => c.RightStepId == firstStepId);
            
            var n1 = nodeStepPairs[secondStep!];
            return n1.GetPort(PortAlignment.BottomRight)!;
        }
    }

    private void OnNodeChanged(Model model)
    {
        model.Changed -= OnNodeChanged;
        
        if (model is not StepNode node)
            return;
        
        var lastNode = Diagram.Nodes
            .Cast<StepNode>()
            .Where(c => c.Id != node.Id && c.Step.LeftStepId == null && c.Step.RightStepId == null)
            .MaxBy(c => c.Position.X);

        if (lastNode == null)
            node.Position = new Point(30, Diagram.Container!.Height / 2 - node.Size!.Height / 2);
        else
        {
            var lastNodeY = lastNode.GetBounds()!.Center.Y;
            var newNodeX = lastNode.GetBounds()!.Right + 80;

            node.Position = new Point(newNodeX, lastNodeY - (node.Size!.Height / 2));

            Diagram.Links.Add(new LinkModel(lastNode.GetPort(PortAlignment.TopRight)!, node.GetPort(PortAlignment.Left)!));   
        }
    }

    private void ShowHideLinkLabels(BaseLinkModel model)
    {
        if (model.Source.Model is not StepPort port) 
            return;
            
        var parent = port.Parent;
        var top = parent.Ports.FirstOrDefault(c => c.Alignment == PortAlignment.TopRight);
        var bottom = parent.Ports.FirstOrDefault(c => c.Alignment == PortAlignment.BottomRight);

        if (top?.Links.Count > 0 && bottom?.Links.Count > 0)
        {
            var topLink = top.Links.FirstOrDefault();
            if (topLink is not null && topLink.Labels.Count == 0)
            {
                topLink.AddLabel("Успех");
                topLink.Refresh();
            }
                
            var bottomLink = bottom.Links.FirstOrDefault();
            if (bottomLink is not null && bottomLink.Labels.Count == 0)
            {
                bottomLink.AddLabel("Ошибка");
                bottomLink.Refresh();
            }
        }
        else if (top?.Links.Count == 0 && bottom?.Links.Count > 0)
            Diagram.Links.Remove(bottom.Links.First());
        else if (top?.Links.Count > 0 && bottom?.Links.Count == 0)
        {
            var topLink = top.Links.First();
            topLink.Labels.Clear();
            topLink.Refresh();
        }
    }
    
    private void OnClickNodeType(MaintenanceStepKind kind)
    {
        var node = new StepNode(kind);
        InitNode(node, _editor.Context!);
        Diagram.Nodes.Add(node);
    }

    private void InitNode(StepNode node, AppDbContext context)
    {
        if (node.Step.NeedLoadFiles())
            node.Files = context.Files.AsNoTracking().Where(c => c.FileType == node.Step.AvailableFileType).ToList();

        node.AddPort(new StepPort(Diagram, node, PortAlignment.BottomRight));
        node.AddPort(new StepPort(Diagram, node, PortAlignment.TopRight));
        node.AddPort(new StepPort(Diagram, node, PortAlignment.Left));
    }
    
    class Validator : ModelValidator<MaintenanceTask>
    {
        public Validator()
        {
            RuleFor(c => c.Description)
                .NotEmpty()
                .WithMessage("Не указано описание");
            
            RuleFor(c => c.Steps)
                .NotEmpty()
                .WithMessage("Не указаны шаги обслуживания")
                .Must(steps => steps.Count(c => c.PreviousStepId == null) == 1)
                .WithMessage("Начальных шагов обслуживания не может быть больше одного");

            When(c => !c.IsTemplate, () =>
            {
                RuleFor(c => c.InfoBases)
                    .NotEmpty()
                    .WithMessage("Не указано ни одной информационной базы");

                RuleForEach(task => task.Steps)
                    .Custom((step, context) =>
                    {
                        if (step.NeedLoadFiles() && step.FileId == Guid.Empty)
                            context.AddFailure(
                                nameof(context.PropertyPath), 
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указан файл");

                        if (step.NeeSpecifyExtensionName() && string.IsNullOrEmpty(step.ExtensionName))
                            context.AddFailure(
                                nameof(context.PropertyPath), 
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указано имя расширения");
                        
                        if (step.NeeSpecifyMessage() && string.IsNullOrEmpty(step.Message))
                            context.AddFailure(
                                nameof(context.PropertyPath), 
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указан текст сообщения");
                        
                        if (step.NeeSpecifyAccessCode() && string.IsNullOrEmpty(step.AccessCode))
                            context.AddFailure(
                                nameof(context.PropertyPath), 
                                $"В шаге \"{step.Kind.GetDisplay()}\" не указан код доступа");
                    });
            });
        }
    }
}

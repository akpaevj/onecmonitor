@page "/credentials/{id:guid}"
@page "/credentials/create"
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models

<EditDatabaseObject @ref="_editor" T="Credentials"
                    Id="Id"
                    Route="credentials"
                    Title="Новые учетные данные"
                    NameSelector="@(c => c.Name)"
                    ModelSelector="ModelSelector"
                    OnSave="OnSave"
                    OnInitialize="OnInitialize">
    <FormContent>
        <MudStack>
            <MudTextField Class="mb-3" Label="Наименование" @bind-Value="@_editor.Model!.Name"
                          Required="true" RequiredError="Наименование не заполнено"/>
            <MudStack Row>
                <MudTextField Class="mb-3" Label="Пользователь" @bind-Value="@_editor.Model!.User"
                              Required="true" RequiredError="Имя пользователя не заполнено"/>
                <MudTextField Class="mb-3" Label="Пароль" @bind-Value="@_editor.Model!.Password"
                              Required="true" RequiredError="Пароль не заполнен"/>
            </MudStack>
            <MudStack Row>
                <MudSwitch Class="mb-3" @bind-Value="@_editor.Model!.DefaultForClusters" Color="Color.Primary"></MudSwitch>
                <MudSwitch Class="mb-3" @bind-Value="@_editor.Model!.DefaultV8Admin" Color="Color.Primary"></MudSwitch>
            </MudStack>
            <MudStack Row StretchItems="StretchItems.All">
                <ItemsSelector T="Cluster"
                               @bind-SelectedValues="@_clusters"
                               Items="@_editor.Context.Clusters.ToList()"
                               Title="Кластеры"
                               NameSelector="item => item.Name"/>
                <ItemsSelector T="InfoBase"
                               @bind-SelectedValues="@_infoBases"
                               Items="@_editor.Context.InfoBases.ToList()"
                               Title="Информационные базы"
                               NameSelector="item => item.Name"/>
            </MudStack>
        </MudStack>
    </FormContent>
</EditDatabaseObject>

@code
{
    private EditDatabaseObject<Credentials> _editor = null!;

    private IReadOnlyCollection<Cluster> _clusters = [];
    private IReadOnlyCollection<InfoBase> _infoBases = [];
    
    /// <summary>
    /// Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private static IQueryable<Credentials> ModelSelector(IQueryable<Credentials> arg)
        => arg
            .Include(c => c.InfoBases)
            .Include(c => c.Clusters);
    
    private void OnInitialize(Credentials obj)
    {
        _clusters = obj.Clusters;
        _infoBases = obj.InfoBases;
    }
    
    private void OnSave(Credentials model)
    {
        ModelHelper.UpdateModelItems(_infoBases, model.InfoBases);
        ModelHelper.UpdateModelItems(_clusters, model.Clusters);
    }
}

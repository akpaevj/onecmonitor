@page "/credentials/{id:guid}"
@page "/credentials/create"
@using System.Data
@using FluentValidation
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models

@attribute [ExtAuthorize]

<EditDatabaseForm @ref="_editor" T="Credentials"
                    Id="Id"
                    Route="credentials"
                    Title="Новые учетные данные"
                    NameSelector="@(c => c.Name)"
                    ModelSelector="ModelSelector"
                    OnUpdate="OnUpdate"
                    Validation="_validator.ValidateValue">
    <MudStack>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" Label="Наименование" @bind-Value="@_editor.Model!.Name"/>
        <MudStack Row>
            <MudTextField Class="mb-3" For="@(() => _editor.Model!.User)" Label="Пользователь" @bind-Value="@_editor.Model!.User"/>
            <PasswordInput Class="mb-3" For="@(() => _editor.Model!.Password)" @bind-Value="@_editor.Model!.Password"/>
        </MudStack>
        <MudStack Row StretchItems="StretchItems.All" Breakpoint="Breakpoint.MdAndDown">
            <MudSwitch Class="mb-3" Label="Администратор кластера по умолчанию" 
                       @bind-Value="@_editor.Model!.DefaultForClusters" Color="Color.Primary"/>
            <MudSwitch Class="mb-3"  Label="Администратор инф. баз по умолчанию" 
                       @bind-Value="@_editor.Model!.DefaultV8Admin" Color="Color.Primary"/>
            <MudSwitch Class="mb-3"  Label="Администратор хранилищ по умолчанию" 
                       @bind-Value="@_editor.Model!.DefaultConfigRepositoriesAdmin" Color="Color.Primary"/>
        </MudStack>
        <MudStack Row StretchItems="StretchItems.All" Breakpoint="Breakpoint.SmAndDown">
            <ItemsSelector T="Cluster"
                           @bind-SelectedValues="@_editor.Model!.Clusters"
                           Items="@_editor.Context!.Clusters.ToList()"
                           Title="Кластеры"
                           NameSelector="item => item.Name"/>
            <ItemsSelector T="InfoBase"
                           @bind-SelectedValues="@_editor.Model!.InfoBases"
                           Items="@_editor.Context.InfoBases.ToList()"
                           Title="Информационные базы"
                           NameSelector="@(item => item.Name)"/>
            <ItemsSelector T="ConfigurationRepository"
                           @bind-SelectedValues="@_editor.Model!.ConfigurationRepositories"
                           Items="@_editor.Context.ConfigRepositories.ToList()"
                           Title="Хранилища конфигураций"
                           NameSelector="@(item => item.ToString())"/>
        </MudStack>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<Credentials> _editor = null!;
    
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    
    /// <summary>
    /// Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private static IQueryable<Credentials> ModelSelector(IQueryable<Credentials> arg)
        => arg
            .Include(c => c.InfoBases)
            .Include(c => c.Clusters)
            .Include(c => c.ConfigurationRepositories);
    
    private void OnUpdate(Credentials model)
    {
        ModelHelper.UpdateModelItems(_editor.Model!.InfoBases, model.InfoBases);
        ModelHelper.UpdateModelItems(_editor.Model!.Clusters, model.Clusters);
        ModelHelper.UpdateModelItems(_editor.Model!.ConfigurationRepositories, model.ConfigurationRepositories);
    }
    
    void ShowHidePassword()
    {
        @if (_passwordInput == InputType.Text)
        {
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else {
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    class Validator : ModelValidator<Credentials>
    {
        public Validator()
        {
            RuleFor(c => c.Name)
                .NotEmpty()
                .WithMessage("Не заполнено наименование");
            
            RuleFor(c => c.User)
                .NotEmpty()
                .WithMessage("Не заполнен пользователь");
            
            RuleFor(c => c.Password)
                .NotEmpty()
                .WithMessage("Не заполнен пароль");
        }
    }
}

@page "/credentials"
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models
@rendermode InteractiveServer

@attribute [ExtAuthorize]

<DatabaseObjectsTable TModel="Credentials" TViewModel="Credentials"
                      NameSelector="arg => arg.Name"
                      Route="credentials"
                      Title="Учетные данные">
    <ColumnsContent>
        <MudTh>Имя</MudTh>
        <MudTh>Администратор кластера по умолчанию</MudTh>
        <MudTh>Администратор инф. баз по умолчанию</MudTh>
    </ColumnsContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
        <MudTd DataLabel="Администратор кластера по умолчанию">@context.DefaultForClusters</MudTd>
        <MudTd DataLabel="Администратор инф. баз по умолчанию">@context.DefaultV8Admin</MudTd>
    </RowTemplate>
</DatabaseObjectsTable>
@page "/users/{id:guid}"
@page "/users/create"
@using FluentValidation
@using Microsoft.AspNetCore.Identity
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services

@inject ISnackbar Snackbar
@inject UserManager<ApplicationUser> UserManager
@inject UserGroupsManager GroupsManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IConfiguration Configuration

@attribute [ExtAuthorize]

<EditDatabaseForm @ref="_editor" T="ApplicationUser"
                  Id="Id"
                  Route="settings?tab=users"
                  Title="Новый пользователь"
                  NameSelector="@(c => c.UserName!)"
                  OnInitialize="OnInitialize"
                  BeforeValidation="BeforeValidation"
                  Validation="_validator.ValidateValue"
                  OnSave="OnSave"
                  AfterSave="AfterSave">
    <MudStack>
        <ItemSelector
            @bind-Value="@_editor.Model!.GroupId"
            Items="@_editor.Context!.UsersGroups.ToList()"
            Class="mb-3"
            ItemValueSelector="arg => arg.Id"
            ItemNameSelector="arg => arg.Name"
            Label="Группа пользователей"
            For="@(() => _editor.Model!.GroupId)"/>
        <MudTextField For="@(() => _editor.Model!.DisplayName)" Label="Отображаемое имя"
                      @bind-Value="@_editor.Model!.DisplayName"/>
        <MudStack Row>
            <MudTextField For="@(() => _editor.Model!.UserName)" Label="Логин" @bind-Value="@_editor.Model!.UserName"/>
            <PasswordInput For="@(() => _password)" @bind-Value="_password" @bind-Value:after="OnPasswordChanged"/>
        </MudStack>
        @if (_showExternalName)
        {
            <MudTextField For="@(() => _editor.Model!.ExternalName)" Label="Имя пользователя SSO"
                          @bind-Value="@_editor.Model!.ExternalName"/>
        }
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<ApplicationUser> _editor = null!;
    private string? _password;
    private bool _passwordChanged;
    private bool _showExternalName;

    /// <summary>
    ///     Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private void OnInitialize((ApplicationUser Model, AppDbContext Context) obj)
    {
        var authMode = Configuration.GetValue("Auth:Mode", AuthMode.Internal);
        _showExternalName = authMode != AuthMode.Internal;

        SetEveryOneGroup(obj.Model);
    }

    private void OnPasswordChanged()
    {
        _passwordChanged = true;
    }

    private async Task CheckCanChange(ApplicationUser model)
    {
        var users = await UserManager.GetUsersInRoleAsync(Roles.Administrator);

        var currentUser = users.FirstOrDefault(c => c.Id == model.Id);
        if (currentUser != null)
            users.Remove(currentUser);

        if (users.Count == 0)
            throw new Exception("После изменения не останется пользователя с административными правами, объект не может быть записан");
    }

    private async Task BeforeValidation(ApplicationUser obj)
    {
        SetEveryOneGroup(obj);

        var newUser = Id == Guid.Empty;

        if (!newUser)
            await CheckCanChange(obj);

        if (_passwordChanged)
        {
            var hasher = new PasswordHasher<ApplicationUser>();
            obj.PasswordHash = hasher.HashPassword(obj, _password ?? "");
        }

        obj.SecurityStamp = Guid.NewGuid().ToString();
    }

    private async Task OnSave(ApplicationUser arg)
    {
        var newUser = Id == Guid.Empty;

        if (!newUser)
        {
            var logins = _editor.Context!.UserLogins.Where(c => c.UserId == arg.Id);
            _editor.Context!.UserLogins.RemoveRange(logins);
        }

        if (string.IsNullOrEmpty(arg.ExternalName))
            return;

        var schemes = await SignInManager.GetExternalAuthenticationSchemesAsync();
        var provider = schemes.FirstOrDefault();

        if (provider == null)
            return;

        _editor.Context!.UserLogins.Add(new IdentityUserLogin<Guid>
        {
            UserId = arg.Id,
            LoginProvider = provider.Name,
            ProviderKey = arg.ExternalName,
            ProviderDisplayName = provider.DisplayName
        });
    }

    private async Task AfterSave()
    {
        await GroupsManager.UpdateUsersRoles();
    }

    private static void SetEveryOneGroup(ApplicationUser obj)
    {
        if (obj.GroupId == Guid.Empty)
            obj.GroupId = BuiltInDbData.EveryoneGroup.Id;
    }

    class Validator : ModelValidator<ApplicationUser>
    {
        public Validator()
        {
            RuleFor(c => c.UserName)
                .NotEmpty()
                .WithMessage("Не заполнено имя пользователя");

            RuleFor(c => c.GroupId)
                .NotEqual(Guid.Empty)
                .WithMessage("Не указана группа пользователей");
        }
    }
}

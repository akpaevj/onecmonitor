@page "/users/{id:guid}"
@page "/users/create"
@using System.Security.Claims
@using System.Transactions
@using FluentValidation
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services

@inject ISnackbar Snackbar
@inject UserManager<ApplicationUser> UserManager
@inject UserGroupsManager GroupsManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IConfiguration Configuration

@attribute [ExtAuthorize]

<EditDatabaseForm @ref="_editor" T="ApplicationUser"
                    Id="Id"
                    Route="settings?tab=users"
                    Title="Новый пользователь"
                    NameSelector="@(c => c.UserName!)"
                    OnInitialize="OnInitialize"
                    Validation="_validator.ValidateValue"
                    OnSave="OnSave"
                    AfterSave="AfterSave">
    <MudStack>
        <MudSelect Class="mb-3" Label="Группа пользователей" For="@(() => _editor.Model!.GroupId)" @bind-Value="@_editor.Model!.GroupId">
            @foreach (var item in _editor.Context!.UsersGroups.Where(c => c.Id != Id).ToList())
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField For="@(() => _editor.Model!.DisplayName)" Label="Отображаемое имя" @bind-Value="@_editor.Model!.DisplayName"/>
        <MudStack Row>
            <MudTextField For="@(() => _editor.Model!.UserName)" Label="Логин" @bind-Value="@_editor.Model!.UserName"/>
            <PasswordInput @bind-Value="_password" @bind-Value:after="OnPasswordChanged"/>
        </MudStack>
        @if (_showExternalName)
        {
            <MudTextField For="@(() => _editor.Model!.ExternalName)" Label="Имя пользователя SSO" @bind-Value="@_editor.Model!.ExternalName"/>
        }
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<ApplicationUser> _editor = null!;
    private string? _password;
    private bool _passwordChanged;
    private bool _showExternalName;

    /// <summary>
    /// Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }
    
    /// <summary>
    /// Идентификатор группы элемента
    /// </summary>
    [Parameter]
    public Guid? GroupId { get; set; }
    
    private void OnInitialize((ApplicationUser Model, AppDbContext Context) obj)
    {
        var authMode = Configuration.GetValue("Auth:Mode", AuthMode.Internal);
        _showExternalName = authMode != AuthMode.Internal;
        
        if (obj.Model.GroupId == Guid.Empty)
            obj.Model.GroupId = BuiltInDbData.EveryoneGroup.Id;
        
        if (GroupId != null)
            obj.Model.GroupId = GroupId;
    }
    
    private async Task OnSave((ApplicationUser Model, AppDbContext Context) arg)
    {
        var newUser = Id == Guid.Empty;
        
        var user = newUser switch
        {
            true => arg.Model,
            _ => await UserManager.FindByIdAsync(arg.Model.Id.ToString())
        };
        
        if (!newUser && user!.GroupId != arg.Model.GroupId)
            await CheckCanChange(arg);

        if (!newUser)
        {
            user!.UserName = arg.Model.UserName;
            user.ExternalName = arg.Model.ExternalName;
            user.DisplayName = arg.Model.DisplayName;
            user.GroupId = arg.Model.GroupId;
            
            var ssResult = await UserManager.UpdateSecurityStampAsync(user);

            if (!ssResult.Succeeded)
                throw new Exception(ssResult.Errors.FirstOrDefault()?.Description);
        }
        
        var result = newUser switch
        {
            true => await UserManager.CreateAsync(arg.Model, _password!), 
            _ => await UserManager.UpdateAsync(user!)
        };

        if (result.Succeeded)
        {
            await RemoveExternalLogins(user!);
            await AddExternalLogin(user!);
            
            if (!newUser)
                await SavePassword(user!);
        }
        else
        {
            foreach (var error in result.Errors)
                Snackbar.ShowError(error.Description);
        }
    }

    private async Task RemoveExternalLogins(ApplicationUser user)
    {
        var logins = await UserManager.GetLoginsAsync(user);
        
        foreach (var userLoginInfo in logins)
            await UserManager.RemoveLoginAsync(user!, userLoginInfo.LoginProvider, userLoginInfo.ProviderKey);
    }
    
    private async Task AddExternalLogin(ApplicationUser user)
    {
        if (string.IsNullOrEmpty(user.ExternalName))
            return;
        
        var schemes = await SignInManager.GetExternalAuthenticationSchemesAsync();
        var provider = schemes.FirstOrDefault();
        
        if (provider == null)
            return;
        
        var loginInfo = new UserLoginInfo(provider.Name, user.ExternalName, provider.DisplayName);
        await UserManager.AddLoginAsync(user, loginInfo);
    }
    
    private async Task CheckCanChange((ApplicationUser Model, AppDbContext Context) tuple)
    {
        var users = await UserManager.GetUsersInRoleAsync(BuiltInRoles.Administrator);

        var currentUser = users.FirstOrDefault(c => c.Id == tuple.Model.Id);
        if (currentUser != null) 
            users.Remove(currentUser);

        if (users.Count == 0)
            throw new Exception("После изменения не останется пользователя с административными правами, объект не может быть записан");
    }
    
    private async Task SavePassword(ApplicationUser obj)
    {
        if (_passwordChanged)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(obj);
            await UserManager.ResetPasswordAsync(obj, token, _password ?? "");
        }
    }

    private void OnPasswordChanged()
        => _passwordChanged = true;
    
    private async Task AfterSave()
        => await GroupsManager.UpdateUsersRoles();

    class Validator : ModelValidator<ApplicationUser>
    {
        public Validator()
        {
            RuleFor(c => c.UserName)
                .NotEmpty()
                .WithMessage("Не заполнено имя пользователя");
            
            RuleFor(c => c.GroupId)
                .NotEqual(Guid.Empty)
                .WithMessage("Не указана группа пользователей");
        }
    }
}

@page "/users"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using MudExtensions
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models

@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject IJSRuntime Js
@inject IDialogService DialogService

@attribute [ExtAuthorize]

<PageTitle>Группы и пользователи</PageTitle>

<MudSplitter EnableSlide="true" @bind-Dimension="_dimension" @bind-Dimension:after="AfterDimensionChanged">
    <StartContent>
        <TreeView @bind-SelectedItem="_selectedItem" Class="w-100 pe-2" @bind-Items="_items"
                  ShowAddButton="true" AddButtonCallback="AddButtonCallback"/>
    </StartContent>
    <EndContent>
        @if (_selectedItem is { DynamicComponentType: not null })
        {
            <DynamicComponent
                @key="_selectedItem.Id"
                Type="_selectedItem.DynamicComponentType"
                Parameters="_selectedItem.Parameters"/>
        }
    </EndContent>
</MudSplitter>

@code {
    private double _dimension = 30;
    private IReadOnlyCollection<TreeItem> _items = [];
    private TreeItem? _selectedItem;

    protected override async Task OnInitializedAsync()
    {
        await UpdateItems();
    }

    private Task AddButtonCallback()
    {
        NavManager.NavigateTo("/users/groups/create");
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dimension = await Js.GetLocalStorageItem<string?>("users_panel_dimension");

            if (!string.IsNullOrEmpty(dimension))
            {
                _dimension = double.Parse(dimension, CultureInfo.InvariantCulture);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task UpdateItems()
    {
        _items = await LoadItems();
        _selectedItem = _items.FirstOrDefault();
    }

    private async Task<List<TreeItem>> LoadItems(Guid? parentId = null)
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var items = await context.UsersGroups
            .Include(c => c.Groups)
            .Where(c => c.ParentId == parentId)
            .AsNoTracking()
            .ToListAsync();

        return items.Select(c =>
        {
            return new TreeItem(c.Id.ToString())
            {
                Text = c.Name,
                AdornmentIcon = Icons.Material.Filled.Group,
                Expanded = true,
                AdornmentIconColor = Color.Primary,
                LoadChildrenFunc = c.Groups.Any() ? () => LoadItems(c.Id) : null,
                DynamicComponentType = typeof(GroupUsers),
                Parameters = new Dictionary<string, object> { { "GroupId", c.Id } },
                ShowEditItemIcon = !c.IsBuiltIn,
                EditItemCallBack = OnEditUsersGroup,
                ShowDeleteItemIcon = !c.IsBuiltIn,
                DeleteItemCallBack = OnDeleteUsersGroup
            };
        }).ToList();
    }

    private Task OnEditUsersGroup(TreeItem arg)
    {
        NavManager.NavigateTo($"/users/groups/{arg.Id}");
        return Task.CompletedTask;
    }

    private async Task OnDeleteUsersGroup(TreeItem arg)
    {
        await DeleteItem(arg);
    }

    private async Task DeleteItem(TreeItem item)
    {
        await DialogService.ShowItemDeletingDialog<UsersGroup>(Guid.Parse(item.Id), item.Text);
        await UpdateItems();
    }

    private async Task AfterDimensionChanged()
    {
        await Js.SetLocalStorageItem("users_panel_dimension", _dimension.ToString(CultureInfo.InvariantCulture));
    }

}
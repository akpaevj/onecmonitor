@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Extensions
@using OneSwiss.Server.Models
@using OneSwiss.Server.Components
@using OneSwiss.Server.Components.Shared
@inject ISnackbar Snackbar
@inject UserManager<ApplicationUser> UserManager

@attribute [ExtAuthorize]

<DatabaseObjectsTable TModel="ApplicationUser" TViewModel="ApplicationUser"
                      NameSelector="arg => arg.UserName!"
                      Route="users"
                      Title="Пользователи"
                      LoadItemsFunc="LoadItems"
                      Class="ps-2 w-100"
                      ShowTitle="false"
                      BeforeDelete="BeforeDelete">
    <ColumnsContent>
        <MudTh>Имя</MudTh>
    </ColumnsContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.UserName</MudTd>
    </RowTemplate>
</DatabaseObjectsTable>

@code {

    [Parameter] public Guid GroupId { get; set; }

    private async Task<List<ApplicationUser>> LoadItems(AppDbContext arg)
    {
        var result = new List<ApplicationUser>();

        result.AddRange(await arg.Users.Where(c => c.GroupId == GroupId).ToListAsync());
        result.AddRange(await LoadChildrenGroupsUsers(GroupId, arg));

        return result;
    }

    private static async Task<List<ApplicationUser>> LoadChildrenGroupsUsers(Guid groupId, AppDbContext context)
    {
        var result = new List<ApplicationUser>();

        var items = await context.UsersGroups
            .AsNoTracking()
            .Include(c => c.Users)
            .Where(c => c.ParentId == groupId)
            .ToListAsync();

        result.AddRange(items.SelectMany(c => c.Users));

        foreach (var group in items)
            result.AddRange(await LoadChildrenGroupsUsers(group.Id, context));

        return result;
    }

    private async Task<bool> BeforeDelete((ApplicationUser Model, AppDbContext Context) tuple)
    {
        var users = await UserManager.GetUsersInRoleAsync(Roles.Administrator);

        var currentUser = users.FirstOrDefault(c => c.Id == tuple.Model.Id);
        if (currentUser != null)
            users.Remove(currentUser);

        if (users.Count == 0)
            Snackbar.ShowError("После удаления не останется пользователя с административными правами, удаление запрещено");

        return users.Count > 0;
    }

}
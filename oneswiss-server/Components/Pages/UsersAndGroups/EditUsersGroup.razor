@page "/users/groups/{id:guid}"
@page "/users/groups/create"
@using FluentValidation
@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Attributes
@using OneSwiss.Server.Components.Shared
@using OneSwiss.Server.Helpers
@using OneSwiss.Server.Models
@using OneSwiss.Server.Services

@inject UserGroupsManager GroupsManager

@attribute [ExtAuthorize]

<EditDatabaseForm @ref="_editor" T="UsersGroup"
                    Id="Id"
                    Route="settings?tab=users"
                    Title="Новая группа пользователей"
                    NameSelector="@(c => c.Name)"
                    ModelSelector="ModelSelector"
                    OnUpdate="OnUpdate"
                    Validation="_validator.ValidateValue"
                    AfterSave="AfterSave">
    <MudStack>
        <MudSelect Class="mb-3" Label="Группа пользователей" For="@(() => _editor.Model!.ParentId)" @bind-Value="@_editor.Model!.ParentId" Clearable="true">
            @foreach (var item in _editor.Context!.UsersGroups.Where(c => c.Id != Id).ToList())
            {
                <MudSelectItem Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Class="mb-3" For="@(() => _editor.Model!.Name)" Label="Наименование" @bind-Value="@_editor.Model!.Name"/>
        <MudStack Row StretchItems="StretchItems.All" Breakpoint="Breakpoint.SmAndDown">
            <ItemsSelector T="ApplicationUser"
                           @bind-SelectedValues="@_editor.Model!.Users"
                           Items="@_editor.Context!.Users.ToList()"
                           Title="Пользователи"
                           NameSelector="@(item => item.UserName!)"/>
            <ItemsSelector T="AccessGroup"
                           @bind-SelectedValues="@_editor.Model!.AccessGroups"
                           Items="@_editor.Context!.AccessGroups.ToList()"
                           Title="Группы доступа"
                           NameSelector="@(item => item.Name)"/>
        </MudStack>
    </MudStack>
</EditDatabaseForm>

@code
{
    private readonly Validator _validator = new();
    private EditDatabaseForm<UsersGroup> _editor = null!;

    /// <summary>
    /// Идентификатор элемента
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private static IQueryable<UsersGroup> ModelSelector(IQueryable<UsersGroup> arg)
        => arg
            .Include(c => c.Users)
            .Include(c => c.AccessGroups);
    
    private void OnUpdate(UsersGroup model)
    {
        ModelHelper.UpdateModelItems(_editor.Model!.AccessGroups, model.AccessGroups);
        ModelHelper.UpdateModelItems(_editor.Model.Users, model.Users);
    }
    
    private async Task AfterSave()
    {
        await GroupsManager.UpdateUsersRoles();
    }

    class Validator : ModelValidator<UsersGroup>
    {
        public Validator()
        {
            RuleFor(c => c.Name)
                .NotEmpty()
                .WithMessage("Не заполнено наименование");
        }
    }
}

@inject IDbContextFactory<AppDbContext> ContextFactory
@using Microsoft.Data.SqlClient
@using Microsoft.Data.Sqlite
@using Microsoft.EntityFrameworkCore
@using Npgsql
@using OneSwiss.Server.Extensions
@inject ISnackbar SnackBar
@inject ILogger<ItemDeletingDialog<T>> Logger
@typeparam T where T : class, OneSwiss.Server.Models.IHasId

<MudDialog>
    <TitleContent>
        Удаление
    </TitleContent>
    <DialogContent>
        Вы действительно хотите удалить "@ItemName"?
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отменить</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Удалить</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [Parameter] 
    public Guid Id { get; set; }

    [Parameter] 
    public string ItemName { get; set; } = string.Empty;
    
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private async Task Submit()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        var item = await context.Set<T>().FindAsync(Id);
        
        try
        {
            context.Entry(item!).State = EntityState.Deleted;
            
            await context.SaveChangesAsync();
            
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception e)
        {
            ShowErrorAndCancel(e);
        }
    }

    private void ShowErrorAndCancel(Exception ex)
    {
        Logger.LogError(ex, "Ошибка при удалении элемента");
        SnackBar.ShowError(ex);
        Cancel();
    }
    
    private static List<string> GetBlockingReferences(DbContext dbContext, object entity)
    {
        var entityType = dbContext.Model.FindEntityType(entity.GetType());

        return (from foreignKey in dbContext.Model.GetEntityTypes()
                .SelectMany(e => e.GetForeignKeys())
            where foreignKey.PrincipalEntityType == entityType
            let dependentType = foreignKey.DeclaringEntityType
            let navName = foreignKey.PrincipalToDependent?.Name ?? foreignKey.DependentToPrincipal?.Name
            let count = (int)dbContext.GetType()
                .GetMethod("Set")
                .MakeGenericMethod(dependentType.ClrType)
                .Invoke(dbContext, null)
                .GetType()
                .GetMethod("Count")
                .Invoke(null, [])
            where count > 0
            select $"{navName} ({count} шт.)").ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
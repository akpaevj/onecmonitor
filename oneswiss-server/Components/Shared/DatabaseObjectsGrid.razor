@using Microsoft.EntityFrameworkCore
@using OneSwiss.Server.Extensions
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject IDbContextFactory<AppDbContext> ContextFactory
@inject ISnackbar SnackBar
@attribute [CascadingTypeParameter(nameof(T))]
@typeparam T where T : OneSwiss.Server.Models.DatabaseObject

<PageTitle>@Title</PageTitle>

<h1 Class="mb-3">@Title</h1>

<MudStack Row AlignItems="AlignItems.Start">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="@(() => NavManager.NavigateTo($"{Route}/create"))" Class="mb-3">Добавить</MudButton>
    @if (TableActionsContent != null)
    {
        @TableActionsContent
    }
</MudStack>

<MudDataGrid T="T" Items="_items">
    <Columns>
        @if (ColumnsContent == null)
        {
            <PropertyColumn Property="@(arg => NameSelector(arg))"/>
        }
        else
        {
            @ColumnsContent
        }
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row>
                    @if (RowActionsContent == null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => NavManager.NavigateTo($"{Route}/{context.Item!.Id}"))" Color="Color.Info"/>
                        @if (ShowDeleteButton)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteItem(context.Item!))" Color="Color.Error"/>
                        }
                    }
                    else
                    {
                        @RowActionsContent.Invoke(context.Item!)
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code
{
    private bool _isLoading;
    private List<T> _items = [];

    [Parameter]
    public string Title { get; set; } = string.Empty;
    
    [Parameter] 
    public RenderFragment? TableActionsContent { get; set; }

    [Parameter] 
    public RenderFragment? ColumnsContent { get; set; }
    
    [Parameter] 
    public RenderFragment<T>? RowActionsContent { get; set; }

    /// <summary>
    /// Используется при получении сложных моделей со связями
    /// </summary>
    [Parameter]
    public Func<IQueryable<T>, IQueryable<T>>? ItemsSelector { get; set; }
    
    [Parameter] 
    public Func<T, string> NameSelector { get; set; } = null!;

    [Parameter] 
    public string Route { get; set; } = string.Empty;

    [Parameter] 
    public bool ShowDeleteButton { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await UpdateItems();
    }

    public async Task DeleteItem(T item)
    {
        await DialogService.ShowItemDeletingDialog(item, NameSelector(item));
        await UpdateItems();
    }
    
    public async Task<AppDbContext> GetContext()
        => await ContextFactory.CreateDbContextAsync();

    private async Task UpdateItems()
    {
        if (_isLoading)
            return;

        try
        {
            _isLoading = true;
            
            _items = await GetItems();
        }
        catch (Exception e)
        {
            SnackBar.ShowError(e);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<List<T>> GetItems()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        return await (ItemsSelector == null ? context.Set<T>() : ItemsSelector.Invoke(context.Set<T>())).ToListAsync();
    }
}
@inject ISnackbar Snackbar
@using OneSwiss.Server.Components.Pages.ServersAdministration
@using OneSwiss.Server.Extensions
@implements IDisposable

@if (Item.Visible)
{
    <MudButton FullWidth="true" Class="align-stretch justify-start d-inline" Color="@_color" OnClick="SelectItem">
        <MudStack Row Spacing="0" Class="align-stretch" AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
            <MudElement Style="@_paddingStyle" HtmlTag="div"/>
            @if (_isLoading)
            {
                <MudProgressCircular Class="mr-3" Size="Size.Small" Color="Color.Info" Indeterminate="true"/>
            }
            else
            {
                <MudIconButton Class="mr-3" Icon="@_icon" Size="Size.Small" OnClick="@(() => SetItemExpanded(!Item.Expanded))"/>
            }
            @if (!string.IsNullOrEmpty(Item.AdornmentIcon))
            {
                <MudIcon Class="mr-3" Icon="@Item.AdornmentIcon" Color="@Item.AdornmentIconColor"/>
            }
            <MudText Class="w-100" Align="Align.Start" Style="overflow-wrap: anywhere">
                @Item.Text
            </MudText>
            <MudSpacer/>
            @if (Item.ShowEditItemIcon)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OnClickEditItem(Item))" Color="Color.Info"/>
            }
            @if (Item.ShowDeleteItemIcon)
            {
                <MudIconButton Class="ms-3" Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => OnClickDeleteItem(Item))" Color="Color.Error"/>
            }
        </MudStack>
    </MudButton>
    <MudCollapse @bind-Expanded="@Item.Expanded" Class="w-100">
        <MudStack Spacing="0" AlignItems="AlignItems.Start" StretchItems="StretchItems.All">
            @foreach (var item in Item.Children)
            {
                <TreeViewItem Item="item"/>
            }
        </MudStack>
    </MudCollapse>
}

@code
{
    private bool _isLoading;
    private string? _icon;
    private string _paddingStyle = "padding-left: 0px";
    private Color _color = Color.Default;

    [CascadingParameter] 
    protected TreeView? Tree { get; set; }
    
    [Parameter] 
    public TreeItem Item { get; set; } = null!;
    
    [Parameter] 
    public bool IsSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Item.IsSelected = IsSelected;
        
        Tree?.RegisterItem(this);
        await UpdateFullState();
    }

    public async Task UpdateFullState()
    {
        await UpdateVisualState();
        
        if (Item.Expanded)
            await LoadChildrenItems();
    }
    
    public async Task UpdateVisualState()
    {
        _color = Item.IsSelected ? Color.Primary : Color.Default;
        _paddingStyle = $"padding-left: {Item.Level * 20}px;";
        
        if (Item.LoadChildrenFunc == null)
            _icon = null;
        else
            _icon = Item.Expanded ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadChildrenItems()
    {
        if (Item is { LoadChildrenFunc: not null } and { Expanded: true })
        {
            _isLoading = true;
            await UpdateVisualState();

            try
            {
                var children = await Item.LoadChildrenFunc.Invoke();
            
                foreach (var treeItem in children)
                    treeItem.Parent = Item;

                Item.Children = children;
            }
            catch (Exception e)
            {
                Snackbar.ShowError(e);
                Item.Expanded = false;
            }
                
            _isLoading = false;
            await UpdateVisualState();
        }
    }

    public void SelectItem()
    {
        if (Item.IsSelectable)
            Tree?.SelectItem(Item);
    }

    private async Task SetItemExpanded(bool value)
    {
        if (Item is { LoadChildrenFunc: not null })
        {
            Item.Expanded = value;
            await UpdateFullState();
        }
    }
    
    public void Dispose()
    {
        Tree?.UnregisterItem(this);
    }

    private async Task OnClickEditItem(TreeItem item)
    {
        if (Item.EditItemCallBack != null)
            await Item.EditItemCallBack.Invoke(item);
    }
    
    private async Task OnClickDeleteItem(TreeItem item)
    {
        if (Item.DeleteItemCallBack != null)
            await Item.DeleteItemCallBack.Invoke(item);
    }
}

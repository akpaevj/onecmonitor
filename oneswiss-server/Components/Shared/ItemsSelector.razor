
@typeparam T where T : OneSwiss.Server.Models.DatabaseObject

<MudCard>
    <MudCardHeader Class="mud-theme-info">
        <CardHeaderContent>@Title</CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (Items.Count == 0)
        {
            <MudText Class="" Align="Align.Center">Нет данных для выбора</MudText>
        }
        else
        {
            <MudList T="T"
                     SelectedValues="_selectedValues"
                     SelectedValuesChanged="SelectedValuesChangedInternal"
                     SelectionMode="SelectionMode.MultiSelection"
                     Color="Color.Primary">
                @foreach (var item in Items)
                {
                    <MudListItem Text="@NameSelector(item)" Value="@item"></MudListItem>
                }
            </MudList>
        }
    </MudCardContent>
</MudCard>

@code {

    private IReadOnlyCollection<T> _selectedValues = [];
    
    [Parameter] 
    public string Title { get; set; } = string.Empty;
    
    [Parameter] 
    public List<T> Items { get; set; } = [];

    [Parameter] 
    public Func<T, string> NameSelector { get; set; } = null!;

    [Parameter] 
    public List<T> SelectedValues { get; set; } = [];
    
    [Parameter]
    public EventCallback<List<T>> SelectedValuesChanged { get; set; }

    protected override void OnInitialized()
    {
        _selectedValues = SelectedValues;
    }

    private async Task SelectedValuesChangedInternal(IReadOnlyCollection<T>? arg)
    {
        SelectedValues = arg?.ToList() ?? [];
        await SelectedValuesChanged.InvokeAsync(SelectedValues);
    }
}
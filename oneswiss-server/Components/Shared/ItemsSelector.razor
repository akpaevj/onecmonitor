@using System.Linq.Expressions
@using MudExtensions
@typeparam T

<style>
    .mud-select-extended:has(> .mud-input-control.w-100) {
        width: 100%;
        flex-basis: auto;
    }
</style>

<MudSelectExtended
    T="T"
    Label="@_label"
    MultiSelection="true"
    SelectedValues="SelectedValues"
    SelectedValuesChanged="SelectedValuesChangedInternal"
    Variant="Variant.Outlined"
    ToStringFunc="@(arg => arg is null ? string.Empty : NameSelector(arg))"
    Disabled="@Disabled"
    FullWidth="@FullWidth"
    AnchorOrigin="Origin.BottomCenter"
    Class="@Class"
    SelectAll="true"
    SelectAllText="Выделить все"
    SearchBox="true"
    NoWrap="@NoWrap"
    SearchBoxAutoFocus="true"
    ItemCollection="Items"
    Margin="@Margin"
    For="For">
</MudSelectExtended>

@code {
    private string? _label;

    [Parameter] public string Class { get; set; } = string.Empty;

    [Parameter] public string? Title { get; set; } = string.Empty;
    
    [Parameter] public bool Disabled { get; set; }
    
    [Parameter] public bool FullWidth { get; set; }
    
    [Parameter] public bool NoWrap { get; set; }

    [Parameter] public Margin Margin { get; set; } = Margin.Normal;

    [Parameter] public List<T> Items { get; set; } = [];

    [Parameter] public Func<T, string> NameSelector { get; set; } = null!;

    [Parameter] public List<T>? SelectedValues { get; set; } = [];

    [Parameter] public EventCallback<List<T>> SelectedValuesChanged { get; set; }

    [Parameter] public Expression<Func<T>>? For { get; set; }

    protected override void OnInitialized()
    {
        UpdateLabel();
    }

    private async Task SelectedValuesChangedInternal(IEnumerable<T?>? arg)
    {
        SelectedValues = arg?.ToList() ?? [];
        await SelectedValuesChanged.InvokeAsync(SelectedValues);
        UpdateLabel();
    }

    private void UpdateLabel()
    {
        _label = string.IsNullOrEmpty(Title) ? $"Выбрано: {SelectedValues?.Count ?? 0}" : $"{Title} ({SelectedValues?.Count ?? 0})";
    }

}
{
  "compilerOptions": {
    "alwaysStrict": false,
    "noImplicitAny": false,
    "module": "esnext",
    "target": "ES2017",
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "sourceRoot": "Scripts",
    "mapRoot": "wwwroot",
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "exclude": [
    "node_modules",
    "wwwroot"
  ]
}
